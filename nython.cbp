        <Unit filename="include/builtins/audio.hpp" />
        <Unit filename="include/builtins/string.hpp" />
        <Unit filename="include/builtins/io.hpp" />
        <Unit filename="include/builtins/lang.hpp" />
        <Unit filename="include/builtins/network.hpp" />
        <Unit filename="include/builtins/math.hpp" />
        <Unit filename="include/builtins/os.hpp" />
        <Unit filename="include/builtins/data.hpp" />
        <Unit filename="include/builtins/threading.hpp" />
        <Unit filename="include/builtins/gui.hpp" />
    </Project>
</CodeBlocks_project_file>
