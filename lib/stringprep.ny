# nython: module    (import it by name: it runs in a module scope of its own)
# nython: python    (Python's binding rule: a name a function binds is its local - round 85)
# lib/stringprep.ny - Python's stringprep module (round 83): the tables of
# RFC 3454, "Preparation of Internationalized Strings".
#
#     import stringprep
#     stringprep.in_table_c11(" ")     # True: ASCII space
#     stringprep.map_table_b2("\u00df")  # 'ss' (case folding for NFKC)
#     stringprep.in_table_d1("\u05d0")   # True: right-to-left
#
# in_table_a1 (unassigned in Unicode 3.2), in_table_b1, map_table_b2,
# map_table_b3, in_table_c11, in_table_c12, in_table_c11_c12, in_table_c21,
# in_table_c22, in_table_c21_c22, in_table_c3 ... in_table_c9, in_table_d1,
# in_table_d2 - CPython's stringprep.py. CPython answers some of them from
# unicodedata.ucd_3_2_0 (the Unicode 3.2 database: categories,
# bidirectional classes, NFKC); here those facts are tables generated from
# that database (by asking CPython 3.11, tools: the round-83 notes), so every
# answer is CPython's: the 3.2 categories Cn/Zs/Cc/Co/Cs and the bidi
# classes R/AL and L as code point ranges, table B.2 (map_table_b2's
# results that differ from map_table_b3's) as a mapping, and the lowercase
# mapping map_table_b3 applies (CPython's str.lower).
#
# Not here: nothing of CPython's module.
from bisect import bisect_right as _bisect_right


def _in(name, code):
    var t = _TABLES[name]
    var c = ord(code)
    var i = _bisect_right(t[0], c) - 1
    return i >= 0 and t[1][i][0] <= c <= t[1][i][1]


def _category(code):
    if _in("_CN", code):
        return "Cn"
    if _in("_ZS", code):
        return "Zs"
    if _in("_CC", code):
        return "Cc"
    if _in("_CO", code):
        return "Co"
    if _in("_CS", code):
        return "Cs"
    return "?"


def _bidi(code):
    if _in("_D1", code):
        return "R"
    if _in("_D2", code):
        return "L"
    return "?"


