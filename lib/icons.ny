# ─── Codicons ────────────────────────────────────────────────────────────────
# VS Code's own icon set, rendered as a font exactly the way VS Code renders it.
# The IDE previously used emoji glyphs, whose shape and colour are decided by
# whatever emoji font the OS happens to ship — so the toolbar looked different
# on every machine and could not be themed. Codicons are monochrome glyphs that
# take the current text colour, which is what makes them themeable.
#
# Font:  assets/fonts/codicon.ttf
# Icons: Creative Commons Attribution 4.0 International (see codicon-LICENSE.txt)
# Code:  MIT, Copyright (c) Microsoft Corporation
#
#   var ic = Icons_Codicon()
#   renderer.draw_text(ic.get("folder"), x, y, icon_font, theme.text)

class Icons_Codicon:
    def __init__(self):
        self.font_path = "assets/fonts/codicon.ttf"
        self.map = {}
        self._register()

    def get(self, name):
        var v = self.map[name]
        if v == none:
            return "?"
        return v

    def has(self, name):
        return self.map[name] != none

    def count(self):
        return self.map.size()

