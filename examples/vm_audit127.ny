       [79, ['assert', 'assignment', 'async', 'atom-identifiers', 'atom-literals', 'attribute-access', 'attribute-references', 'augassign', 'await', 'binary', 'bitwise', 'bltin-code-objects'], '4e9692bea54dd28454cb2ac20da92eda'])
