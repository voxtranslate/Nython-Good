def debug_runner(text):
    r = doctest.DebugRunner(verbose=False)
    try:
        r.run(dt(text), out=lambda s: None)
    except doctest.DocTestFailure as f:
        return ["DocTestFailure", f.example.source, f.example.want, f.got, str(f).split(" from ")[0]]
    except doctest.UnexpectedException as u:
        return ["UnexpectedException", u.example.source, u.exc_info[0].__name__, str(u.exc_info[1])]
    return "passed"
if have('doctest'):
    ck('DebugRunner: a failure', lambda: debug_runner('>>> 1 + 1\n3\n'),
       ['DocTestFailure', '1 + 1\n', '3\n', '2\n', '<DocTest t'])
if have('doctest'):
    ck('DebugRunner: an unexpected exception', lambda: debug_runner('>>> 1 / 0\n'),
       ['UnexpectedException', '1 / 0\n', 'ZeroDivisionError', 'division by zero'])
if have('doctest'):
    ck('DebugRunner: passing', lambda: debug_runner('>>> 2\n2\n'),
       'passed')

import unittest

def suite_result(suite):
    res = unittest.TestResult()
    suite.run(res)
    return [res.testsRun, len(res.failures), len(res.errors),
            sorted(t.id() for t, _ in res.failures)]
if have('doctest'):
    ck('DocTestSuite over the module', lambda: suite_result(doctest.DocTestSuite(dtsample)),
       [12, 5, 0, ['dtsample.__test__.extra', 'dtsample.add', 'dtsample.boom', 'dtsample.diffs', 'dtsample.flags']])
