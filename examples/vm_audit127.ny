# the usual way: a program that tests itself with doctest.testmod()
DTMAIN = """\
\"\"\"A program testing itself.

>>> square(4)
16
>>> square(-2)
5
\"\"\"


def square(x):
    \"\"\"
    >>> [square(n) for n in range(4)]
    [0, 1, 4, 9]
    \"\"\"
    return x * x


class Box:
    \"\"\"
    >>> Box(3).size
    3
    \"\"\"
    def __init__(self, size):
        self.size = size


if __name__ == "__main__":
    import doctest
    print(doctest.testmod())
"""
write("dtmain127.py", DTMAIN)
if have('doctest'):
    ck("a program's own doctest.testmod()", lambda: child(['dtmain127.py']),
       [0, '**********************************************************************\nFile "dtmain127.py", line 5, in __main__\nFailed example:\n    square(-2)\nExpected:\n    5\nGot:\n    4\n**********************************************************************\n1 items had failures:\n   1 of   2 in __main__\n***Test Failed*** 1 failures.\nTestResults(failed=1, attempted=4)\n'])
if have('doctest'):
    ck("a program's own doctest.testmod() -v", lambda: child(['dtmain127.py', '-v']),
       [0, 'Trying:\n    square(4)\nExpecting:\n    16\nok\nTrying:\n    square(-2)\nExpecting:\n    5\n**********************************************************************\nFile "dtmain127.py", line 5, in __main__\nFailed example:\n    square(-2)\nExpected:\n    5\nGot:\n    4\nTrying:\n    Box(3).size\nExpecting:\n    3\nok\nTrying:\n    [square(n) for n in range(4)]\nExpecting:\n    [0, 1, 4, 9]\nok\n1 items had no tests:\n    __main__.Box.__init__\n2 items passed all tests:\n   1 tests in __main__.Box\n   1 tests in __main__.square\n**********************************************************************\n1 items had failures:\n   1 of   2 in __main__\n4 tests in 4 items.\n3 passed and 1 failed.\n***Test Failed*** 1 failures.\nTestResults(failed=1, attempted=4)\n'])

dtsample = fresh("dtsample")
dtpass = fresh("dtpass")
_finder = doctest.DocTestFinder()
DT_TESTS = _finder.find(dtsample)
if have('doctest'):
    ck('DocTestFinder: names, line numbers, example counts', lambda: [(t.name, t.lineno, len(t.examples), os.path.basename(t.filename or '')) for t in DT_TESTS],
       [('dtsample', 0, 4, 'dtsample.py'), ('dtsample.Klass', 101, 1, 'dtsample.py'), ('dtsample.Klass.Inner', 142, 1, 'dtsample.py'), ('dtsample.Klass.cm', 127, 1, 'dtsample.py'), ('dtsample.Klass.double', 111, 1, 'dtsample.py'), ('dtsample.Klass.prop', 135, 1, 'dtsample.py'), ('dtsample.Klass.stat', 119, 1, 'dtsample.py'), ('dtsample.__test__.extra', None, 3, 'dtsample.py'), ('dtsample.add', 13, 4, 'dtsample.py'), ('dtsample.boom', 28, 4, 'dtsample.py'), ('dtsample.diffs', 84, 3, 'dtsample.py'), ('dtsample.flags', 47, 13, 'dtsample.py'), ('dtsample.no_examples', 149, 0, 'dtsample.py')])
