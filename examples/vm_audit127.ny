HYP_SAMPLE = '"""Property checks.\n\n>>> xs = [3, 1, 2]\n>>> sorted(xs)                 # doctest: +HYPOTHESIS\n... # invariant: len(_) == len(xs)\n... # invariant: all(a <= b for a, b in zip(_, _[1:]))\n[1, 2, 3]\n\n>>> def mean(xs): return sum(xs) / len(xs)\n>>> mean(xs)   # doctest: +HYPOTHESIS\n2.0\n\n>>> def bad_max(xs):\n...     m = 0\n...     for x in xs:\n...         if x > m:\n...             m = x\n...     return m\n>>> bad_max(xs)   # doctest: +HYPOTHESIS\n... # assume: xs\n... # invariant: _ == max(xs)\n3\n\n>>> s = "hello"\n>>> s.upper().lower() == s.lower()   # doctest: +HYPOTHESIS\nTrue\n\n>>> n = 5\n>>> abs(n) >= 0   # doctest: +HYPOTHESIS\nTrue\n\n>>> def clamp(v): return min(max(v, 0), 100)\n>>> clamp(n) == n   # doctest: +HYPOTHESIS\n... # given: n=integers(0, 200)\nTrue\n\n>>> d = {"a": 1}\n>>> len(d) == len(set(d))   # doctest: +HYPOTHESIS\nTrue\n\n>>> def first_word(t): return t.split()[0]\n>>> first_word(s)   # doctest: +HYPOTHESIS\n\'hello\'\n\n>>> pair = (1, 2.5)\n>>> int(pair[0] * pair[1]) == pair[0] * pair[1]   # doctest: +HYPOTHESIS\nFalse\n"""\n'
