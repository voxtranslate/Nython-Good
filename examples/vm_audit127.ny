    ck('DocTestFinder(exclude_empty=False)', lambda: [t.name for t in doctest.DocTestFinder(exclude_empty=False).find(dtsample)],
       ['dtsample', 'dtsample.Klass', 'dtsample.Klass.Inner', 'dtsample.Klass.__init__', 'dtsample.Klass.cm', 'dtsample.Klass.double', 'dtsample.Klass.prop', 'dtsample.Klass.stat', 'dtsample.__test__.extra', 'dtsample.add', 'dtsample.boom', 'dtsample.diffs', 'dtsample.flags', 'dtsample.no_examples'])
