    ck('DocTestSuite with optionflags', lambda: suite_result(doctest.DocTestSuite(dtsample, optionflags=doctest.ELLIPSIS)),
       [12, 5, 0, ['dtsample.__test__.extra', 'dtsample.add', 'dtsample.boom', 'dtsample.diffs', 'dtsample.flags']])
if have('doctest'):
    ck('DocFileSuite', lambda: suite_result(doctest.DocFileSuite(os.path.join(T, 'dtsample.txt'), module_relative=False)),
       [1, 1, 0, ['dtsample_txt']])
