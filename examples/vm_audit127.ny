       ['ff', '-f', 'f-', '--', '.-', '-.', ['ff', '-f', 'f-', '--', '.-', '-.']])

# ── imp ──────────────────────────────────────────────────────────────────────
write("impmod127.py", "VALUE = 41\ndef f():\n    return VALUE + 1\n")
write("imppkg127/__init__.py", "NAME = 'pkg'\n")
def imp_demo():
    import imp
    f, path, desc = imp.find_module("impmod127", [T])
    m = imp.load_module("impmod127", f, path, desc)
    f.close()
    r = [os.path.basename(path), desc, m.VALUE, m.f(), m.__name__, "impmod127" in sys.modules]
    write("impmod127.py", "VALUE = 999\ndef f():\n    return VALUE + 1\n")   # (another size: CPython's .pyc check)
    m2 = imp.reload(m)
    r += [m2 is m, m.f()]
    pf, ppath, pdesc = imp.find_module("imppkg127", [T])
    p = imp.load_module("imppkg127", pf, ppath, pdesc)
    r += [pf, os.path.basename(ppath), pdesc, p.NAME]
    s = imp.load_source("impsrc127", os.path.join(T, "impmod127.py"))
    r += [s.VALUE, s.__name__]
    nm = imp.new_module("fresh127")
    r += [type(nm).__name__, nm.__name__, "fresh127" in sys.modules]
    return r
if have('imp'):
    ck('imp: find_module, load_module, reload, packages, load_source, new_module', lambda: imp_demo(),
       ['impmod127.py', ('.py', 'r', 1), 41, 42, 'impmod127', True, True, 1000, None, 'imppkg127', ('', '', 5), 'pkg', 999, 'impsrc127', 'module', 'fresh127', False])
