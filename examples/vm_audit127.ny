# ── pipes ────────────────────────────────────────────────────────────────────
def pipe_demo():
    import pipes
    t = pipes.Template()
    t.append('tr a-z A-Z', '--')
    t.append('sed s/X/y/', '--')
    src = write("pipes_in.txt", "hello\nXmas box\n")
    dst = os.path.join(T, "pipes_out.txt")
    t.copy(src, dst)
    with open(dst) as f:
        copied = f.read()
    with t.open(os.path.join(T, "pipes_w.txt"), "w") as f:
        f.write("written through\n")
    with open(os.path.join(T, "pipes_w.txt")) as f:
        written = f.read()
    with t.open(src, "r") as f:
        read = f.read()
    t2 = t.clone()
    t2.prepend('cat', '--')
    t3 = pipes.Template()
    t3.append('sort $IN', 'f-')
    t3.append('uniq > $OUT', '-f')
    return [copied, written, read, repr(t).split(" at ")[0], t.steps, t2.steps,
            t.makepipeline("in", "out"), t3.makepipeline("in", "out"), re.sub(re.escape(tempfile.gettempdir()) + r"/\w+", "TMP", t3.makepipeline("", ""))]
if have('pipes') and os.name != 'nt':   # /bin/sh pipelines: CPython's test_pipes is POSIX-only
    ck('pipes.Template: copy, open for writing and reading, makepipeline', lambda: pipe_demo(),
       ['HELLO\nyMAS BOX\n', 'WRITTEN THROUGH\n', 'HELLO\nyMAS BOX\n', "<Template instance, steps=[('tr a-z A-Z', '--'), ('sed s/X/y/', '--')]>", [('tr a-z A-Z', '--'), ('sed s/X/y/', '--')], [('cat', '--'), ('tr a-z A-Z', '--'), ('sed s/X/y/', '--')], 'tr a-z A-Z <in |\nsed s/X/y/ >out', 'IN=in; sort $IN |\n{ OUT=out; uniq > $OUT; }', "trap 'rm -f TMP TMP; exit' 1 2 3 13 14 15\ncat >TMP\nIN=TMP; sort $IN |\n{ OUT=TMP; uniq > $OUT; }\ncat <TMP\nrm -f TMP TMP"])
if have('pipes'):
    ck('pipes.quote', lambda: [__import__('pipes').quote(s) for s in ['', 'abc', 'a b', "it's", '$HOME', 'a"b']],
       ["''", 'abc', "'a b'", '\'it\'"\'"\'s\'', "'$HOME'", '\'a"b\''])
if have('pipes'):
    ck('pipes errors', lambda: (lambda pipes: [err(lambda: pipes.Template().append('x', 'zz')), err(lambda: pipes.Template().open('f', 'x')), err(lambda: (lambda t: (t.append('cat', '.-'), t.append('cat', '--')))(pipes.Template())), err(lambda: pipes.Template().append(1, '--')), err(lambda: pipes.Template().append('cat $IN', 'f-'))])(__import__('pipes')),
       ["ValueError: Template.append: bad kind 'zz'", "ValueError: Template.open: rw must be 'r' or 'w', not 'x'", 'ValueError: Template.append: SOURCE can only be prepended', 'TypeError: Template.append: cmd must be a string', 'no error'])
