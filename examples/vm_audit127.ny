       [('Klass.Inner.__name__\n', "'Inner'\n", None, 1, 8, [])])

_parser = doctest.DocTestParser()
PARSE_SRC = """Some text.
    >>> a = 1  # doctest: +ELLIPSIS, -NORMALIZE_WHITESPACE
    >>> a
    1
      >>> print('indented')
      indented
    >>> raise KeyError('k')
    Traceback (most recent call last):
    KeyError: 'k'
    Trailing text.
"""
if have('doctest'):
    ck('DocTestParser.parse: text and examples', lambda: [x if isinstance(x, str) else (x.source, x.want, x.exc_msg, x.lineno, x.indent, sorted(x.options.items())) for x in _parser.parse(PARSE_SRC)],
       ['Some text.\n', ('a = 1  # doctest: +ELLIPSIS, -NORMALIZE_WHITESPACE\n', '', None, 1, 4, [(4, False), (8, True)]), '', ('a\n', '1\n', None, 2, 4, []), '', ("print('indented')\n", 'indented\n', None, 4, 6, []), '', ("raise KeyError('k')\n", "Traceback (most recent call last):\nKeyError: 'k'\nTrailing text.\n", "KeyError: 'k'\nTrailing text.\n", 6, 4, []), ''])
if have('doctest'):
    ck('DocTestParser.get_examples', lambda: [(e.source, e.want) for e in _parser.get_examples(PARSE_SRC)],
       [('a = 1  # doctest: +ELLIPSIS, -NORMALIZE_WHITESPACE\n', ''), ('a\n', '1\n'), ("print('indented')\n", 'indented\n'), ("raise KeyError('k')\n", "Traceback (most recent call last):\nKeyError: 'k'\nTrailing text.\n")])
if have('doctest'):
    ck('DocTestParser: an invalid option', lambda: err(lambda: _parser.parse('>>> 1  # doctest: +NOSUCH\n1\n')),
       "ValueError: line 1 of the doctest for <string> has an invalid option: '+NOSUCH'")
if have('doctest'):
    ck('DocTestParser: a directive on a line with no example', lambda: err(lambda: _parser.parse('>>> # doctest: +ELLIPSIS\n')),
       "ValueError: line 0 of the doctest for <string> has an option directive on a line with no example: '# doctest: +ELLIPSIS'")
if have('doctest'):
    ck('DocTestParser: bad indentation', lambda: err(lambda: _parser.parse('    >>> if 1:\n  ...   pass\n')),
       "ValueError: line 1 of the docstring for <string> has inconsistent leading whitespace: '...   pass'")
if have('doctest'):
    ck('DocTestParser: no space after the prompt', lambda: err(lambda: _parser.parse('>>>1\n')),
       "ValueError: line 1 of the docstring for <string> lacks blank after >>>: '>>>1'")

def run_test(t, flags=0, verbose=False):
    # (report text, results) of a runner over one DocTest
    out = []
    r = doctest.DocTestRunner(verbose=verbose, optionflags=flags)
    res = r.run(t, out=out.append)
    return [tbnorm("".join(out).replace(T + os.sep, "").replace(T + "/", "")), tuple(res)]

def dt(text, globs=None, name="t"):
    return _parser.get_doctest(text, dict(globs or {}), name, "t.py", 0)
if have('doctest'):
    ck('DocTestRunner report for add', lambda: run_test(DT_TESTS[1]),
       ['', (0, 1)])
