# ── Nython-only ──────────────────────────────────────────────────────────────
def guarded(name, f):
    # a part that raises is one failure, not the end of the test
    try:
        f()
    except Exception as e:
        check(name + ": raised", type(e).__name__ + ": " + str(e), None)


def nython_hypothesis():
    # doctest's +HYPOTHESIS: property checking with shrinking (the expected
    # report is lib/doctest.ny's own under python3: tools/vm_audit127_spec.py)
    write("hyp127.py", HYP_SAMPLE)
    write("hyp127_run.py", HYP_RUNNER)
    check("+HYPOTHESIS: shrunk counterexamples in doctest's failure format", child(["hyp127_run.py"]), HYP_WANT)
    import doctest
    check("+HYPOTHESIS: the flag registered on first use",
          [doctest.HYPOTHESIS == doctest.OPTIONFLAGS_BY_NAME["HYPOTHESIS"], doctest.register_optionflag("HYPOTHESIS") == doctest.HYPOTHESIS],
          [True, True])
    t = doctest.DocTestParser().get_doctest(">>> v = 7\n>>> v % 7 == 0  # doctest: +HYPOTHESIS\nTrue\n", {}, "h", "h.py", 0)
    out = []
    res = doctest.DocTestRunner(verbose=False).run(t, out=out.append)
    check("+HYPOTHESIS: an inferred int property, shrunk to the smallest failing value",
          [tuple(res), "".join(out).split("Falsifying example")[1].split("\n")[1:3]],
          [(1, 2), ["    v = 1", "Invariant failed:"]])
    t = doctest.DocTestParser().get_doctest(">>> w = 'ab'\n>>> w[::-1][::-1] == w  # doctest: +HYPOTHESIS\nTrue\n", {}, "h", "h.py", 0)
    check("+HYPOTHESIS: a property that holds", tuple(doctest.DocTestRunner(verbose=False).run(t, out=lambda s: None)), (0, 2))
    t = doctest.DocTestParser().get_doctest(">>> w = 'ab'\n>>> w[::-1][::-1] == w\nTrue\n", {}, "h", "h.py", 0)
    check("without the directive the example runs once", tuple(doctest.DocTestRunner(verbose=False).run(t, out=lambda s: None)), (0, 2))


def nython_doctest_ny():
    # nython -m doctest on a .ny module (Nython-language source)
    write("dtny127.ny", "def twice(x):\n    \"\"\"\n    >>> twice(4)\n    8\n    >>> twice('ab')\n    'abab'\n    >>> twice(1)\n    3\n    \"\"\"\n    return x * 2\n")
    check("nython -m doctest on a .ny module", child(["-m", "doctest", "dtny127.ny"]),
          [1, "**********************************************************************\nFile \"dtny127.ny\", line 7, in dtny127.twice\n"
              "Failed example:\n    twice(1)\nExpected:\n    3\nGot:\n    2\n"
              "**********************************************************************\n1 items had failures:\n   1 of   3 in dtny127.twice\n"
              "***Test Failed*** 1 failures.\n"])


def nython_crypt():
    # crypt's own SHA-512-crypt / SHA-256-crypt / MD5-crypt: libcrypt's hashes
    import crypt, _crypt
    check("crypt: the native algorithms give libcrypt's hashes",
          [[_crypt.native_crypt(w, s) for s in CRYPT_SALTS] for w in CRYPT_WORDS], CRYPT_WANT)
    check("crypt: a setting the native algorithms do not know", [_crypt.native_crypt("x", "ab"), _crypt.native_crypt("x", "*0"), _crypt.native_crypt("x", "$9$y")], ["*0", "*1", "*0"])
    check("crypt: the backend", _crypt.backend() in ("libcrypt", "native"), True)
    r = subprocess.run([sys.executable] + ENGINE + ["-c", "import crypt, _crypt\nprint(_crypt.backend(), [m.name for m in crypt.methods], crypt.crypt('pw', '$5$abc$'))"],
                       capture_output=True, timeout=120, env=dict(os.environ, NY_NO_LIBCRYPT="1"))
    check("crypt without libcrypt: the native methods", r.stdout.decode().strip(),
          "native ['SHA512', 'SHA256', 'MD5'] " + CRYPT_PW5)


def nython_nis():
    # nis: libnsl at run time; on a machine without a NIS domain, nis.error
    try:
        import nis
    except ModuleNotFoundError:
        check("nis: no libnsl here (ModuleNotFoundError)", True, True)
        return
    try:
        nd = ["domain", type(nis.get_default_domain()).__name__]
    except nis.error as e:
        nd = ["error", str(e) != ""]
    check("nis: the default domain or nis.error", nd[0] in ("domain", "error") and nd[1] in ("str", True), True)
    check("nis: error class and aliases", [nis.error.__module__, issubclass(nis.error, Exception), nis._mapname("passwd"), nis._mapname("hosts"), nis._mapname("other")],
          ["nis", True, "passwd.byname", "hosts.byname", "other"])
    check("nis: argument errors", [err(lambda: nis.match(1, "passwd")), err(lambda: nis.cat(2))],
          ["TypeError: match() argument 'key' must be str, not int", "TypeError: cat() argument 'map' must be str, not int"])


def nython_turtledemo():
    # turtledemo: the demo viewer over lib/turtle.ny, under the headless stub
    import turtledemo
    import turtledemo.__main__ as tdm
    check("turtledemo: the examples", sorted(tdm.getExampleEntries()),
          ['bytedesign', 'chaos', 'clock', 'colormixer', 'forest', 'fractalcurves', 'lindenmayer', 'minimal_hanoi', 'nim', 'paint', 'peace', 'penrose', 'planet_and_moon', 'rosette', 'round_dance', 'sorting_animate', 'tree', 'two_canvases', 'yinyang'])
    demo = tdm.DemoWindow()
    demo.loadfile("yinyang")
    src = demo.text.get("1.0", "end")
    check("turtledemo: a demo loaded into the viewer", ["def yin(radius, color1, color2)" in src, demo.state == tdm.READY, demo.root.title()],
          [True, True, "yinyang - a Python turtle graphics example"])
    check("turtledemo: the source coloured (keywords, strings, comments)",
          [len(demo.text.tag_ranges("KEYWORD")) > 0, len(demo.text.tag_ranges("STRING")) > 0, len(demo.text.tag_ranges("COMMENT")) > 0],
          [True, True, True])
    # the stub's one quit event (NY_STUB_AUTOQUIT) must not close the viewer
    # halfway, and the demo is drawn without animation (tracer off: the
    # same drawing, in a second instead of half a minute)
    demo.root.wm_protocol("WM_DELETE_WINDOW", lambda: None)
    demo_main = demo.module.main

    def fast_main():
        demo.screen.tracer(0)
        try:
            return demo_main()
        finally:
            demo.screen.tracer(1)
    demo.module.main = fast_main
    demo.startDemo()
    check("turtledemo: the demo ran to its end", [demo.state == tdm.DONE, demo.output_lbl["text"], len(demo.screen.cv.find_all()) > 10],
          [True, "Done!", True])
    demo.clearCanvas()
    check("turtledemo: CLEAR empties the canvas", len(demo.screen.cv.find_all()), 0)
    demo._destroy()


if NYTHON:
    guarded("+HYPOTHESIS", nython_hypothesis)
    guarded("doctest on .ny", nython_doctest_ny)
    guarded("crypt (native)", nython_crypt)
    guarded("nis", nython_nis)
    guarded("turtledemo", nython_turtledemo)

shutil.rmtree(T, ignore_errors=True)

pass_n = 0
fail_n = 0
for r in results:
    if r[1]:
        pass_n = pass_n + 1
    else:
        fail_n = fail_n + 1
        g = repr(r[2])
        w = repr(r[3])
        if len(g) > 400 or len(w) > 400:
            k = 0
            while k < len(g) and k < len(w) and g[k] == w[k]:
                k += 1
            print("FAIL " + r[0] + ": differs at " + str(k) + ": got ..." + g[max(0, k - 160):k + 200] + " want ..." + w[max(0, k - 160):k + 200])
        else:
            print("FAIL " + r[0] + ": got " + g + " want " + w)
if skipped:
    print("skipped (not in this Python): " + ", ".join(sorted(set(skipped))))
print("Results: " + str(pass_n) + " passed, " + str(fail_n) + " failed")
if fail_n == 0:
    print("=== VM_AUDIT127 PASSED ===")
