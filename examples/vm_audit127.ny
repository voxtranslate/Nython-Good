import sre_parse
import sre_compile
import sre_constants
import re._parser
import re._compiler
import re._constants
import re._casefix
SRE_PATTERNS = [r"a(b|c)*d", r"^\w+@[a-z]+\.(com|org)$", r"(?P<year>\d{4})-(?P<m>\d\d)", r"[^a-z0-9_]+?",
                r"(?i)hello\s+world", r"a{2,5}b{3}c{,4}?", r"(?:x|y)+(?=z)(?!q)(?<=a)(?<!b)", r"\bfoo\B",
                r"(a)(?(1)b|c)", r"\x41é\N{LATIN SMALL LETTER A}\0", r"[\d\s\w.-]", r"(?s:.)(?m:$)",
                r"a|b|c|d", r"(?>ab|a)c", r"a*+b?+c++", r"(a)\1", r"[]a-]", r"\A\Z", "(?x) a  # comment\n b"]

def dump(p, flags=0):
    return captured(sre_parse.parse(p, flags).dump)[0]
if have('sre_parse'):
    ck('sre_parse.parse(...).dump()', lambda: [dump(p) for p in SRE_PATTERNS],
       ['LITERAL 97\nMAX_REPEAT 0 MAXREPEAT\n  SUBPATTERN 1 0 0\n    IN\n      LITERAL 98\n      LITERAL 99\nLITERAL 100\n', 'AT AT_BEGINNING\nMAX_REPEAT 1 MAXREPEAT\n  IN\n    CATEGORY CATEGORY_WORD\nLITERAL 64\nMAX_REPEAT 1 MAXREPEAT\n  IN\n    RANGE (97, 122)\nLITERAL 46\nSUBPATTERN 1 0 0\n  BRANCH\n    LITERAL 99\n    LITERAL 111\n    LITERAL 109\n  OR\n    LITERAL 111\n    LITERAL 114\n    LITERAL 103\nAT AT_END\n', 'SUBPATTERN 1 0 0\n  MAX_REPEAT 4 4\n    IN\n      CATEGORY CATEGORY_DIGIT\nLITERAL 45\nSUBPATTERN 2 0 0\n  IN\n    CATEGORY CATEGORY_DIGIT\n  IN\n    CATEGORY CATEGORY_DIGIT\n', 'MIN_REPEAT 1 MAXREPEAT\n  IN\n    NEGATE None\n    RANGE (97, 122)\n    RANGE (48, 57)\n    LITERAL 95\n', 'LITERAL 104\nLITERAL 101\nLITERAL 108\nLITERAL 108\nLITERAL 111\nMAX_REPEAT 1 MAXREPEAT\n  IN\n    CATEGORY CATEGORY_SPACE\nLITERAL 119\nLITERAL 111\nLITERAL 114\nLITERAL 108\nLITERAL 100\n', 'MAX_REPEAT 2 5\n  LITERAL 97\nMAX_REPEAT 3 3\n  LITERAL 98\nMIN_REPEAT 0 4\n  LITERAL 99\n', 'MAX_REPEAT 1 MAXREPEAT\n  IN\n    LITERAL 120\n    LITERAL 121\nASSERT 1\n  LITERAL 122\nASSERT_NOT 1\n  LITERAL 113\nASSERT -1\n  LITERAL 97\nASSERT_NOT -1\n  LITERAL 98\n', 'AT AT_BOUNDARY\nLITERAL 102\nLITERAL 111\nLITERAL 111\nAT AT_NON_BOUNDARY\n', 'SUBPATTERN 1 0 0\n  LITERAL 97\nGROUPREF_EXISTS 1\n  LITERAL 98\nELSE\n  LITERAL 99\n', 'LITERAL 65\nLITERAL 233\nLITERAL 97\nLITERAL 0\n', 'IN\n  CATEGORY CATEGORY_DIGIT\n  CATEGORY CATEGORY_SPACE\n  CATEGORY CATEGORY_WORD\n  LITERAL 46\n  LITERAL 45\n', 'SUBPATTERN None 16 0\n  ANY None\nSUBPATTERN None 8 0\n  AT AT_END\n', 'IN\n  LITERAL 97\n  LITERAL 98\n  LITERAL 99\n  LITERAL 100\n', 'ATOMIC_GROUP\n  LITERAL 97\n  BRANCH\n    LITERAL 98\n  OR\nLITERAL 99\n', 'POSSESSIVE_REPEAT 0 MAXREPEAT\n  LITERAL 97\nPOSSESSIVE_REPEAT 0 1\n  LITERAL 98\nPOSSESSIVE_REPEAT 1 MAXREPEAT\n  LITERAL 99\n', 'SUBPATTERN 1 0 0\n  LITERAL 97\nGROUPREF 1\n', 'IN\n  LITERAL 93\n  LITERAL 97\n  LITERAL 45\n', 'AT AT_BEGINNING_STRING\nAT AT_END_STRING\n', 'LITERAL 97\nLITERAL 98\n'])
