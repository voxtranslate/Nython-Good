# ── lib2to3 ──────────────────────────────────────────────────────────────────
PY2_SRC = """\
import urllib2
from itertools import imap
def f(a, (b, c)):
    print "hello", a
    print >>sys.stderr, "err"
    try:
        raise ValueError, "bad"
    except ValueError, e:
        pass
    d = {}
    if d.has_key('x'):
        for k in d.keys():
            print k
    for i in xrange(10):
        s = unicode(i) + `i`
    x = 0777L
    exec "y = 1"
    y = raw_input()
    if x <> y:
        apply(f, (1,))
    l = map(str, [1, 2])
    n = it.next()
    z = reduce(lambda a, b: a + b, [1, 2])
    return isinstance(s, basestring)
"""
def refactor(src, fixers=None):
    from lib2to3 import refactor as rf
    names = rf.get_fixers_from_package("lib2to3.fixes") if fixers is None else ["lib2to3.fixes.fix_" + f for f in fixers]
    tool = rf.RefactoringTool(names)
    return str(tool.refactor_string(src, "<x>"))
if have('lib2to3'):
    ck('lib2to3: every default fixer over a Python 2 module', lambda: refactor(PY2_SRC),
       'import urllib.request, urllib.error, urllib.parse\nfrom functools import reduce\n\ndef f(a, xxx_todo_changeme):\n    (b, c) = xxx_todo_changeme\n    print("hello", a)\n    print("err", file=sys.stderr)\n    try:\n        raise ValueError("bad")\n    except ValueError as e:\n        pass\n    d = {}\n    if \'x\' in d:\n        for k in list(d.keys()):\n            print(k)\n    for i in range(10):\n        s = str(i) + repr(i)\n    x = 0777\n    exec("y = 1")\n    y = input()\n    if x != y:\n        f(*(1,))\n    l = list(map(str, [1, 2]))\n    n = next(it)\n    z = reduce(lambda a, b: a + b, [1, 2])\n    return isinstance(s, str)\n')
if have('lib2to3'):
    ck('lib2to3: single fixers', lambda: [refactor('print x, y\n', ['print']), refactor('try:\n    pass\nexcept E, e:\n    pass\n', ['except']), refactor('d.keys()\n', ['dict']), refactor('d.has_key(k)\n', ['has_key']), refactor('raise E, v\n', ['raise']), refactor('unicode(x)\n', ['unicode']), refactor('xrange(3)\n', ['xrange'])],
       ['print(x, y)\n', 'try:\n    pass\nexcept E as e:\n    pass\n', 'list(d.keys())\n', 'k in d\n', 'raise E(v)\n', 'str(x)\n', 'range(3)\n'])
if have('lib2to3'):
    ck('lib2to3: the fixer names', lambda: __import__('lib2to3.refactor').refactor.get_all_fix_names('lib2to3.fixes'),
       ['apply', 'asserts', 'basestring', 'buffer', 'dict', 'except', 'exec', 'execfile', 'exitfunc', 'filter', 'funcattrs', 'future', 'getcwdu', 'has_key', 'idioms', 'import', 'imports', 'imports2', 'input', 'intern', 'isinstance', 'itertools', 'itertools_imports', 'long', 'map', 'metaclass', 'methodattrs', 'ne', 'next', 'nonzero', 'numliterals', 'operator', 'paren', 'print', 'raise', 'raw_input', 'reduce', 'reload', 'renames', 'repr', 'set_literal', 'standarderror', 'sys_exc', 'throw', 'tuple_params', 'types', 'unicode', 'urllib', 'ws_comma', 'xrange', 'xreadlines', 'zip'])
if have('lib2to3'):
    ck('lib2to3: a parse tree round trip', lambda: (lambda d: [str(d.parse_string('x = 1  # c\nif x:\n    y = [1,\n         2]\n')), type(d.parse_string('x\n')).__name__])(__import__('lib2to3.pgen2.driver').pgen2.driver.Driver(__import__('lib2to3.pygram').pygram.python_grammar, convert=__import__('lib2to3.pytree').pytree.convert)),
       ['x = 1  # c\nif x:\n    y = [1,\n         2]\n', 'Node'])
