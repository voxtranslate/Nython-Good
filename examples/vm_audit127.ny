# compile(..., "single") shows expression statements' values, as the prompt
def single(src, ns=None):
    return captured(lambda: exec(compile(src, "<s>", "single"), ns if ns is not None else {}))[0]
if have('doctest'):
    ck('compile single: an expression', lambda: single('1 + 2\n'),
       '3\n')
if have('doctest'):
    ck('compile single: None shows nothing, a string its repr', lambda: [single('None\n'), single('"a"\n'), single('x = 5\n')],
       ['', "'a'\n", ''])
if have('doctest'):
    ck("compile single: a loop's expression statements", lambda: single('for i in range(3):\n    i * 10\n'),
       '0\n10\n20\n')
if have('doctest'):
    ck('compile single: if/else, with, try', lambda: single('if 1:\n    "yes"\nelse:\n    "no"\n') + single('try:\n    [1]\nexcept E:\n    pass\n'),
       "'yes'\n[1]\n")
if have('doctest'):
    ck("compile single: a function's body is not shown", lambda: single('def f():\n    5\n'),
       '')
if have('doctest'):
    ck('compile single: through sys.displayhook', lambda: (lambda old, seen: (setattr(sys, 'displayhook', seen.append), exec(compile('42\n', '<s>', 'single'), {}), setattr(sys, 'displayhook', old), seen)[3])(sys.displayhook, []),
       [42])
if have('doctest'):
    ck('compile single code object', lambda: [compile('1', '<s>', 'single').co_filename, eval(compile('1', '<s>', 'single'), {}) if False else None],
       ['<s>', None])

