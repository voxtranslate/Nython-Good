# ── xdrlib ───────────────────────────────────────────────────────────────────
def xdr_demo():
    import xdrlib
    p = xdrlib.Packer()
    p.pack_uint(7)
    p.pack_int(-3)
    p.pack_enum(2)
    p.pack_bool(True)
    p.pack_uhyper(2 ** 40 + 5)
    p.pack_hyper(-(2 ** 33))
    p.pack_float(1.5)
    p.pack_double(-2.25)
    p.pack_fstring(5, b"abc")
    p.pack_string(b"hello")
    p.pack_opaque(b"xy")
    p.pack_bytes(b"")
    p.pack_list([1, 2, 3], p.pack_int)
    p.pack_farray(2, [4, 5], p.pack_uint)
    p.pack_array([b"a", b"bc"], p.pack_string)
    buf = p.get_buffer()
    u = xdrlib.Unpacker(buf)
    out = [u.unpack_uint(), u.unpack_int(), u.unpack_enum(), u.unpack_bool(), u.unpack_uhyper(), u.unpack_hyper(),
           u.unpack_float(), u.unpack_double(), u.unpack_fstring(5), u.unpack_string(), u.unpack_opaque(),
           u.unpack_bytes(), u.unpack_list(u.unpack_int), u.unpack_farray(2, u.unpack_uint),
           u.unpack_array(u.unpack_string), u.get_position(), len(buf)]
    u.done()
    return [buf, out]
if have('xdrlib'):
    ck('xdrlib: Packer bytes and Unpacker values', lambda: xdr_demo(),
       [b'\x00\x00\x00\x07\xff\xff\xff\xfd\x00\x00\x00\x02\x00\x00\x00\x01\x00\x00\x01\x00\x00\x00\x00\x05\xff\xff\xff\xfe\x00\x00\x00\x00?\xc0\x00\x00\xc0\x02\x00\x00\x00\x00\x00\x00abc\x00\x00\x00\x00\x00\x00\x00\x00\x05hello\x00\x00\x00\x00\x00\x00\x02xy\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x01a\x00\x00\x00\x00\x00\x00\x02bc\x00\x00', [7, -3, 2, True, 1099511627781, -8589934592, 1.5, -2.25, b'abc\x00\x00', b'hello', b'xy', b'', [1, 2, 3], [4, 5], [b'a', b'bc'], 132, 132]])
if have('xdrlib'):
    ck('xdrlib: errors', lambda: (lambda xdrlib: [err(lambda: xdrlib.Packer().pack_uint(-1)).split(':')[0], err(lambda: xdrlib.Packer().pack_int(2 ** 40)).split(':')[0], err(lambda: xdrlib.Unpacker(b'\x00\x00').unpack_uint()), err(lambda: xdrlib.Unpacker(b'\x00\x00\x00\x01x').done()), err(lambda: xdrlib.Packer().pack_farray(3, [1], None)), repr(xdrlib.Error('m')), str(xdrlib.ConversionError('c'))])(__import__('xdrlib')),
       ['ConversionError', 'ConversionError', 'EOFError: ', 'Error: unextracted data remains', 'ValueError: wrong array size', "'m'", 'c'])
if have('xdrlib'):
    ck('xdrlib: reset, set_position, get_buffer', lambda: (lambda xdrlib: (lambda p, u: [p.pack_int(1), p.get_buffer(), p.reset(), p.get_buffer(), u.unpack_int(), u.set_position(0), u.unpack_int(), u.get_buffer(), u.reset(b'\x00\x00\x00\x09'), u.unpack_uint()])(xdrlib.Packer(), xdrlib.Unpacker(b'\x00\x00\x00\x05')))(__import__('xdrlib')),
       [None, b'\x00\x00\x00\x01', None, b'', 5, None, 5, b'\x00\x00\x00\x05', None, 9])

# ── nntplib ──────────────────────────────────────────────────────────────────
NNTP_ARTICLES = {
    1: [b"From: Ann <ann@example.org>", b"Subject: First post", b"Message-ID: <m1@test>",
        b"Date: Tue, 02 Jan 2024 03:04:05 +0000", b"", b"Hello.", b".dotted line", b"End."],
    2: [b"From: Bob <bob@example.org>", b"Subject: =?utf-8?q?Caf=C3=A9?=", b"Message-ID: <m2@test>",
        b"Date: Wed, 03 Jan 2024 10:00:00 +0100", b"", b"Second."],
}

def nntp_server(sock, log):
    conn, _ = sock.accept()
    f = conn.makefile("rwb")
    def send(*lines):
        for ln in lines:
            if isinstance(ln, str):
                ln = ln.encode()
            f.write(ln + b"\r\n")
        f.flush()
    def art(n, part):
        a = NNTP_ARTICLES[n]
        cut = a.index(b"")
        lines = a if part == "a" else (a[:cut] if part == "h" else a[cut + 1:])
        return [(b"." + ln if ln.startswith(b".") else ln) for ln in lines] + [b"."]
    send("200 NNTP test server ready (posting ok)")
    posting = False
    posted = []
    while True:
        line = f.readline()
        if not line:
            break
        line = line.rstrip(b"\r\n").decode()
        if posting:
            if line == ".":
                posting = False
                log.append(("POSTED", posted[:]))
                send("240 Article received OK")
            else:
                posted.append(line)
            continue
        log.append(line)
        cmd = line.split()[0].upper() if line.split() else ""
        args = line.split()[1:]
        if cmd == "CAPABILITIES":
            send("101 Capability list:", "VERSION 2", "READER", "POST", "OVER", "LIST ACTIVE NEWSGROUPS OVERVIEW.FMT", ".")
        elif cmd == "GROUP":
            send("211 2 1 2 " + args[0]) if args[0] == "comp.test" else send("411 No such group " + args[0])
        elif cmd in ("ARTICLE", "HEAD", "BODY"):
            n = int(args[0]) if args and args[0].isdigit() else 1
            if n not in NNTP_ARTICLES:
                send("423 No article with that number")
                continue
            code_ = {"ARTICLE": "220", "HEAD": "221", "BODY": "222"}[cmd]
            send(code_ + " %d <m%d@test>" % (n, n), *art(n, cmd[0].lower()))
        elif cmd == "STAT":
            send("223 2 <m2@test>")
        elif cmd == "NEXT":
            send("223 2 <m2@test> next")
        elif cmd == "LAST":
            send("422 No previous article")
        elif cmd == "LIST" and args and args[0].upper() == "OVERVIEW.FMT":
            send("215 Order of fields in overview database.", "Subject:", "From:", "Date:", "Message-ID:", "References:", ":bytes", ":lines", "Xref:full", ".")
        elif cmd == "LIST" and args and args[0].upper() == "NEWSGROUPS":
            send("215 Descriptions", "comp.test A test group", "comp.other Other things", ".")
        elif cmd == "LIST":
            send("215 list of newsgroups follows", "comp.test 0000000002 0000000001 y", "comp.other 0000000010 0000000005 n", ".")
        elif cmd in ("OVER", "XOVER"):
            send("224 Overview information follows",
                 "1\tFirst post\tAnn <ann@example.org>\tTue, 02 Jan 2024 03:04:05 +0000\t<m1@test>\t\t120\t3\tXref: test comp.test:1",
                 "2\t=?utf-8?q?Caf=C3=A9?=\tBob <bob@example.org>\tWed, 03 Jan 2024 10:00:00 +0100\t<m2@test>\t<m1@test>\t90\t1\tXref: test comp.test:2", ".")
        elif cmd == "DATE":
            send("111 20240102030405")
        elif cmd == "NEWGROUPS":
            send("231 New newsgroups follow", "comp.new 5 1 y", ".")
        elif cmd == "NEWNEWS":
            send("230 New articles follow", "<m1@test>", "<m2@test>", ".")
        elif cmd == "HELP":
            send("100 Help text follows", "This is a test server.", ".")
        elif cmd == "POST":
            posting = True
            posted = []
            send("340 Input article; end with <CR-LF>.<CR-LF>")
        elif cmd == "QUIT":
            send("205 Bye")
            break
        else:
            send("500 What?")
    f.close()
    conn.close()

def nntp_demo():
    import nntplib
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    sock.listen(1)
    log = []
    th = threading.Thread(target=nntp_server, args=(sock, log), daemon=True)
    th.start()
    s = nntplib.NNTP("127.0.0.1", sock.getsockname()[1], timeout=30)
    out = [s.getwelcome(), s.getcapabilities(), s.group("comp.test"),
           s.article(1), s.head(2), s.body(1), s.stat(2), s.next(), err(lambda: s.last()),
           s.over((1, 2)), s.date(), s.list(), s.descriptions("comp.*"), s.description("comp.test"),
           s.newgroups(__import__("datetime").date(2024, 1, 1)), s.help(),
           err(lambda: s.group("no.such")), err(lambda: s.article(99)), s.xover(1, 2)]
    out.append(s.post(io.BytesIO(b"From: me@example.org\r\nNewsgroups: comp.test\r\nSubject: hi\r\n\r\nBody line\r\n.starts with a dot\r\n")))
    out.append(s.quit())
    th.join(60)
    sock.close()
    return [out, log]
if have('nntplib'):
    ck('nntplib: a whole session against a local server', lambda: plain(nntp_demo()),
       [['200 NNTP test server ready (posting ok)', {'VERSION': ['2'], 'READER': [], 'POST': [], 'OVER': [], 'LIST': ['ACTIVE', 'NEWSGROUPS', 'OVERVIEW.FMT']}, ('211 2 1 2 comp.test', 2, 1, 2, 'comp.test'), ('220 1 <m1@test>', (1, '<m1@test>', [b'From: Ann <ann@example.org>', b'Subject: First post', b'Message-ID: <m1@test>', b'Date: Tue, 02 Jan 2024 03:04:05 +0000', b'', b'Hello.', b'.dotted line', b'End.'])), ('221 2 <m2@test>', (2, '<m2@test>', [b'From: Bob <bob@example.org>', b'Subject: =?utf-8?q?Caf=C3=A9?=', b'Message-ID: <m2@test>', b'Date: Wed, 03 Jan 2024 10:00:00 +0100'])), ('222 1 <m1@test>', (1, '<m1@test>', [b'Hello.', b'.dotted line', b'End.'])), ('223 2 <m2@test>', 2, '<m2@test>'), ('223 2 <m2@test> next', 2, '<m2@test>'), 'NNTPTemporaryError: 422 No previous article', ('224 Overview information follows', [(1, {'subject': 'First post', 'from': 'Ann <ann@example.org>', 'date': 'Tue, 02 Jan 2024 03:04:05 +0000', 'message-id': '<m1@test>', 'references': '', ':bytes': '120', ':lines': '3', 'xref': 'test comp.test:1'}), (2, {'subject': '=?utf-8?q?Caf=C3=A9?=', 'from': 'Bob <bob@example.org>', 'date': 'Wed, 03 Jan 2024 10:00:00 +0100', 'message-id': '<m2@test>', 'references': '<m1@test>', ':bytes': '90', ':lines': '1', 'xref': 'test comp.test:2'})]), ('111 20240102030405', 'datetime.datetime(2024, 1, 2, 3, 4, 5)'), ('215 list of newsgroups follows', [('comp.test', '0000000002', '0000000001', 'y'), ('comp.other', '0000000010', '0000000005', 'n')]), ('215 Descriptions', {'comp.test': 'A test group', 'comp.other': 'Other things'}), 'A test group', ('231 New newsgroups follow', [('comp.new', '5', '1', 'y')]), ('100 Help text follows', ['This is a test server.']), 'NNTPTemporaryError: 411 No such group no.such', 'NNTPTemporaryError: 423 No article with that number', ('224 Overview information follows', [(1, {'subject': 'First post', 'from': 'Ann <ann@example.org>', 'date': 'Tue, 02 Jan 2024 03:04:05 +0000', 'message-id': '<m1@test>', 'references': '', ':bytes': '120', ':lines': '3', 'xref': 'test comp.test:1'}), (2, {'subject': '=?utf-8?q?Caf=C3=A9?=', 'from': 'Bob <bob@example.org>', 'date': 'Wed, 03 Jan 2024 10:00:00 +0100', 'message-id': '<m2@test>', 'references': '<m1@test>', ':bytes': '90', ':lines': '1', 'xref': 'test comp.test:2'})]), '240 Article received OK', '205 Bye'], ['CAPABILITIES', 'GROUP comp.test', 'ARTICLE 1', 'HEAD 2', 'BODY 1', 'STAT 2', 'NEXT', 'LAST', 'OVER 1-2', 'LIST OVERVIEW.FMT', 'DATE', 'LIST', 'LIST NEWSGROUPS comp.*', 'LIST NEWSGROUPS comp.test', 'NEWGROUPS 20240101 000000', 'HELP', 'GROUP no.such', 'ARTICLE 99', 'XOVER 1-2', 'POST', ('POSTED', ['From: me@example.org', 'Newsgroups: comp.test', 'Subject: hi', '', 'Body line', '..starts with a dot']), 'QUIT']])
