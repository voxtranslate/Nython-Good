# nython: python    (the checks run under python3 too: Python's spelling and binding rule)
# vm_audit127.ny - the standard-library modules round 87 added (part L):
#
#   doctest        CPython's, reports byte for byte: python -m doctest on a
#                  module and a text file (plain, -v, -o flags, -f), every
#                  option flag, directives, tracebacks expected and not,
#                  DocTestParser / DocTestFinder (line numbers, classes,
#                  static/class methods, properties, __test__) / DocTestRunner
#                  / OutputChecker with its diffs / DebugRunner, testmod,
#                  testfile, run_docstring_examples, DocTestSuite and
#                  DocFileSuite under unittest, script_from_examples,
#                  testsource; compile(..., "single") showing values
#   sre_parse, sre_compile, sre_constants, re._parser / re._compiler:
#                  CPython's SubPattern trees (dump()), code lists, dis()
#   pipes, imp, xdrlib, nntplib (against a local NNTP server), asyncore,
#   asynchat, smtpd (driven by smtplib), pyexpat (errors / model modules),
#   pydoc_data (topics, help()), crypt (libcrypt's hashes), spwd,
#   ossaudiodev (the errors of a system without OSS), lib2to3 (the fixers,
#   -m lib2to3 -w), __future__
#   Nython-only: doctest's +HYPOTHESIS property checking (shrunk
#   counterexamples), crypt's own SHA-512/SHA-256/MD5-crypt against
#   libcrypt's, nis, turtledemo driven headlessly
#
# Every expected value is what CPython 3.11 gives (the file is generated by
# tools/vm_audit127_spec.py), so `python3 examples/vm_audit127.ny` passes too.
#
#     ./build/nython-cli examples/vm_audit127.ny
#     ./build/nython-cli --vm examples/vm_audit127.ny

import sys
import errno
import os
import io
import re
import time
import socket
import shutil
import tempfile
import threading
import subprocess
import warnings
import importlib
import contextlib

NYTHON = sys.implementation.name == "nython"
sys.dont_write_bytecode = True
os.environ["NYTHON_SPELLING"] = "python"
warnings.simplefilter("ignore", DeprecationWarning)
warnings.simplefilter("ignore", PendingDeprecationWarning)

results = []
skipped = []


def check(name, got, want):
    results.append([name, repr(got) == repr(want), got, want])


def ck(name, f, want):
    # check(name, f(), want), an exception f raises being what it got
    try:
        got = f()
    except Exception as e:
        got = "raised " + type(e).__name__ + ": " + str(e)
    check(name, got, want)


_have = {}


def have(mod):
    # the module is importable here (on Nython every one must be: a missing
    # one fails its checks instead of skipping them)
    if NYTHON:
        return True
    if mod not in _have:
        try:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                importlib.import_module(mod)
            _have[mod] = True
        except ImportError:
            _have[mod] = False
            skipped.append(mod)
    return _have[mod]


def err(f):
    # the exception f() raises: its type name and message
    try:
        f()
    except Exception as e:
        return type(e).__name__ + ": " + str(e)
    return "no error"


ENGINE = ["--vm"] if NYTHON and "--vm" in getattr(sys, "orig_argv", []) else []
T = os.path.realpath(tempfile.mkdtemp(prefix="ny127_"))
sys.path.insert(0, T)

# The one thing in doctest's reports that cannot be the same: a traceback's
# frame in the doctest module itself (its path and line: /usr/lib/python3.11/
# doctest.py, line 1355 - lib/doctest.ny there), and the ~~^~~ lines CPython
# 3.11 puts under an expression's position. Both are cut from the reports,
# on every Python; everything else is compared as printed.
_TB_OWN = re.compile(r'^( *(?:[-+!?] *)?)File "[^"\n]*doctest\.(?:py|ny)", line \d+, in [^\n]*\n(?:\1  [^\n]*\n)?', re.M)
_TB_CARET = re.compile(r'^ *(?:[-+!?] *)?[~^]+ *\n', re.M)


def tbnorm(s):
    return _TB_CARET.sub("", _TB_OWN.sub("", s))


def child(args, inp=None):
    # [exit status, stdout] of this Python run with args in T (T's path cut
    # out of what it printed)
    r = subprocess.run([sys.executable] + ENGINE + args, cwd=T, capture_output=True, timeout=600, input=inp)
    out = r.stdout.decode("utf-8", "replace").replace("\r\n", "\n").replace(T + os.sep, "").replace(T + "/", "")
    return [r.returncode, tbnorm(out)]


def write(name, text):
    p = os.path.join(T, name)
    d = os.path.dirname(p)
    if not os.path.isdir(d):
        os.makedirs(d)
    with open(p, "w") as f:
        f.write(text)
    return p


def captured(f, *args, **kw):
    # what f(*args) printed, and its result
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        r = f(*args, **kw)
    if isinstance(r, tuple):
        r = tuple(r)   # doctest's TestResults as a plain tuple
    return [tbnorm(buf.getvalue().replace(T + os.sep, "").replace(T + "/", "")), r]


def plain(x):
    # named tuples as tuples, other objects as their repr: values both
    # Pythons write the same way
    if isinstance(x, tuple):
        return tuple(plain(v) for v in x)
    if isinstance(x, list):
        return [plain(v) for v in x]
    if isinstance(x, dict):
        return {plain(k): plain(v) for k, v in x.items()}
    if x is None or isinstance(x, (bool, int, float, str, bytes)):
        return x
    return repr(x)


def fresh(name):
    # import a module written into T, again
    sys.modules.pop(name, None)
    importlib.invalidate_caches()
    return importlib.import_module(name)


# ── doctest ──────────────────────────────────────────────────────────────────
DTSAMPLE = """\
\"\"\"A sample module for doctest.

>>> 1 + 1
2
>>> print("hello")
hello
>>> x = 5
>>> x * 3
15
\"\"\"


def add(a, b):
    \"\"\"Add two things.

    >>> add(1, 2)
    3
    >>> add('a', 'b')
    'ab'
    >>> add([1], [2])
    [1, 2]
    >>> add(1, 2)
    4
    \"\"\"
    return a + b


def boom():
    \"\"\"
    >>> boom()
    Traceback (most recent call last):
      ...
    ValueError: bad thing
    >>> boom()  # doctest: +IGNORE_EXCEPTION_DETAIL
    Traceback (most recent call last):
    ValueError: some other detail
    >>> boom()
    Traceback (most recent call last):
    ValueError: wrong message
    >>> int("x")
    Traceback (most recent call last):
    ValueError: invalid literal for int() with base 10: 'x'
    \"\"\"
    raise ValueError("bad thing")


def flags():
    \"\"\"
    >>> list(range(20))  # doctest: +ELLIPSIS
    [0, 1, ..., 19]
    >>> list(range(20))
    [0, 1, ..., 19]
    >>> print("a   b\\\\n  c")  # doctest: +NORMALIZE_WHITESPACE
    a b c
    >>> print("x\\\\n\\\\ny")
    x
    <BLANKLINE>
    y
    >>> print("x\\\\n\\\\ny")  # doctest: +DONT_ACCEPT_BLANKLINE
    x
    <BLANKLINE>
    y
    >>> 1/0  # doctest: +SKIP
    >>> True
    1
    >>> True  # doctest: +DONT_ACCEPT_TRUE_FOR_1
    1
    >>> [1, 2,
    ...  3]
    [1, 2, 3]
    >>> for i in range(3):
    ...     i * i
    0
    1
    4
    >>> None
    >>> def inner(n):
    ...     return n + 1
    >>> inner(1)
    2
    \"\"\"


def diffs():
    \"\"\"
    >>> print("\\\\n".join(["one", "two", "three", "four"]))  # doctest: +REPORT_UDIFF
    one
    TWO
    three
    four
    >>> print("\\\\n".join(["one", "two", "three", "four"]))  # doctest: +REPORT_CDIFF
    one
    two
    tree
    four
    >>> print("one two three")  # doctest: +REPORT_NDIFF
    one too three
    \"\"\"


class Klass:
    \"\"\"A class.

    >>> Klass(3).double()
    6
    \"\"\"

    def __init__(self, v):
        self.v = v

    def double(self):
        \"\"\"
        >>> Klass(2).double()
        4
        \"\"\"
        return self.v * 2

    @staticmethod
    def stat():
        \"\"\"
        >>> Klass.stat()
        'static'
        \"\"\"
        return 'static'

    @classmethod
    def cm(cls):
        \"\"\"
        >>> Klass.cm()
        'Klass'
        \"\"\"
        return cls.__name__

    @property
    def prop(self):
        \"\"\"
        >>> Klass(5).prop
        5
        \"\"\"
        return self.v

    class Inner:
        \"\"\"
        >>> Klass.Inner.__name__
        'Inner'
        \"\"\"


def no_examples():
    \"\"\"Nothing to run here.\"\"\"


__test__ = {"extra": \"\"\"
>>> y = 10
>>> y * 2
20
>>> y + 1
12
\"\"\"}
"""
write("dtsample.py", DTSAMPLE)

DTPASS = """\
\"\"\"
>>> 2 + 2
4
\"\"\"


def ok(n):
    \"\"\"
    >>> ok(3)
    [0, 1, 2]
    \"\"\"
    return list(range(n))
"""
write("dtpass.py", DTPASS)

DTTEXT = """\
A text file of examples
=======================

>>> from dtpass import ok
>>> ok(2)
[0, 1]

Some prose, then a failure:

>>> ok(1)
[1]
>>> print("tail")
tail
"""
write("dtsample.txt", DTTEXT)

