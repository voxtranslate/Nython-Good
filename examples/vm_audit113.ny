check('decoding errors (message and extent)', [err(lambda: b'\x81'.decode('gbk')), err(lambda: b'\x81\x20'.decode('gbk')), err(lambda: b'abc\xff\xfe'.decode('big5')), err(lambda: b'\x8f\xa1'.decode('euc_jp')), err(lambda: b'\x81\x30\x81'.decode('gb18030')), err(lambda: b'\xa4\xd4\xa4\xa1'.decode('euc_kr')), err(lambda: b'\x1b$B\x21'.decode('iso2022_jp')), err(lambda: b'\x1b$Z'.decode('iso2022_jp')), err(lambda: b'\xa9\xa1'.decode('euc_jisx0213'))],
      ["UnicodeDecodeError: 'gbk' codec can't decode byte 0x81 in position 0: incomplete multibyte sequence", "UnicodeDecodeError: 'gbk' codec can't decode byte 0x81 in position 0: illegal multibyte sequence", "UnicodeDecodeError: 'big5' codec can't decode byte 0xff in position 3: illegal multibyte sequence", "UnicodeDecodeError: 'euc_jp' codec can't decode bytes in position 0-1: incomplete multibyte sequence", "UnicodeDecodeError: 'gb18030' codec can't decode bytes in position 0-2: incomplete multibyte sequence", "UnicodeDecodeError: 'euc_kr' codec can't decode bytes in position 0-3: incomplete multibyte sequence", "UnicodeDecodeError: 'iso2022_jp' codec can't decode byte 0x21 in position 3: incomplete multibyte sequence", "UnicodeDecodeError: 'iso2022_jp' codec can't decode bytes in position 0-2: illegal multibyte sequence", 'no error'])
check('decoding with each error handler', [b'a\x81b\xff'.decode('gbk', e) for e in ('replace', 'ignore', 'backslashreplace', 'surrogateescape')] + [err(lambda: b'\x81'.decode('gbk', 'xmlcharrefreplace')), err(lambda: b'\x81'.decode('gbk', 'surrogatepass')), err(lambda: b'\x81'.decode('gbk', 'nosuch'))],
      ['a乥�', 'a乥', 'a乥\\xff', 'a乥\udcff', "TypeError: decoding with 'gbk' codec failed (TypeError: don't know how to handle UnicodeDecodeError in error callback)", "UnicodeDecodeError: 'gbk' codec can't decode byte 0x81 in position 0: incomplete multibyte sequence", "LookupError: decoding with 'gbk' codec failed (LookupError: unknown error handler name 'nosuch')"])
check('encoding errors and handlers', [err(lambda: '\u20ac'.encode('gb2312')), err(lambda: 'ab\u0100c'.encode('shift_jis')), [('x\u20ac\u0100y').encode('euc_kr', e) for e in ('replace', 'ignore', 'backslashreplace', 'xmlcharrefreplace', 'namereplace')], '\udc81'.encode('gbk', 'surrogateescape'), err(lambda: '\u20ac'.encode('gbk', 'surrogatepass')), '\u3042\u20ac'.encode('iso2022_jp', 'xmlcharrefreplace'), '\u3042\u20ac'.encode('iso2022_jp', 'replace')],
      ["UnicodeEncodeError: 'gb2312' codec can't encode character '\\u20ac' in position 0: illegal multibyte sequence", "UnicodeEncodeError: 'shift_jis' codec can't encode character '\\u0100' in position 2: illegal multibyte sequence", [b'x\xa2\xe6?y', b'x\xa2\xe6y', b'x\xa2\xe6\\u0100y', b'x\xa2\xe6&#256;y', b'x\xa2\xe6\\N{LATIN CAPITAL LETTER A WITH MACRON}y'], b'\x81', "UnicodeEncodeError: 'gbk' codec can't encode character '\\u20ac' in position 0: illegal multibyte sequence", b'\x1b$B$"\x1b(B&#8364;', b'\x1b$B$"\x1b(B?'])

def dots(e):
    return ("." * (e.end - e.start), e.end)
codecs.register_error("dots113", dots)
def mark(e):
    return ("[%d:%d]" % (e.start, e.end), e.end)
codecs.register_error("mark113", mark)
check('handlers registered with register_error', [b'a\x81b\xff\xfe'.decode('big5', 'dots113'), b'\x1b$B\x7f\x7f\x1b(B'.decode('iso2022_jp', 'mark113'), 'a\u20acb'.encode('gbk', 'mark113'), '\u3042\u20ac\u3044'.encode('iso2022_jp', 'mark113')],
      ['a.b..', '[3:5]', b'a[1:2]b', b'\x1b$B$"\x1b(B[1:2]\x1b$B$$\x1b(B'])
check('gb18030: the four-byte ranges', [c.encode('gb18030') for c in '\x80\u00a5\u0452\u2e81\ue5e5\ufffd\U00010000\U0010ffff'] + [b.decode('gb18030') for b in (b'\x81\x30\x81\x30', b'\x84\x31\xa4\x39', b'\x90\x30\x81\x30', b'\xe3\x32\x9a\x35')],
