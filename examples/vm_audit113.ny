def all_pairs(lo=0x81, hi=0xff):
    out = bytearray()
    for a in range(lo, hi):
        for b in range(0x40, 0xff):
            out.append(a)
            out.append(b)
        out.append(0x0a)
    return bytes(out)
PAIRS = all_pairs()
TEXT_RANGE = "".join(chr(c) for c in list(range(0x80, 0xd800, 3)) + list(range(0xe000, 0x10000, 3)) + list(range(0x20000, 0x2b000, 7)))
