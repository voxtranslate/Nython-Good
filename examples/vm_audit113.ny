      '')
check('the lengths case mapping gives', [len(c.upper()) for c in 'ßŉǰΐﬃﬁİ'] + [len(c.lower()) for c in 'İẞ'] + [len(c.casefold()) for c in 'ßẞﬁΐ'],
      [2, 2, 2, 3, 3, 2, 1, 2, 1, 2, 2, 2, 3])
check('istitle with titlecase letters', ['ǅ'.istitle(), 'ǅa'.istitle(), 'ǅA'.istitle(), 'Ǆa'.istitle(), 'aǅ'.istitle(), 'ǅ'.isupper(), 'ǅ'.islower(), 'Ǆ'.isupper()],
      [True, True, False, True, False, False, False, True])
check('predicates of the empty str', [''.isalpha(), ''.isdigit(), ''.isdecimal(), ''.isnumeric(), ''.isspace(), ''.isprintable(), ''.isidentifier(), ''.isupper(), ''.istitle()],
      [False, False, False, False, False, True, False, False, False])

SPACES = "".join(chr(c) for c in range(0x3001) if chr(c).isspace())
BREAKS = "\n\r\x0b\x0c\x1c\x1d\x1e\x85\u2028\u2029"
check('Unicode whitespace', [cps(SPACES), [c for c in range(0x80, 0x3001) if chr(c).isspace()], '\u200b'.isspace(), '\ufeff'.isspace(), '\x1f'.isspace(), '\x1c'.isspace()],
      [[9, 10, 11, 12, 13, 28, 29, 30, 31, 32, 133, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288], [133, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288], False, False, True, True])
check('split() and strip() on Unicode whitespace', [('a' + SPACES + 'b' + SPACES).split(), (SPACES + 'x' + SPACES).strip(), (SPACES + 'x').lstrip(), ('x' + SPACES).rstrip(), 'a\u3000b\u2003c'.split(maxsplit=1), 'a\u3000b\u2003c'.rsplit(maxsplit=1), '\u00a0x\u00a0'.strip(), '\u200bx\u200b'.strip()],
      [['a', 'b'], 'x', 'x', 'x', ['a', 'b\u2003c'], ['a\u3000b', 'c'], 'x', '\u200bx\u200b'])
check('splitlines on every line boundary', [('a' + BREAKS.join('bcdefghijkl')).splitlines(), 'x\r\ny\u2028'.splitlines(True), 'a\x1fb'.splitlines()],
      [['ab', '', '', '', '', '', '', '', '', '', 'c', '', '', '', '', '', '', '', '', '', 'd', '', '', '', '', '', '', '', '', '', 'e', '', '', '', '', '', '', '', '', '', 'f', '', '', '', '', '', '', '', '', '', 'g', '', '', '', '', '', '', '', '', '', 'h', '', '', '', '', '', '', '', '', '', 'i', '', '', '', '', '', '', '', '', '', 'j', '', '', '', '', '', '', '', '', '', 'k', '', '', '', '', '', '', '', '', '', 'l'], ['x\r\n', 'y\u2028'], ['a\x1fb']])
check('int() of Unicode digits', [int('٣٤'), int(' ३ '), int('\u0e51\u0e52'), int('١٢', 16), int('\uff11\uff10'), int('\U0001d7ce\U0001d7cf'), int('\u3000-٥\u2003'), int('٣_٣')],
      [34, 3, 12, 18, 10, 1, -5, 33])
check('float() and complex() of Unicode digits', [float('١.٥'), float(' ٣e٢ '), float('\uff11\uff0e\uff15'.replace('\uff0e', '.')), complex('١+٢j'), complex(' ٣j ')],
      [1.5, 300.0, 1.5, (1+2j), 3j])
check('what they refuse', [err(lambda: int('²')), err(lambda: int('½')), err(lambda: int('٣x')), err(lambda: float('١٫٥')), err(lambda: float('\u0661\u2044')), err(lambda: int(b'\xd9\xa3')), err(lambda: int('\x7f'))],
      ["ValueError: invalid literal for int() with base 10: '²'", "ValueError: invalid literal for int() with base 10: '½'", "ValueError: invalid literal for int() with base 10: '٣x'", "ValueError: could not convert string to float: '١٫٥'", "ValueError: could not convert string to float: '١⁄'", "ValueError: invalid literal for int() with base 10: b'\\xd9\\xa3'", "ValueError: invalid literal for int() with base 10: '\\x7f'"])

from decimal import Decimal
check('Decimal() of Unicode digits', [str(Decimal('١٢.٣')), str(Decimal(' ٣e٢ ')), str(Decimal('\uff11\uff12'))],
      ['12.3', '3E+2', '12'])
check('str.isdecimal vs isdigit vs isnumeric', [[c.isdecimal(), c.isdigit(), c.isnumeric()] for c in '7٣²①Ⅳ½一壹〇𝟘'],
      [[True, True, True], [True, True, True], [False, True, True], [False, True, True], [False, False, True], [False, False, True], [False, False, True], [False, False, True], [False, False, True], [True, True, True]])

# ── PEP 3131: identifiers are NFKC-normalized ─────────────────────────────────
ns3131 = {}
exec("ﬁ = 1\nℌ = 2\ne\u0301 = 3\nµ = 4\nｘ = 5\nｶﾞ = 6\nx\u00b7y = 7\n_\u0662 = 8\nΩmega = 9\n", ns3131)
exec("class C3131:\n    ﬁeld = 10\n    def ℌelp(self, ﬂag=11):\n        return ﬂag\n", ns3131)
exec("def f3131(**kw):\n    return sorted(kw)\nkw3131 = f3131(ﬁ=1, ℌ=2)\n", ns3131)
check('the names bound', sorted(k for k in ns3131 if k not in ('__builtins__', 'C3131', 'f3131', 'kw3131')),
      ['H', '_٢', 'fi', 'x', 'x·y', 'é', 'Ωmega', 'μ', 'ガ'])
check('attributes, parameters, keyword arguments', [ns3131['C3131'].field, ns3131['C3131']().Help(), ns3131['C3131']().Help(flag=12), ns3131['kw3131'], hasattr(ns3131['C3131'], 'ﬁeld')],
      [10, 11, 12, ['H', 'fi'], False])
check('str.isidentifier is not normalized', ['ﬁ'.isidentifier(), 'ℌ'.isidentifier(), '·x'.isidentifier(), 'x·'.isidentifier(), '٣x'.isidentifier(), 'x٣'.isidentifier(), '℘'.isidentifier(), '℮'.isidentifier(), '゛'.isidentifier(), '_'.isidentifier(), '\u2118\u212e'.isidentifier()],
      [True, True, False, True, False, True, True, True, False, True, True])

# ── re: \\w \\d \\s and IGNORECASE as CPython's sre ───────────────────────
import re
def m(p, s, f=0):
    return bool(re.fullmatch(p, s, f))
check('IGNORECASE: ß, ſ, Kelvin, Ω, µ', [m('ß', 'SS', re.I), m('ß', 'ẞ', re.I), m('ẞ', 'ß', re.I), m('s', 'ſ', re.I), m('S', 'ſ', re.I), m('ſ', 's', re.I), m('k', '\u212a', re.I), m('\u212a', 'K', re.I), m('ω', 'Ω', re.I), m('\u2126', 'ω', re.I), m('µ', 'μ', re.I), m('µ', 'Μ', re.I)],
      [False, True, True, True, True, True, True, True, True, True, True, True])
check('IGNORECASE: titlecase, sigma, dotless i, ﬁ', [m('ǅ', 'ǆ', re.I), m('ǅ', 'Ǆ', re.I), m('σ', 'ς', re.I), m('Σ', 'ς', re.I), m('i', 'İ', re.I), m('ı', 'I', re.I), m('ﬁ', 'FI', re.I), m('[a-z]', 'K', re.I), m('[a-z]', '\u212a', re.I), m('[^k]', '\u212a', re.I), m('\u0345', 'ι', re.I), m('\u1fbe', 'Ι', re.I)],
      [True, True, True, True, True, True, False, True, True, False, True, True])
check('IGNORECASE with ASCII', [m('k', '\u212a', re.I | re.A), m('s', 'ſ', re.I | re.A), m('ß', 'ẞ', re.I | re.A)],
      [False, False, False])
check('\\\\w \\\\d \\\\s over the sample', [''.join(c for c in CHARS if re.fullmatch(r'\w', c)) == ''.join(c for c in CHARS if c.isalnum() or c == '_'), ''.join(c for c in CHARS if re.fullmatch(r'\d', c)) == ''.join(c for c in CHARS if c.isdecimal()), ''.join(c for c in CHARS if re.fullmatch(r'\s', c)) == ''.join(c for c in CHARS if c.isspace())],
      [True, True, True])
check('findall over text', [re.findall(r'\w+', 'naïve café ₁₂ ½ x²'), re.findall(r'\d', '١٢३४²'), re.findall(r'\s', 'a\u3000b\u200bc\x1fd'), re.findall(r'\b\w', 'ǅemal ünal'), re.findall(r'(?i)straße', 'STRASSE straße STRAẞE')],
      [['naïve', 'café', '₁₂', '½', 'x²'], ['١', '٢', '३', '४'], ['\u3000', '\x1f'], ['ǅ', 'ü'], ['straße', 'STRAẞE']])
check('case-insensitive backreferences and sub', [bool(re.fullmatch(r'(?i)(\w)\1', 'Ǆǆ')), re.sub(r'(?i)σ', '-', 'ΣσςΣ'), re.sub(r'\W', '_', 'a·b‿c€d')],
      [True, '----', 'a_b_c_d'])

# ── the CJK codecs ───────────────────────────────────────────────────────────
CJK = ['gb2312', 'gbk', 'gb18030', 'hz', 'euc_kr', 'cp949', 'johab', 'big5', 'cp950', 'big5hkscs', 'shift_jis', 'cp932', 'euc_jp', 'shift_jis_2004', 'euc_jis_2004', 'euc_jisx0213', 'shift_jisx0213', 'iso2022_kr', 'iso2022_jp', 'iso2022_jp_1', 'iso2022_jp_2', 'iso2022_jp_2004', 'iso2022_jp_3', 'iso2022_jp_ext']
TEXTS = {'zh': '中文汉字简体：你好，世界！电脑。¥€', 'tw': '繁體中文：臺灣，電腦。', 'ja': '日本語のテキスト：ひらがな、カタカナ、漢字。ｶﾀｶﾅ～＼', 'ko': '한국어 텍스트: 안녕하세요, 세계! 漢字 똠', 'mix': 'Latin é ü ß — “quotes” ①②③ ×÷ αβγ АБВ ¥ ‾ ~\\'}
check('lookup names and aliases', [codecs.lookup(n).name for n in ['GBK', 'cp936', 'ms936', 'euc-cn', 'gb18030-2000', 'Big5', 'big5-tw', 'cp950', 'ms950', 'big5-hkscs', 'hkscs', 'sjis', 'shift-jis', 'ms932', 'mskanji', 'eucjp', 'ujis', 'euc-jisx0213', 'shift_jis_2004', 'csiso2022jp', 'iso-2022-jp-2', 'iso2022jp_ext', 'ISO-2022-KR', 'euc-kr', 'ks_c-5601-1987', 'uhc', 'cp1361', 'hz-gb-2312', 'hzgb']],
      ['gbk', 'gbk', 'gbk', 'gb2312', 'gb18030', 'big5', 'big5', 'cp950', 'cp950', 'big5hkscs', 'big5hkscs', 'shift_jis', 'shift_jis', 'cp932', 'cp932', 'euc_jp', 'euc_jp', 'euc_jisx0213', 'shift_jis_2004', 'iso2022_jp', 'iso2022_jp_2', 'iso2022_jp_ext', 'iso2022_kr', 'euc_kr', 'euc_kr', 'cp949', 'johab', 'hz', 'hz'])
check('gb2312: zh text encoded', TEXTS['zh'].encode('gb2312', 'backslashreplace'),
      b'\xd6\xd0\xce\xc4\xba\xba\xd7\xd6\xbc\xf2\xcc\xe5\xa3\xba\xc4\xe3\xba\xc3\xa3\xac\xca\xc0\xbd\xe7\xa3\xa1\xb5\xe7\xc4\xd4\xa1\xa3\\xa5\\u20ac')
check('gb2312: tw text encoded', TEXTS['tw'].encode('gb2312', 'backslashreplace'),
