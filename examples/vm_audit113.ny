      ['KeyError: "undefined character name \'cjk unified ideograph-4e00\'"', 'KeyError: "undefined character name \'hangul syllable ga\'"', 'KeyError: "undefined character name \'CJK UNIFIED IDEOGRAPH-4e00\'"', 'KeyError: "undefined character name \'HANGUL SYLLABLE GAX\'"', 'KeyError: "undefined character name \'NO SUCH NAME\'"', "KeyError: 'name too long'", "TypeError: a bytes-like object is required, not 'int'"])
check('\\\\N{} with aliases (not named sequences)', [ascii('\N{LATIN CAPITAL LETTER GHA}'), ascii('\N{BOM}'), ascii('\N{nbsp}'), ascii('\N{EM DASH}')],
      ["'\\u01a2'", "'\\ufeff'", "'\\xa0'", "'\\u2014'"])
check('named sequences are refused in \\\\N{}', err(lambda: eval(chr(34) + chr(92) + 'N{KEYCAP NUMBER SIGN}' + chr(34)))[:11],
      'SyntaxError')

