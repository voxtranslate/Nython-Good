def iso_body(esc):
    out = bytearray(esc)
    for a in range(0x21, 0x7f):
        for b in range(0x21, 0x7f):
            out.append(a)
            out.append(b)
        out.append(0x0a)
        out += esc
    return bytes(out)
check("iso2022_jp: the set after '\\\\x1b$B' decoded (digested)", md5(iso_body(b'\x1b$B').decode('iso2022_jp', 'backslashreplace')),
      '417f3790b3a3e8b42191ccc8453411bb')
