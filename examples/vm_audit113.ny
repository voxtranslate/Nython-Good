# ── utf-7 ────────────────────────────────────────────────────────────────────
UTF7_TEXTS = ["Hi Mom -\u263a-!", "A\u2262\u0391.", "\U0001f600", "+", "~\\", "a-b", "\ud800", "x\u00e9y", "1 + 1 = 2",
              "\u65e5\u672c\u8a9e", "a\tb\nc", "!\"#$%&*;<=>@[]^_`{|}"]
UTF7_BYTES = [b"+\x80", b"\x80", b"+AGE", b"+AGE-", b"+AGEx", b"a+", b"+2D3cAA-", b"+2D3cAA", b"+-", b"+AGEA", b"+AGEAAQ-",
              b"+ZeVnLIqe-", b"+AAA", b"+2D3c-", b"+2D3cAEE-"]
check('utf-7 encode', [s.encode('utf-7') for s in UTF7_TEXTS],
      [b'Hi Mom -+Jjo--!', b'A+ImIDkQ.', b'+2D3eAA-', b'+-', b'+AH4AXA-', b'a-b', b'+2AA-', b'x+AOk-y', b'1 +- 1 = 2', b'+ZeVnLIqe-', b'a\tb\nc', b'!"#$%&*;<=>@[]^_`{|}'])
check('utf-7 decode of what it encodes', [s.encode('utf-7').decode('utf-7') == s for s in UTF7_TEXTS],
      [True, True, True, True, True, True, True, True, True, True, True, True])
check('utf-7 decode, strict', [err(lambda: b.decode('utf-7', 'strict')) if 'strict' in ('strict', 'surrogateescape') else b.decode('utf-7', 'strict') for b in UTF7_BYTES],
      ["UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-1: ill-formed sequence", "UnicodeDecodeError: 'utf7' codec can't decode byte 0x80 in position 0: unexpected special character", 'no error', 'no error', "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-4: unterminated shift sequence", 'no error', 'no error', 'no error', 'no error', "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-4: unterminated shift sequence", 'no error', 'no error', 'no error', "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-5: partial character in shift sequence", "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-8: partial character in shift sequence"])
check('utf-7 decode, replace', [err(lambda: b.decode('utf-7', 'replace')) if 'replace' in ('strict', 'surrogateescape') else b.decode('utf-7', 'replace') for b in UTF7_BYTES],
      ['�', '�', 'a', 'a', 'a�', 'a', '🐀', '🐀', '+', 'a�', 'a\x01', '日本語', '\x00', '�', '🐀�'])
check('utf-7 decode, ignore', [err(lambda: b.decode('utf-7', 'ignore')) if 'ignore' in ('strict', 'surrogateescape') else b.decode('utf-7', 'ignore') for b in UTF7_BYTES],
      ['', '', 'a', 'a', 'a', 'a', '🐀', '🐀', '+', 'a', 'a\x01', '日本語', '\x00', '', '🐀'])
check('utf-7 decode, backslashreplace', [err(lambda: b.decode('utf-7', 'backslashreplace')) if 'backslashreplace' in ('strict', 'surrogateescape') else b.decode('utf-7', 'backslashreplace') for b in UTF7_BYTES],
      ['\\x2b\\x80', '\\x80', 'a', 'a', 'a\\x2b\\x41\\x47\\x45\\x78', 'a', '🐀', '🐀', '+', 'a\\x2b\\x41\\x47\\x45\\x41', 'a\x01', '日本語', '\x00', '\\x2b\\x32\\x44\\x33\\x63\\x2d', '🐀\\x2b\\x32\\x44\\x33\\x63\\x41\\x45\\x45\\x2d'])
check('utf-7 decode, surrogateescape', [err(lambda: b.decode('utf-7', 'surrogateescape')) if 'surrogateescape' in ('strict', 'surrogateescape') else b.decode('utf-7', 'surrogateescape') for b in UTF7_BYTES],
      ["UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-1: ill-formed sequence", 'no error', 'no error', 'no error', "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-4: unterminated shift sequence", 'no error', 'no error', 'no error', 'no error', "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-4: unterminated shift sequence", 'no error', 'no error', 'no error', "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-5: partial character in shift sequence", "UnicodeDecodeError: 'utf7' codec can't decode bytes in position 0-8: partial character in shift sequence"])
check('utf-7 incremental', [codecs.utf_7_decode(b'a+AGE', 'strict', False), codecs.utf_7_decode(b'a+AGEA', 'strict', False), codecs.utf_7_decode(b'+ZeVnLIqe', 'strict', False), codecs.utf_7_encode('\u00e9'), codecs.lookup('utf7').name, codecs.lookup('u7').name, codecs.lookup('unicode-1-1-utf-7').name, inc_decode('utf-7', b'+ZeVnLIqe-x+AGE-', 1)],
      [('a', 1), ('a', 1), ('', 0), (b'+AOk-', 1), 'utf-7', 'utf-7', 'utf-7', '日本語xa'])

