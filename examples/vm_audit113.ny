      ['σασ σασ', 'ὀδυσσεύσ', 'i̇stanbul', 'ǆemal ǉubav ǌego', 'ǆungla ǉ ǌ', 'fffiflffifflstst', 'ʼn ΐ ǰ ẖ ẗ ẘ ẙ aʾ', 'մնմեմիվնմխ', 'ss ss strasse', 'ᎠᏯ Ꭰ', 'ა ბ ა', '𐐨𐐨 𐓘𐓘', 'αι αι ηι ηι ωι ωι ἀι ἀι', 'ⅷ ⅷ ⓐ ⓐ', 'μ s ı k å ω', 'hello world', 'x1y 2z', "they're bill's friends", 'ⅰⅱ ᵃ ª º', 'ǳ ǳ ǳ', 'fish and flour', 'ι ι', "ασ'", "α'σ", 'ασα', 'σ.', 'ασ.α', 'ἀσ', 'σ', 'ασ́', 'ασ́α', 'ʼσ', 'ἀσ', '𞤢𞤢'])
