      [b'\xa4\xf7\xab\xc4\xab\xe5', b'\x82\xf5\x86c\x86\x85', b'\x1b$(Q$w+D+e\x1b(B', b'?\xcf\xd4', b'\x8f\xfd\xbb?', b'\x1b$(P};\x1b(B?'])
check('iso2022_jp_2: the designations it switches between', (lambda b: [b, b.decode('iso2022_jp_2')])('日本 한국 中文 Ωé'.encode('iso2022_jp_2')),
      [b'\x1b$BF|K\\\x1b(B \x1b$(CGQ19\x1b(B \x1b$BCfJ8\x1b(B \x1b$B&8\x1b$(D+1\x1b(B', '日本 한국 中文 Ωé'])

def inc_encode(name, text, step):
    e = codecs.getincrementalencoder(name)()
    out = [e.encode(text[k:k + step]) for k in range(0, len(text), step)]
    out.append(e.encode("", True))
    return b"".join(out)
def inc_decode(name, data, step):
    d = codecs.getincrementaldecoder(name)()
    out = [d.decode(data[k:k + step]) for k in range(0, len(data), step)]
    out.append(d.decode(b"", True))
    return "".join(out)
