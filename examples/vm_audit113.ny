      '')
check('str.isalnum of every sampled character', ''.join('1' if c.isalnum() else '0' for c in CHARS),
      '')
check('str.isspace of every sampled character', ''.join('1' if c.isspace() else '0' for c in CHARS),
      '')
check('str.isprintable of every sampled character', ''.join('1' if c.isprintable() else '0' for c in CHARS),
      '')
check('str.isidentifier of every sampled character', ''.join('1' if c.isidentifier() else '0' for c in CHARS),
      '')
check('str.isupper of every sampled character', ''.join('1' if c.isupper() else '0' for c in CHARS),
      '')
check('str.islower of every sampled character', ''.join('1' if c.islower() else '0' for c in CHARS),
      '')
