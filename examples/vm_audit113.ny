check('str.swapcase of tricky strings', [s.swapcase() for s in TRICKY],
      ['σας σας', 'ὀδυσσεύς', 'i̇STANBUL', 'ǅEMAL ǈUBAV ǋEGO', 'ǄUNGLA Ǉ Ǌ', 'FFFIFLFFIFFLSTST', 'ʼN Ϊ́ J̌ H̱ T̈ W̊ Y̊ Aʾ', 'ՄՆՄԵՄԻՎՆՄԽ', 'SS ß sTRASSE', 'ᎠᏯ ꭰ', 'Ა Ბ ა', '𐐀𐐨 𐒰𐓘', 'ΑΙ ᾼ ΗΙ ῌ ΩΙ ῼ ᾈ ἈΙ', 'ⅷ Ⅷ Ⓐ ⓐ', 'Μ S I k å ω', 'HELLO WORLD', 'X1Y 2Z', "THEY'RE BILL'S FRIENDS", 'ⅠⅡ ᵃ ª º', 'ǳ ǲ Ǳ', 'FISH AND FLOUR', 'Ι Ι', "ας'", "α'ς", 'ασα', 'σ.', 'ασ.α', 'ἀς', 'σ', 'ας́', 'ασ́α', 'ʼσ', 'ἀς', '𞤢𞤀'])
check('str.isupper of tricky strings', [s.isupper() for s in TRICKY],
      [True, True, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, True, True, True, True, True, True, True, True, True, True, True, False])
