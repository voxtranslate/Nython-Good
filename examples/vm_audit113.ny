      ['d', None, 0.5, 'none', 'ValueError: not a decimal', 'ValueError: not a digit', 'ValueError: not a numeric character', 'ValueError: no such name'])
check('argument errors', [err(lambda: unicodedata.category('ab')), err(lambda: unicodedata.category(5)), err(lambda: unicodedata.name('')), err(lambda: unicodedata.mirrored(b'a')), err(lambda: unicodedata.normalize('NFX', 'a')), err(lambda: unicodedata.normalize('NFC', 5)), err(lambda: unicodedata.is_normalized('X', 'a')), unicodedata.is_normalized('X', ''), unicodedata.normalize('X', '')],
      ['TypeError: category() argument must be a unicode character, not str', 'TypeError: category() argument must be a unicode character, not int', 'TypeError: name() argument 1 must be a unicode character, not str', 'TypeError: mirrored() argument must be a unicode character, not bytes', 'ValueError: invalid normalization form', 'TypeError: normalize() argument 2 must be str, not int', 'ValueError: invalid normalization form', True, ''])
