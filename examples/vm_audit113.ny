check('lookup: names, aliases, named sequences', [unicodedata.lookup(n) for n in ['LATIN SMALL LETTER A', 'latin small letter a', 'LATIN CAPITAL LETTER GHA', 'BOM', 'nbsp', 'LINE FEED', 'lf', 'BYTE ORDER MARK', 'KEYCAP NUMBER SIGN', 'LATIN CAPITAL LETTER A WITH MACRON AND GRAVE', 'HANGUL SYLLABLE GAG', 'CJK UNIFIED IDEOGRAPH-4E00', 'CJK UNIFIED IDEOGRAPH-20000', 'cjk compatibility ideograph-f900', 'TANGUT COMPONENT-001', 'nushu character-1b170', 'SNOWMAN', 'EM DASH']],
      ['a', 'a', 'Ƣ', '\ufeff', '\xa0', '\n', '\n', '\ufeff', '#️⃣', 'Ā̀', '각', '一', '𠀀', '豈', '𘠀', '𛅰', '☃', '—'])
