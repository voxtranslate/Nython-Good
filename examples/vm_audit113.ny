def conformance(lines):
    bad = []
    for k in range(len(lines)):
        c = [unhex(t) for t in lines[k].split(";")]
        n = unicodedata.normalize
        ok = (c[1] == n("NFC", c[0]) == n("NFC", c[1]) == n("NFC", c[2]) and c[3] == n("NFC", c[3]) == n("NFC", c[4])
              and c[2] == n("NFD", c[0]) == n("NFD", c[1]) == n("NFD", c[2]) and c[4] == n("NFD", c[3]) == n("NFD", c[4])
              and c[3] == n("NFKC", c[0]) == n("NFKC", c[1]) == n("NFKC", c[2]) == n("NFKC", c[3]) == n("NFKC", c[4])
              and c[4] == n("NFKD", c[0]) == n("NFKD", c[1]) == n("NFKD", c[2]) == n("NFKD", c[3]) == n("NFKD", c[4])
              and unicodedata.is_normalized("NFC", c[1]) and unicodedata.is_normalized("NFD", c[2])
              and unicodedata.is_normalized("NFKC", c[3]) and unicodedata.is_normalized("NFKD", c[4]))
        if not ok:
            bad.append(lines[k])
    return bad
check('NormalizationTest part 0 (25 lines): the lines that fail', conformance(NORMTEST[0]),
      [])
check('NormalizationTest part 1 (1413 lines): the lines that fail', conformance(NORMTEST[1]),
      [])
check('NormalizationTest part 2 (456 lines): the lines that fail', conformance(NORMTEST[2]),
      [])
check('NormalizationTest part 3 (176 lines): the lines that fail', conformance(NORMTEST[3]),
      [])
check('characters outside part 1 normalize to themselves (every 97th)', [c for c in range(0, 0x110000, 97) if not 0xd800 <= c < 0xe000 and unicodedata.decomposition(chr(c)) == '' and not 0xac00 <= c <= 0xd7a3 and any(unicodedata.normalize(f, chr(c)) != chr(c) for f in ('NFC', 'NFD', 'NFKC', 'NFKD'))],
      [])
check('ucd_3_2_0: properties', [unicodedata.ucd_3_2_0.category(c) for c in '\u0221\u0234A\u20ac\u0e33\u1d00\u2183'] + [unicodedata.ucd_3_2_0.bidirectional(c) for c in '\u0221\u200e\u0600'] + [unicodedata.ucd_3_2_0.east_asian_width(c) for c in '\u0221A\u3000'] + [unicodedata.ucd_3_2_0.mirrored(c) for c in '\u0221(\u2201'],
      ['Cn', 'Cn', 'Lu', 'Sc', 'Lo', 'Cn', 'Nl', '', 'L', '', 'F', 'Na', 'F', 0, 1, 1])
check('ucd_3_2_0: values and names', [unicodedata.ucd_3_2_0.decimal('\u0221', None), unicodedata.ucd_3_2_0.numeric('\u0221', None), unicodedata.ucd_3_2_0.decimal('7'), unicodedata.ucd_3_2_0.name('\u0221', 'none'), unicodedata.ucd_3_2_0.name('A'), err(lambda: unicodedata.ucd_3_2_0.lookup('LATIN SMALL LETTER D WITH CURL')), err(lambda: unicodedata.ucd_3_2_0.lookup('BOM')), unicodedata.ucd_3_2_0.decomposition('\u0221'), unicodedata.ucd_3_2_0.combining('\u0301')],
      [None, None, 7, 'none', 'LATIN CAPITAL LETTER A', 'KeyError: "undefined character name \'LATIN SMALL LETTER D WITH CURL\'"', 'KeyError: "undefined character name \'BOM\'"', '', 230])
check('ucd_3_2_0: the corrected decompositions', [cps(unicodedata.ucd_3_2_0.normalize('NFC', chr(c))) for c in (0x2f868, 0x2f874, 0x2f91f, 0x2f95f, 0x2f9bf)] + [cps(unicodedata.normalize('NFC', chr(c))) for c in (0x2f868, 0x2f874, 0x2f91f, 0x2f95f, 0x2f9bf)],
      [[136042], [24371], [17323], [31406], [19799], [14076], [24403], [148395], [31470], [17879]])
check('ucd_3_2_0 over the sample (digested)', [md5('|'.join(getattr(unicodedata.ucd_3_2_0, f)(c) for c in CHARS)) for f in ('category', 'bidirectional', 'east_asian_width', 'decomposition')],
      ['2a941594f23935a4ebf37e40cbc6a47e', 'fdd89c6e6ff5fab56a7b0d7bd893cf72', '9d2233cef7599bdc74a6e9583fa9107c', '5b452f0450ac0970c31885f8f4d17020'])
check('ucd_3_2_0 normalize over the sample (digested)', md5(''.join(unicodedata.ucd_3_2_0.normalize('NFKC', c) for c in CHARS if not 0xd800 <= ord(c) < 0xe000)),
      '437a74937789b4152a69e5e1d1e91a99')
check('UCD objects', [type(unicodedata.ucd_3_2_0).__name__, err(lambda: type(unicodedata.ucd_3_2_0)()), unicodedata.ucd_3_2_0.unidata_version],
      ['UCD', "TypeError: cannot create 'unicodedata.UCD' instances", '3.2.0'])

