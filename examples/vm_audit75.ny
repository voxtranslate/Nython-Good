# vm_audit75.ny - Python's string, textwrap, pprint, csv, statistics,
# fractions, struct, calendar and uuid modules (lib/*.ny), both engines.
#
# Written in the subset Nython and Python share, so the same file runs
# under python3 with the real standard library - every expected value
# below is what CPython computes (3.11 is the oldest checked; where 3.12
# added something, the check accepts 3.11's refusal in its place).
#
#   string      constants, capwords, Template (substitute/safe_substitute,
#               $$, ${}, errors, get_identifiers, is_valid), Formatter
#   textwrap    wrap/fill at many widths over varied paragraphs, every
#               TextWrapper option, shorten, dedent, indent
#   pprint      pformat/pprint/pp layouts (nesting, width, depth, compact,
#               sort_dicts, underscore_numbers, long strings and bytes
#               split), saferepr/isreadable/isrecursive, recursion markers
#   csv         reader/writer/DictReader/DictWriter, quoting modes,
#               dialects, escapes, embedded newlines, Sniffer, real files
#   statistics  averages, spreads, quantiles, correlation/regression,
#               NormalDist, StatisticsError - CPython's exact results
#   fractions   construction, arithmetic, comparisons, hashing, rounding,
#               limit_denominator, formatting
#   struct      pack/unpack/calcsize/iter_unpack/pack_into/unpack_from,
#               byte orders, alignment, every format code, floats, errors
#   calendar    leap years, weekdays, month ranges, TextCalendar layout,
#               timegm, Calendar iterators, names
#   uuid        parsing, fields, uuid3/uuid5 against CPython's, uuid4
#   engine      fixes this needed: x += y without __iadd__ (and 10 += obj),
#               divmod() through __divmod__/__rdivmod__, math.floor/ceil/
#               trunc of objects, sorted() of ints and objects, int / int
#               and float(int) correctly rounded, math.sumprod correctly
#               rounded, subnormal and huge float literals, `from math
#               import`, `except struct.error`, adjacent string literals,
#               Python's precedence for & | ^, str.format calling
#               __format__, complex deferring to the other operand,
#               sys.byteorder, "integer modulo by zero"
#
# Must pass on both engines (and python3):
#     ./build/nython-cli examples/vm_audit75.ny
#     ./build/nython-cli --vm examples/vm_audit75.ny
try:
    true
except NameError:
    true = True
    false = False
    none = None

import os
import math

pass_n = 0
fail_n = 0
results = []

def check(name, got, want):
    results.append([name, repr(got) == repr(want), got, want])

def dl(s):
    # a dollar and a brace in a literal are Nython's string interpolation:
    # the tests spell them @{
    return s.replace('@{', '$' + '{')

def err(f):
    try:
        f()
        return "no error"
    except Exception as e:
        return type(e).__name__ + ": " + str(e)

def errtype(f):
    try:
        f()
        return "no error"
    except Exception as e:
        return type(e).__name__

# ── string ────────────────────────────────────────────────────────────────────
import string
from string import Template, Formatter
class PctTemplate(Template):
    delimiter = '%'
class Obj:
    def __init__(self):
        self.name = 'obj'
        self.items = [10, 20, {'k': 'v'}]
class LoudFormatter(Formatter):
    def convert_field(self, value, conversion):
        if conversion == 'u':
            return str(value).upper()
        return Formatter.convert_field(self, value, conversion)
class DefaultFormatter(Formatter):
    def get_value(self, key, args, kwargs):
        if isinstance(key, str) and key not in kwargs:
            return '<' + key + '>'
        return Formatter.get_value(self, key, args, kwargs)
class StrictFormatter(Formatter):
    def check_unused_args(self, used_args, args, kwargs):
        for k in kwargs:
            if k not in used_args:
                raise ValueError('unused ' + k)
check('string const 0', (string.ascii_letters), 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ')
check('string const 1', (string.ascii_lowercase), 'abcdefghijklmnopqrstuvwxyz')
check('string const 2', (string.ascii_uppercase), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ')
check('string const 3', (string.digits), '0123456789')
check('string const 4', (string.hexdigits), '0123456789abcdefABCDEF')
check('string const 5', (string.octdigits), '01234567')
check('string const 6', (string.punctuation), '!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~')
check('string const 7', (string.printable), '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~ \t\n\r\x0b\x0c')
check('string const 8', (string.whitespace), ' \t\n\r\x0b\x0c')
check('string const 9', (len(string.printable)), 100)
check('string const 10', (string.capwords('hello   world  foo')), 'Hello World Foo')
check('string const 11', (string.capwords(' the qUICK bROWN fox ')), 'The Quick Brown Fox')
check('string const 12', (string.capwords('a-b-c d', '-')), 'A-B-C d')
check('string const 13', (string.capwords('x,,y', ',')), 'X,,Y')
check('string const 14', (string.capwords('')), '')
check('string template 0', (Template('$who likes $what').substitute(who='tim', what='kung pao')), 'tim likes kung pao')
check('string template 1', (Template(dl('@{noun}ification and $$5 for $x')).substitute({'noun': 'nat', 'x': 1})), 'natification and $5 for 1')
check('string template 2', (Template('$a $b').substitute({'a': 1, 'b': 2}, b=3)), '1 3')
check('string template 3', (Template('$a$b').substitute(a=[1], b=2.5)), '[1]2.5')
check('string template 4', (Template('end $').safe_substitute()), 'end $')
check('string template 5', (Template('$a and $b').safe_substitute(a='A')), 'A and $b')
check('string template 6', (Template(dl('@{a} @{b} @{ c}')).safe_substitute(a=1)), dl('1 @{b} @{ c}'))
check('string template 7', (Template('$1 $_x $x1 $X').safe_substitute(_x='u', x1='n', X='up')), '$1 u n up')
check('string template 8', (Template('$$ $$$x').substitute(x='!')), '$ $!')
check('string template 9', (err(lambda: Template('$who').substitute())), "KeyError: 'who'")
check('string template 10', (err(lambda: Template('x\ny $ z').substitute())), 'ValueError: Invalid placeholder in string: line 2, col 3')
check('string template 11', (err(lambda: Template(dl('ab\ncd\nef @{bad')).substitute())), 'ValueError: Invalid placeholder in string: line 3, col 4')
check('string template 12', (err(lambda: Template('$').substitute())), 'ValueError: Invalid placeholder in string: line 1, col 1')
check('string template 13', (err(lambda: Template('a$1').substitute())), 'ValueError: Invalid placeholder in string: line 1, col 2')
check('string template 14', (err(lambda: Template(dl('@{}')).substitute())), 'ValueError: Invalid placeholder in string: line 1, col 1')
check('string template 15', (Template(dl('$a @{b} $a $$ $c')).get_identifiers()), ['a', 'b', 'c'])
check('string template 16', (Template(dl('$a $')).is_valid()), False)
check('string template 17', (Template(dl('$a @{b} $$')).is_valid()), True)
check('string template 18', (Template(dl('@{a')).get_identifiers()), [])
check('string template 19', (PctTemplate('%who says %%hi to %{whom}').substitute(who='a', whom='b')), 'a says %hi to b')
check('string template 20', (PctTemplate('$x %x').substitute(x=1)), '$x 1')
check('string template 21', (Template('$naïve $ok').safe_substitute(ok=1)), '$naïve 1')
check('string template 22', (Template('caf\u00e9 $x').substitute(x='\u00e8')), 'café è')
check('string template 23', (Template('$x').template), '$x')
check('string formatter 0', (Formatter().format('{0}-{1}-{0}', 'a', 'b')), 'a-b-a')
check('string formatter 1', (Formatter().format('{} {}', 1, 2)), '1 2')
check('string formatter 2', (Formatter().format('{name}: {0:>5}', 42, name='n')), 'n:    42')
check('string formatter 3', (Formatter().format('{0:{1}}', 'x', '>4')), '   x')
check('string formatter 4', (Formatter().format('{0:{fill}{align}{width}}', 'y', fill='*', align='^', width=7)), '***y***')
check('string formatter 5', (Formatter().format('{0!r} {0!s} {0!a}', 'h\u00e9')), "'hé' hé 'h\\xe9'")
check('string formatter 6', (Formatter().format('{{}} {{{0}}}', 5)), '{} {5}')
check('string formatter 7', (Formatter().format('{0.name} {0.items[1]} {0.items[2][k]}', Obj())), 'obj 20 v')
check('string formatter 8', (Formatter().format('{a[0]}{a[1]}', a='xy')), 'xy')
check('string formatter 9', (Formatter().format('{:,}', 1234567)), '1,234,567')
check('string formatter 10', (Formatter().format('{:.3f}|{:x}|{:08.2e}', 3.14159, 255, 12345.678)), '3.142|ff|1.23e+04')
check('string formatter 11', (Formatter().vformat('{x} {y}', (), {'x': 1, 'y': 2})), '1 2')
check('string formatter 12', (list(Formatter().parse('a{0!r:>5}b{{c}}d{}'))), [('a', '0', '>5', 'r'), ('b{', None, None, None), ('c}', None, None, None), ('d', '', '', None)])
check('string formatter 13', (list(Formatter().parse(''))), [])
check('string formatter 14', (list(Formatter().parse('{0:{1}}x'))), [('', '0', '{1}', None), ('x', None, None, None)])
check('string formatter 15', (list(Formatter().parse('a{{b'))), [('a{', None, None, None), ('b', None, None, None)])
check('string formatter 16', (list(Formatter().parse('}}'))), [('}', None, None, None)])
check('string formatter 17', (list(Formatter().parse('{a.b[c]!s}'))), [('', 'a.b[c]', '', 's')])
check('string formatter 18', (list(Formatter().parse('{:}'))), [('', '', '', None)])
check('string formatter 19', (Formatter().get_field('0.name', [Obj()], {})[1]), 0)
check('string formatter 20', (Formatter().get_field('x[1]', [], {'x': [5, 6]})), (6, 'x'))
check('string formatter 21', (Formatter().convert_field(5, 'r')), '5')
check('string formatter 22', (Formatter().format_field(3.5, '06.2f')), '003.50')
check('string formatter 23', (LoudFormatter().format('{0!u} {0}', 'hey')), 'HEY hey')
check('string formatter 24', (DefaultFormatter().format('{a} {b}', a=1)), '1 <b>')
check('string formatter 25', (err(lambda: StrictFormatter().format('{a}', a=1, b=2))), 'ValueError: unused b')
check('string formatter 26', (err(lambda: Formatter().format('{0} {}', 1, 2))), 'ValueError: cannot switch from manual field specification to automatic field numbering')
check('string formatter 27', (err(lambda: Formatter().format('{} {0}', 1, 2))), 'ValueError: cannot switch from manual field specification to automatic field numbering')
check('string formatter 28', (err(lambda: Formatter().format('{', 1))), "ValueError: Single '{' encountered in format string")
check('string formatter 29', (err(lambda: Formatter().format('}', 1))), "ValueError: Single '}' encountered in format string")
check('string formatter 30', (err(lambda: Formatter().format('{0!x}', 1))), 'ValueError: Unknown conversion specifier x')
check('string formatter 31', (err(lambda: Formatter().format('{0!rr}', 1))), "ValueError: expected ':' after conversion specifier")
check('string formatter 32', (err(lambda: Formatter().format('{0[}', 1))), "ValueError: expected '}' before end of string")
check('string formatter 33', (err(lambda: Formatter().format('{0:{1:{2:{3}}}}', 1, 2, 3, 4))), 'ValueError: Max string recursion exceeded')
check('string formatter 34', (err(lambda: Formatter().format('{0.}', 1))), 'ValueError: Empty attribute in format string')
check('string formatter 35', (err(lambda: Formatter().format('{x}', 1))), "KeyError: 'x'")
check('string formatter 36', (err(lambda: Formatter().format('{0!', 1))), 'ValueError: end of string while looking for conversion specifier')
check('string formatter 37', (err(lambda: Formatter().format('{0', 1))), "ValueError: expected '}' before end of string")
check('string formatter 38', (err(lambda: Formatter().format('{0:x', 1))), "ValueError: unmatched '{' in format spec")
check('string formatter 39', (err(lambda: list(Formatter().parse('a{b{c}')))), "ValueError: unexpected '{' in field name")
check('string formatter 40', (err(lambda: Formatter().format('{0]}', [1]))), "KeyError: '0]'")

# ── textwrap ──────────────────────────────────────────────────────────────────
import textwrap
TW_PARAS = ['The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs!  How vexingly quick daft zebras jump?', 'Look, goof-ball -- use the -b option! A well-known self-contained e-mail re-write of state-of-the-art X-ray non--hyphen ab-cd-ef-gh a-b-c 1-2-3 x--y -- --flag foo--', 'Supercalifragilisticexpialidocious and pneumonoultramicroscopicsilicovolcanoconiosis are long. So is http://example.com/a/very/long/path/that-has-hyphens-in-it/and_more?query=1.', 'Tabs\there\tand\tthere, newlines\nand\r\nreturns, form\x0cfeeds and\x0bvertical tabs.\nEnd of sentence. Next one! Is this? Yes. "Quoted." \'Single.\' Mr. Smith e.g. this.', '  Leading spaces, trailing spaces   and   runs   of   spaces.   ', 'unicode: naïve café résumé coöperate über-cool straße -- été-année_one under_score_words 3-in-1 ---triple--- a--b']
def tw_all(opts, widths):
    out = []
    for p in TW_PARAS:
        for w in widths:
            try:
                out.append(textwrap.wrap(p, w, **opts))
            except ValueError as e:
                out.append("ValueError: " + str(e))
    return out
check('textwrap opts 0', (tw_all(dict(), [1, 3, 6, 10, 15, 22, 31, 45, 70])), [['T', 'h', 'e', 'q', 'u', 'i', 'c', 'k', 'b', 'r', 'o', 'w', 'n', 'f', 'o', 'x', 'j', 'u', 'm', 'p', 's', 'o', 'v', 'e', 'r', 't', 'h', 'e', 'l', 'a', 'z', 'y', 'd', 'o', 'g', '.', 'P', 'a', 'c', 'k', 'm', 'y', 'b', 'o', 'x', 'w', 'i', 't', 'h', 'f', 'i', 'v', 'e', 'd', 'o', 'z', 'e', 'n', 'l', 'i', 'q', 'u', 'o', 'r', 'j', 'u', 'g', 's', '!', 'H', 'o', 'w', 'v', 'e', 'x', 'i', 'n', 'g', 'l', 'y', 'q', 'u', 'i', 'c', 'k', 'd', 'a', 'f', 't', 'z', 'e', 'b', 'r', 'a', 's', 'j', 'u', 'm', 'p', '?'], ['The', 'qui', 'ck ', 'bro', 'wn', 'fox', 'jum', 'ps ', 'ove', 'r', 'the', 'laz', 'y d', 'og.', 'Pac', 'k', 'my', 'box', 'wit', 'h f', 'ive', 'doz', 'en ', 'liq', 'uor', 'jug', 's!', 'How', 'vex', 'ing', 'ly ', 'qui', 'ck ', 'daf', 't z', 'ebr', 'as ', 'jum', 'p?'], ['The', 'quick', 'brown', 'fox', 'jumps', 'over', 'the', 'lazy', 'dog.', 'Pack', 'my box', 'with', 'five', 'dozen', 'liquor', 'jugs!', 'How ve', 'xingly', 'quick', 'daft', 'zebras', 'jump?'], ['The quick', 'brown fox', 'jumps over', 'the lazy', 'dog. Pack', 'my box', 'with five', 'dozen', 'liquor', 'jugs!  How', 'vexingly', 'quick daft', 'zebras', 'jump?'], ['The quick brown', 'fox jumps over', 'the lazy dog.', 'Pack my box', 'with five dozen', 'liquor jugs!', 'How vexingly', 'quick daft', 'zebras jump?'], ['The quick brown fox', 'jumps over the lazy', 'dog. Pack my box with', 'five dozen liquor', 'jugs!  How vexingly', 'quick daft zebras', 'jump?'], ['The quick brown fox jumps over', 'the lazy dog. Pack my box with', 'five dozen liquor jugs!  How', 'vexingly quick daft zebras', 'jump?'], ['The quick brown fox jumps over the lazy dog.', 'Pack my box with five dozen liquor jugs!  How', 'vexingly quick daft zebras jump?'], ['The quick brown fox jumps over the lazy dog. Pack my box with five', 'dozen liquor jugs!  How vexingly quick daft zebras jump?'], ['L', 'o', 'o', 'k', ',', 'g', 'o', 'o', 'f', '-', 'b', 'a', 'l', 'l', '-', '-', 'u',