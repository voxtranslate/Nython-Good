check('textwrap misc 8', (textwrap.wrap('Supercalifragilistic expialidocious', 10, max_lines=2)), ['Supercalif', '[...]'])
check('textwrap misc 9', (textwrap.wrap('aaaa bbbb cccc', 9, max_lines=2, placeholder=' [...]')), ['aaaa bbbb', 'cccc'])
check('textwrap misc 10', (textwrap.wrap('aa bb cc dd ee ff', 5, max_lines=3, drop_whitespace=False)), ['aa bb', ' cc ', '[...]'])
