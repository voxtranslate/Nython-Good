check('textwrap misc 14', (textwrap.wrap('a-b-c-d-e-f-g-h-i-j-k', 5)), ['a-b-', 'c-d-', 'e-f-', 'g-h-', 'i-j-k'])
check('textwrap misc 15', (textwrap.wrap('ab-cd-ef-gh-ij-kl-mn', 6)), ['ab-cd-', 'ef-gh-', 'ij-kl-', 'mn'])
check('textwrap misc 16', (textwrap.wrap('xxxxxxxx-yyyyyyyy-zzzzzz', 10)), ['xxxxxxxx-', 'yyyyyyyy-', 'zzzzzz'])
check('textwrap misc 17', (textwrap.wrap('-----xxxxx', 4)), ['----', '-xxx', 'xx'])
check('textwrap misc 18', (textwrap.wrap('--xx--yy', 3)), ['--x', 'x--', 'yy'])
