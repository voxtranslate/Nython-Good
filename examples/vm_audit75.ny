check('stats avg 16', (statistics.fmean(iter([1, 2, 3]))), 2.0)
check('stats avg 17', (statistics.geometric_mean([54, 24, 36])), 36.000000000000014)
check('stats avg 18', (statistics.geometric_mean(st_f)), 0.5447869384461159)
check('stats avg 19', (statistics.harmonic_mean([40, 60])), 48.0)
check('stats avg 20', (statistics.harmonic_mean([60, 40], weights=[5, 30])), 42.0)
check('stats avg 21', (statistics.harmonic_mean(st_i)), 3.3662837296286403)
check('stats avg 22', (statistics.harmonic_mean([2.5, 3.0, 10.0])), 3.6)
check('stats avg 23', (statistics.harmonic_mean([1, 0, 2])), 0)
check('stats avg 24', (statistics.harmonic_mean([7])), 7)
check('stats avg 25', (statistics.harmonic_mean(st_fr[:3])), Fraction(30, 77))
check('stats avg 26', (statistics.median(st_i)), 4.5)
check('stats avg 27', (statistics.median([1, 3, 5])), 3)
check('stats avg 28', (statistics.median([1, 3, 5, 7])), 4.0)
check('stats avg 29', (statistics.median(st_f)), 1.25)
check('stats avg 30', (statistics.median_low([1, 3, 5, 7])), 3)
check('stats avg 31', (statistics.median_high([1, 3, 5, 7])), 5)
check('stats avg 32', (statistics.median_low(st_fr)), Fraction(2, 7))
check('stats avg 33', (statistics.median_grouped([52, 52, 53, 54])), 52.5)
check('stats avg 34', (statistics.median_grouped([1, 3, 3, 5, 7])), 3.25)
check('stats avg 35', (statistics.median_grouped([1, 2, 2, 3, 4, 4, 4, 4, 4, 5], interval=2)), 3.4)
check('stats avg 36', (statistics.median_grouped([3.5])), 3.5)
check('stats avg 37', (statistics.mode([1, 1, 2, 3, 3, 3, 3, 4])), 3)
check('stats avg 38', (statistics.mode(['red', 'blue', 'blue', 'red', 'green', 'red', 'red'])), 'red')
check('stats avg 39', (statistics.mode('aabbbcc')), 'b')
check('stats avg 40', (statistics.mode([1, 1.0, True, 2, 2])), 1)
check('stats avg 41', (statistics.multimode('aabbbbccddddeeffffgg')), ['b', 'd', 'f'])
check('stats avg 42', (statistics.multimode([])), [])
check('stats avg 43', (statistics.multimode([3, 1, 2])), [3, 1, 2])
check('stats spread 0', (statistics.quantiles([105, 129, 87, 86, 111, 111, 89, 81, 108, 92, 110, 100, 75, 105, 103, 109, 76, 119, 99, 91, 103, 129, 106, 101, 84, 111, 74, 87, 86, 103, 103, 106, 86, 111, 75, 87, 102, 121, 111, 88, 89, 101, 106, 95, 103, 107, 101, 81, 109, 104], n=10)), [81.0, 86.2, 89.0, 99.4, 102.5, 103.6, 106.0, 109.8, 111.0])
check('stats spread 1', (statistics.quantiles(st_i)), [2.75, 4.5, 9.25])
check('stats spread 2', (statistics.quantiles(st_i, method='inclusive')), [3.25, 4.5, 8.5])
