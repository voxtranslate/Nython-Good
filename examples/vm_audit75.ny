# ── statistics ────────────────────────────────────────────────────────────────
import statistics
from statistics import NormalDist, StatisticsError
st_f = [2.75, 1.75, 1.25, 0.25, 0.5, 1.25, 3.5, 0.1, 1e-3, 7.0]
st_i = [1, 2, 3, 4, 4, 5, 7, 9, 10, 12]
st_big = [1e50, 1, -1e50, 3.25, 2**60 + 1, 0.1]
st_fr = [F(1, 3), F(2, 7), F(5, 6), F(-1, 2)]
st_x = [1, 2, 3, 4, 5, 6, 7, 8, 9]
st_y = [1, 2, 3, 1, 2, 3, 1, 2, 3]
st_y2 = [2.1, 3.9, 6.2, 7.8, 10.1, 12.2, 13.8, 16.1, 18.0]
def st_rank(v):
    s = sorted(v)
    return [s.index(a) + (s.count(a) + 1) / 2 for a in v]
def st_ranked(x, y):
    try:
        r = statistics.correlation(x, y, method='ranked')
    except TypeError:
        r = statistics.correlation(st_rank(x), st_rank(y))   # Python 3.11
    return round(r, 12)
check('stats avg 0', (statistics.mean(st_i)), 5.7)
check('stats avg 1', (statistics.mean([1, 2, 3, 4])), 2.5)
check('stats avg 2', (statistics.mean(st_f)), 1.8351)
check('stats avg 3', (statistics.mean(st_big)), 1.9215358410114115e+17)
check('stats avg 4', (statistics.mean(st_fr)), Fraction(5, 21))
check('stats avg 5', (statistics.mean([F(1, 2), 1, 2])), Fraction(7, 6))
check('stats avg 6', (statistics.mean([1, 2.5])), 1.75)
check('stats avg 7', (statistics.mean([True, False, True])), 0.6666666666666666)
check('stats avg 8', (statistics.mean([0.1] * 10)), 0.1)
check('stats avg 9', (statistics.mean([1e308, 1e308])), 1e+308)
check('stats avg 10', (statistics.mean(x for x in [3, 4])), 3.5)
check('stats avg 11', (str(statistics.mean([float('inf'), 1.0]))), 'inf')
check('stats avg 12', (str(statistics.mean([float('nan'), 1.0]))), 'nan')
