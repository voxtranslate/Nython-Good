check('stats spread 14', (statistics.pvariance([2, 4, 4, 4, 5, 5, 7, 9])), 4)
check('stats spread 15', (statistics.pvariance(st_f)), 4.16465809)
check('stats spread 16', (statistics.pvariance(st_fr)), Fraction(803, 3528))
check('stats spread 17', (statistics.pvariance([1.5, 2.5], mu=2)), 0.25)
check('stats spread 18', (statistics.pvariance([5])), 0)
check('stats spread 19', (statistics.stdev(st_i)), 3.653004851412662)
check('stats spread 20', (statistics.stdev(st_f)), 2.151138739778952)
check('stats spread 21', (statistics.stdev([1.5, 2.5, 2.5, 2.75, 3.25, 4.75])), 1.0810874155219827)
check('stats spread 22', (statistics.stdev(st_fr)), 0.5508874171135961)
check('stats spread 23', (statistics.stdev(st_big)), 6.32455532033676e+49)
check('stats spread 24', (statistics.pstdev([2, 4, 4, 4, 5, 5, 7, 9])), 2.0)
check('stats spread 25', (statistics.pstdev(st_f)), 2.040749394217722)
check('stats spread 26', (statistics.pstdev([0.0, 0.0])), 0.0)
check('stats spread 27', (statistics.stdev([10**20, 10**20 + 2, 10**20 + 7])), 3.605551275463989)
check('stats spread 28', (statistics.variance([10**20, 10**20 + 2, 10**20 + 7])), 13)
check('stats spread 29', (statistics.stdev(range(1, 1001))), 288.8194360957494)
check('stats spread 30', (statistics.variance([F(1, 2), 1.5])), 0.5)
check('stats pair 0', (statistics.covariance(st_x, st_y)), 0.75)
check('stats pair 1', (statistics.covariance(st_x, st_y2)), 14.975000000000001)
check('stats pair 2', (statistics.covariance(st_x, [9, 8, 7, 6, 5, 4, 3, 2, 1])), -7.5)
check('stats pair 3', (statistics.correlation(st_x, st_x)), 1.0)
check('stats pair 4', (statistics.correlation(st_x, [9, 8, 7, 6, 5, 4, 3, 2, 1])), -1.0)
check('stats pair 5', (statistics.correlation(st_x, st_y)), 0.31622776601683794)
check('stats pair 6', (statistics.correlation(st_x, st_y2)), 0.9995928734584616)
check('stats pair 7', (st_ranked([1, 2, 3, 4, 5], [1, 4, 9, 16, 25])), 1.0)
check('stats pair 8', (st_ranked([3, 1, 4, 1, 5, 9, 2, 6], [2, 7, 1, 8, 2, 8, 1, 8])), 0.19885368121)
