check('struct unpack 10', (str(struct.unpack('<f', b'\x00\x00\xc0\x7f')[0])), 'nan')
check('struct unpack 11', (struct.unpack('5s2p?c', b'abcde\x01x\x01!')), (b'abcde', b'x', True, b'!'))
check('struct unpack 12', (struct.unpack('3p', b'\x05ab')), (b'ab',))
