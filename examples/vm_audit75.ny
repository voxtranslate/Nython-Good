check('csv sniff 7', (csv.Sniffer().has_header(csv_sample)), False)
check('csv sniff 8', (csv.Sniffer().has_header('1,2,3\n4,5,6\n7,8,9\n')), False)
check('csv sniff 9', (csv.Sniffer().has_header('id,value\n1,10.5\n2,11.5\n')), True)
check('csv sniff 10', (err(lambda: csv.Sniffer().sniff('abc'))), 'no error')
check('csv sniff 11', (csv.Sniffer().sniff('"a ""b"" c",d\n"e",f\n').doublequote), True)

# ── fractions ─────────────────────────────────────────────────────────────────
from fractions import Fraction
F = Fraction
def fmt312(x, spec, want):
    # Python 3.11's Fraction has no format specs (3.12 added them)
    try:
        return format(x, spec)
    except TypeError:
        return want
check('frac new 0', (F(3, 4)), Fraction(3, 4))
check('frac new 1', (F(-6, 8)), Fraction(-3, 4))
check('frac new 2', (F(6, -8)), Fraction(-3, 4))
check('frac new 3', (F(-6, -8)), Fraction(3, 4))
check('frac new 4', (F(0, -5)), Fraction(0, 1))
check('frac new 5', (F(10)), Fraction(10, 1))
check('frac new 6', (F()), Fraction(0, 1))
check('frac new 7', (F('3/4')), Fraction(3, 4))
check('frac new 8', (F(' -1.5e3 ')), Fraction(-1500, 1))
check('frac new 9', (F('1_000.25')), Fraction(4001, 4))
check('frac new 10', (F('.5')), Fraction(1, 2))
check('frac new 11', (F('5.')), Fraction(5, 1))
check('frac new 12', (F('-47e-2')), Fraction(-47, 100))
check('frac new 13', (F('3.1415')), Fraction(6283, 2000))
check('frac new 14', (F('+7')), Fraction(7, 1))
check('frac new 15', (F('1E2')), Fraction(100, 1))
check('frac new 16', (F('2.5e+2')), Fraction(250, 1))
check('frac new 17', (F('  -0  ')), Fraction(0, 1))
check('frac new 18', (F(0.1)), Fraction(3602879701896397, 36028797018963968))
check('frac new 19', (F(2.25)), Fraction(9, 4))
check('frac new 20', (F(-0.0)), Fraction(0, 1))
check('frac new 21', (F(1e300).denominator), 1)
check('frac new 22', (F(5e-324).denominator.bit_length()), 1075)
check('frac new 23', (F(F(1, 7), 5)), Fraction(1, 35))
check('frac new 24', (F(F(1, 7), F(2, 3))), Fraction(3, 14))
check('frac new 25', (F(3, F(2, 5))), Fraction(15, 2))
check('frac new 26', (F(True)), Fraction(1, 1))
check('frac new 27', (F(True, 2)), Fraction(1, 2))
check('frac new 28', (F(1, 3).numerator), 1)
check('frac new 29', (F(1, 3).denominator), 3)
check('frac new 30', (F(-2, 6).as_integer_ratio()), (-1, 3))
check('frac new 31', (F.from_float(0.75)), Fraction(3, 4))
check('frac new 32', (F.from_float(3)), Fraction(3, 1))
check('frac new 33', (F(7, 3).real), Fraction(7, 3))
check('frac new 34', (F(7, 3).imag), 0)
check('frac new 35', (F(7, 3).conjugate()), Fraction(7, 3))
check('frac err 0', (err(lambda: F('abc'))), "ValueError: Invalid literal for Fraction: 'abc'")
check('frac err 1', (err(lambda: F('1/0'))), 'ZeroDivisionError: Fraction(1, 0)')
check('frac err 2', (err(lambda: F(1, 0))), 'ZeroDivisionError: Fraction(1, 0)')
check('frac err 3', (err(lambda: F('1__0'))), "ValueError: Invalid literal for Fraction: '1__0'")
check('frac err 4', (err(lambda: F('1/2.5'))), "ValueError: Invalid literal for Fraction: '1/2.5'")
check('frac err 5', (err(lambda: F('_1'))), "ValueError: Invalid literal for Fraction: '_1'")
check('frac err 6', (err(lambda: F('1e'))), "ValueError: Invalid literal for Fraction: '1e'")
check('frac err 7', (err(lambda: F([1]))), 'TypeError: argument should be a string or a Rational instance')
check('frac err 8', (err(lambda: F(1.5, 2))), 'TypeError: both arguments should be Rational instances')
check('frac err 9', (err(lambda: F(float('nan')))), 'ValueError: cannot convert NaN to integer ratio')
check('frac err 10', (err(lambda: F(float('inf')))), 'OverflowError: cannot convert Infinity to integer ratio')
check('frac err 11', (err(lambda: F.from_float('x'))), "TypeError: Fraction.from_float() only takes floats, not 'x' (str)")
check('frac err 12', (err(lambda: F(1, 2) + 'x')), "TypeError: unsupported operand type(s) for +: 'Fraction' and 'str'")
check('frac err 13', (err(lambda: F(1, 2) < 'x')), "TypeError: '<' not supported between instances of 'Fraction' and 'str'")
check('frac err 14', (err(lambda: F(0) ** -1)), 'ZeroDivisionError: Fraction(1, 0)')
check('frac err 15', (err(lambda: F(1, 2) / 0)), 'ZeroDivisionError: Fraction(1, 0)')
check('frac err 16', (err(lambda: F(1, 2) // F(0))), 'ZeroDivisionError: integer division or modulo by zero')
check('frac err 17', (err(lambda: F(5).limit_denominator(0))), 'ValueError: max_denominator should be at least 1')
check('frac arith 0', (F(1, 2) + F(1, 3)), Fraction(5, 6))
check('frac arith 1', (F(1, 2) - F(1, 3)), Fraction(1, 6))
check('frac arith 2', (F(2, 3) * F(9, 4)), Fraction(3, 2))
check('frac arith 3', (F(2, 3) / F(4, 9)), Fraction(3, 2))
check('frac arith 4', (F(1, 2) + 1), Fraction(3, 2))
check('frac arith 5', (1 + F(1, 2)), Fraction(3, 2))
check('frac arith 6', (3 - F(1, 2)), Fraction(5, 2))
check('frac arith 7', (F(1, 2) - 3), Fraction(-5, 2))
check('frac arith 8', (2 * F(3, 4)), Fraction(3, 2))
check('frac arith 9', (F(3, 4) * 2), Fraction(3, 2))
check('frac arith 10', (1 / F(3, 4)), Fraction(4, 3))
check('frac arith 11', (F(3, 4) / 3), Fraction(1, 4))
check('frac arith 12', (F(1, 2) + 0.25), 0.75)
check('frac arith 13', (0.25 + F(1, 2)), 0.75)
check('frac arith 14', (F(1, 3) * 1.5), 0.5)
check('frac arith 15', (F(7, 2) // 2), 1)
check('frac arith 16', (7 // F(2, 3)), 10)
check('frac arith 17', (F(-7, 2) // F(1, 3)), -11)
check('frac arith 18', (F(7, 2) % 2), Fraction(3, 2))
check('frac arith 19', (F(-7, 2) % F(4, 3)), Fraction(1, 2))
check('frac arith 20', (5 % F(3, 2)), Fraction(1, 2))
check('frac arith 21', (divmod(F(7, 2), F(2, 3))), (5, Fraction(1, 6)))
check('frac arith 22', (divmod(7, F(2, 3))), (10, Fraction(1, 3)))
check('frac arith 23', (divmod(F(-7, 2), 2)), (-2, Fraction(1, 2)))
check('frac arith 24', (F(7, 2) // 1.5), 2.0)
check('frac arith 25', (F(7, 2) % 1.5), 0.5)
check('frac arith 26', (divmod(F(7, 2), 1.5)), (2.0, 0.5))
check('frac arith 27', (F(2, 3) ** 3), Fraction(8, 27))
check('frac arith 28', (F(2, 3) ** -2), Fraction(9, 4))
check('frac arith 29', (F(-2, 3) ** -3), Fraction(-27, 8))
check('frac arith 30', (F(-2, 3) ** 0), Fraction(1, 1))
check('frac arith 31', (F(4, 9) ** F(1, 2)), 0.6666666666666666)
check('frac arith 32', (F(4, 9) ** 0.5), 0.6666666666666666)
check('frac arith 33', (2 ** F(3)), 8)
check('frac arith 34', (2 ** F(-2)), Fraction(1, 4))
check('frac arith 35', (4 ** F(1, 2)), 2.0)
check('frac arith 36', (F(1, 2) ** F(2)), Fraction(1, 4))
check('frac arith 37', (2.0 ** F(1, 2)), 1.4142135623730951)
check('frac arith 38', (-F(3, 4)), Fraction(-3, 4))
check('frac arith 39', (+F(3, 4)), Fraction(3, 4))
check('frac arith 40', (abs(F(-3, 4))), Fraction(3, 4))
check('frac arith 41', (F(1, 2) + F(1, 2)), Fraction(1, 1))
check('frac arith 42', (F(1, 6) + F(1, 3)), Fraction(1, 2))
check('frac arith 43', (sum([F(1, 2), F(1, 3), F(1, 6)])), Fraction(1, 1))
check('frac arith 44', (sum([F(1, 10)] * 10) == 1), True)
check('frac arith 45', (F(1, 2) * 2j), 1j)
check('frac arith 46', (2j + F(1, 2)), (0.5+2j))
check('frac arith 47', (2j * F(1, 2)), 1j)
check('frac arith 48', (1j - F(1, 4)), (-0.25+1j))
facc = F(0)
for k in range(1, 6):
    facc += F(1, k)
fmul = F(3, 2)
fmul *= 4
fmul -= F(1, 2)
check('frac iadd', (facc), Fraction(137, 60))
check('frac imul', (fmul), Fraction(11, 2))
check('frac cmp 0', (F(1, 2) == F(2, 4)), True)
check('frac cmp 1', (F(1, 2) == 0.5), True)
