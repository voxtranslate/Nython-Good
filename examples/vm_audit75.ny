check('textwrap misc 20', (textwrap.TextWrapper(width=8).wrap('\tindented\ttabs')), ['indented', 'tabs'])
check('textwrap misc 21', (textwrap.TextWrapper(width=30, expand_tabs=False).wrap('a\tb\tc')), ['a b c'])
check('textwrap misc 22', (textwrap.shorten('Hello  world!', width=12)), 'Hello world!')
check('textwrap misc 23', (textwrap.shorten('Hello  world!', width=11)), 'Hello [...]')
check('textwrap misc 24', (textwrap.shorten('Hello world!', width=10, placeholder='...')), 'Hello...')
check('textwrap misc 25', (textwrap.shorten('The quick brown fox jumps over the lazy dog', 20)), 'The quick [...]')
check('textwrap misc 26', (textwrap.shorten('  spaced   out   text  ', 30)), 'spaced out text')
check('textwrap misc 27', (textwrap.shorten('Supercalifragilistic', 10)), '[...]')
check('textwrap misc 28', (err(lambda: textwrap.shorten('abc', 3))), 'ValueError: placeholder too large for max width')
check('textwrap dedent 0', (textwrap.dedent('    hello\n      world\n    !')), 'hello\n  world\n!')
check('textwrap dedent 1', (textwrap.dedent('\thello\n\t  there\n')), 'hello\n  there\n')
check('textwrap dedent 2', (textwrap.dedent('  a\n\tb\n')), '  a\n\tb\n')
check('textwrap dedent 3', (textwrap.dedent('  a\n    \n  b\n   \t \n')), 'a\n\nb\n\n')
check('textwrap dedent 4', (textwrap.dedent('no indent\n  some\n')), 'no indent\n  some\n')
check('textwrap dedent 5', (textwrap.dedent('    x\n  y\n      z')), '  x\ny\n    z')
check('textwrap dedent 6', (textwrap.dedent('  \t a\n  \t b\n  \tc')), ' a\n b\nc')
check('textwrap dedent 7', (textwrap.dedent('')), '')
check('textwrap dedent 8', (textwrap.dedent('\n\n  x\n')), '\n\nx\n')
check('textwrap dedent 9', (textwrap.dedent('   line one\r\n   line two\r\n')), 'line one\r\nline two\r\n')
check('textwrap dedent 10', (textwrap.indent('hello\n\nworld\n  \nend', '> ')), '> hello\n\n> world\n  \n> end')
check('textwrap dedent 11', (textwrap.indent('a\r\nb\rc\n', '+')), '+a\r\n+b\r+c\n')
