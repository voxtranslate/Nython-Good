check('textwrap misc 5', (textwrap.wrap('Hello there, how are you this fine day?', 12, max_lines=1, placeholder=' (more)')), ['Hello (more)'])
check('textwrap misc 6', (textwrap.wrap('Hello there, how are you this fine day?', 12, max_lines=2, initial_indent='>> ', subsequent_indent='.. ')), ['>> Hello', '.. [...]'])
