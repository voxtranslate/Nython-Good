check('csv sniff 1', ((csv_sn2.delimiter, csv_sn2.quotechar, csv_sn2.skipinitialspace)), (';', '"', False))
check('csv sniff 2', ((csv_sn3.delimiter, csv_sn3.quotechar)), ('|', "'"))
check('csv sniff 3', (csv.Sniffer().sniff(csv_sample4).delimiter), '\t')
