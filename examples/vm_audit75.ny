# ── csv ───────────────────────────────────────────────────────────────────────
import csv
class Sink:
    def __init__(self):
        self.parts = []
    def write(self, s):
        self.parts.append(s)
        return len(s)
    def text(self):
        return ''.join(self.parts)
def csv_write(rows, **kw):
    s = Sink()
    w = csv.writer(s, **kw)
    for r in rows:
        try:
            w.writerow(r)
        except Exception as e:
            s.parts.append('<' + type(e).__name__ + ': ' + str(e) + '>')
    return s.text()
def csv_read(lines, **kw):
    out = []
    try:
        for row in csv.reader(lines, **kw):
            out.append(row)
    except Exception as e:
        out.append(type(e).__name__ + ': ' + str(e))
    return out
def csv_roundtrip(rows, **kw):
    text = csv_write(rows, **kw)
    return csv_read(text.splitlines(True), **kw) == [[str(f) if f is not None else '' for f in r] for r in rows]
csv_rows = [['name', 'age', 'note'], ['Alice', '30', 'likes "quotes"'], ['Bob', '', 'comma, inside'],
            ['Carol', '41', 'multi\nline'], ['', ' spaced ', "it's"], ['tab\there', 'x;y', '\\back']]
csv_dir = os.path.join('/tmp', 'vm_audit75_' + str(os.getpid()))
os.mkdir(csv_dir)
csv_path = os.path.join(csv_dir, 'people.csv')
cf = open(csv_path, 'w', newline='')
cw = csv.writer(cf)
cw.writerows(csv_rows)
cf.close()
cf = open(csv_path, 'rb')
csv_raw = cf.read()
cf.close()
cf = open(csv_path, newline='')
csv_back = list(csv.reader(cf))
cf.close()
dict_path = os.path.join(csv_dir, 'dict.csv')
cf = open(dict_path, 'w', newline='')
dw = csv.DictWriter(cf, fieldnames=['id', 'name', 'score'])
dw.writeheader()
dw.writerow({'id': 1, 'name': 'x', 'score': 2.5})
dw.writerows([{'id': 2, 'name': 'y, z'}, {'id': 3, 'score': -1}])
cf.close()
cf = open(dict_path, newline='')
dict_back = [dict(r) for r in csv.DictReader(cf)]
cf.close()
cf = open(dict_path, 'rb')
dict_raw = cf.read()
cf.close()
os.remove(csv_path)
os.remove(dict_path)
os.rmdir(csv_dir)
check('csv file 0', (csv_raw), b'name,age,note\r\nAlice,30,"likes ""quotes"""\r\nBob,,"comma, inside"\r\nCarol,41,"multi\nline"\r\n, spaced ,it\'s\r\ntab\there,x;y,\\back\r\n')
check('csv file 1', (csv_back == csv_rows), True)
check('csv file 2', (dict_raw), b'id,name,score\r\n1,x,2.5\r\n2,"y, z",\r\n3,,-1\r\n')
check('csv file 3', (dict_back), [{'id': '1', 'name': 'x', 'score': '2.5'}, {'id': '2', 'name': 'y, z', 'score': ''}, {'id': '3', 'name': '', 'score': '-1'}])
check('csv file 4', (os.path.exists(csv_dir)), False)
check('csv write 0', (csv_write(csv_rows)), 'name,age,note\r\nAlice,30,"likes ""quotes"""\r\nBob,,"comma, inside"\r\nCarol,41,"multi\nline"\r\n, spaced ,it\'s\r\ntab\there,x;y,\\back\r\n')
check('csv write 1', (csv_write(csv_rows, quoting=csv.QUOTE_ALL)), '"name","age","note"\r\n"Alice","30","likes ""quotes"""\r\n"Bob","","comma, inside"\r\n"Carol","41","multi\nline"\r\n""," spaced ","it\'s"\r\n"tab\there","x;y","\\back"\r\n')
check('csv write 2', (csv_write(csv_rows, lineterminator='\n')), 'name,age,note\nAlice,30,"likes ""quotes"""\nBob,,"comma, inside"\nCarol,41,"multi\nline"\n, spaced ,it\'s\ntab\there,x;y,\\back\n')
check('csv write 3', (csv_write([[1, 2.5, -3, True, None, 'x', 10**20, 1.0, 1e100]])), '1,2.5,-3,True,,x,100000000000000000000,1.0,1e+100\r\n')
check('csv write 4', (csv_write([[1, 2.5, None, 'x', '']], quoting=csv.QUOTE_NONNUMERIC)), '1,2.5,"","x",""\r\n')
check('csv write 5', (csv_write([[1, 2.5, None, 'x', '']], quoting=csv.QUOTE_STRINGS) if hasattr(csv, 'QUOTE_STRINGS') else ',1,2.5,,"x",""'.replace(',1', '1') + '\r\n'), '1,2.5,,"x",""\r\n')
