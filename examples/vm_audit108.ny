# vm_audit108.ny - Python's language-tooling modules over Nython's own
# parser and VM (round 83), both engines: ast (parse from the real parser,
# dump, unparse, literal_eval, visitors and transformers, compile() of a
# tree), tokenize / token (3.12's f-string tokens), symtable, dis / opcode,
# marshal, pickletools, pydoc, pyclbr, tabnanny, py_compile, compileall,
# modulefinder, this - and tokens' start and end positions (a multi-line
# string's line is its first one).
#
# Generated by tools/gen_vm_audit108.py: every check's expected value is
# what CPython 3.12 computes for the same expression, so `python3.12
# examples/vm_audit108.ny` passes too, and `python3` (3.11) as well (the
# checks whose value 3.11 gives differently are guarded by PY312). The
# Nython-only checks at the end (dis over Nython's VM bytecode, the
# adaptive view, antigravity) run on Nython only.
#
#     ./build/nython-cli examples/vm_audit108.ny
#     ./build/nython-cli --vm examples/vm_audit108.ny
try:
    true
    nython = True
except NameError:
    nython = False
    true = True
    false = False
    none = None

import sys
import os
import io
import ast
import tokenize
import token
import symtable
import dis
import opcode
import marshal
import pickle
import pickletools
import pydoc
import pyclbr
import tabnanny
import py_compile
import compileall
import modulefinder
import contextlib
import tempfile
import shutil
import re

PY312 = sys.version_info >= (3, 12)

pass_n = 0
fail_n = 0
results = []

def check(name, got, want):
    results.append([name, repr(got) == repr(want), got, want])

def err(f):
    # the exception f() raises: its type name and message
    try:
        f()
    except Exception as e:
        return type(e).__name__ + ": " + re.sub(" at 0x[0-9a-fA-F]+", "", str(e))
    return "no error"

def D(src, **kw):
    # ast.dump of src's tree without 3.12's type_params=[] (3.11 has none)
    return ast.dump(ast.parse(src), **kw).replace(", type_params=[]", "")

def syn(f):
    # a SyntaxError's type, line and column
    try:
        f()
    except SyntaxError as e:
        return [type(e).__name__, e.lineno, e.offset]
    return "no error"

def toks(src):
    return [(token.tok_name[t.type], t.string, t.start, t.end)
            for t in tokenize.generate_tokens(io.StringIO(src).readline)]

TMP = tempfile.mkdtemp(prefix="va108_%d_" % os.getpid())

def tmpfile(name, text):
    p = os.path.join(TMP, name)
    with open(p, "w") as fh:
        fh.write(text)
    return p


# ── ast ───────────────────────────────────────────────────────────────────────
AST_SOURCES = [
    'x = 1 + 2 * 3 - -4',
    'a, *b = c',
    'x = y = 0',
    'x += 1; y //= 2; z **= 3; w @= m',
    'x: int = 5',
    'obj.attr: list[str]',
    'del a, b[0], c.d',
    'def f(a, b=1, /, c=2, *args, d, e=3, **kw) -> int: return a',
    '@dec\n@dec2(1)\ndef g(): pass',
    'async def h():\n    await x\n    async for i in y: pass\n    async with a as b: pass',
    "class C(B, metaclass=M):\n    'doc'\n    x = 1",
    'if a: b\nelif c: d\nelse: e',
    'while x: x -= 1\nelse: done()',
    'for i, (j, k) in pairs: continue\nelse: break',
    'with open(f) as g, h: pass',
    'try:\n    x\nexcept (A, B) as e:\n    y\nexcept:\n    raise\nelse:\n    z\nfinally:\n    w',
    'try:\n    x\nexcept* ValueError:\n    pass',
    "raise E('m') from cause",
    "assert x, 'msg'",
    'import os, sys as s\nfrom ..pkg import a as b, c\nfrom m import *',
    'global g1, g2',
    'def outer():\n    v = 0\n    def inner():\n        nonlocal v\n        v += 1',
    'lam = lambda x, *a, k=1, **kw: x if k else None',
    'r = [x for x in range(3) if x if not x]',
    'r = {k: v for k, v in d.items()}',
    'r = {x async for x in aiter()}',
    'r = (x * y for x in a for y in b)',
    'r = a and b or not c',
    'r = 1 < x <= 2 != y is not None in z not in w',
    'r = a[1:2], a[::3], a[x, 1:], a[...]',
    'r = f(*args, k=1, **kw)',
    "r = b'\\x00ab' + 'x' 'y'",
    'r = 1j + 2.5 + 0x1F + 1_000 + 0o7 + 0b11',
    'r = True, False, None, ...',
    'r = (n := 10)',
    "r = f'a{b}c{d!r}e{f:>10}'",
    "r = f'{x=}'",
    "r = {1, 2}, {}, {'a': 1, **m}, [*a, *b]",
    'r = x if y else z',
    'r = ~a | b & c ^ d << 1 >> 2',
    'def gen():\n    yield 1\n    x = yield\n    yield from other()',
    "match p:\n    case 0 | 1: pass\n    case [a, *rest]: pass\n    case {'k': v, **kw}: pass\n    case Point(x=0, y=yy) as pt: pass\n    case str() | None: pass\n    case _: pass",
    "print('hi', end='')",
    "'''docstring'''\nx = 1",
    'x = [\n    1,\n    2,\n]',
    'def f(*, a): pass',
    'x = *a, b',
    'for x in 1, 2: pass',
]
