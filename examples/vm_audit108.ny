check('a multi-line string is located at its first line', [(n.lineno, n.col_offset, n.end_lineno, n.end_col_offset) for n in ast.walk(ast.parse('x = """a\nbc"""\ny = 1')) if isinstance(n, ast.Constant)],
      [(1, 4, 2, 5), (3, 4, 3, 5)])

UNPARSE_SOURCES = [
    "x = 1 + 2 * (3 - 4)",
    "a, b = (b, a)",
    "def f(a, /, b=1, *args, c, **kw) -> int:\n    return a",
    "@d\nclass C(B, metaclass=M):\n    x: int = 1\n\n    async def m(self):\n        await self.x",
    "if a:\n    b\nelif c:\n    d\nelse:\n    e",
    "try:\n    x\nexcept E as e:\n    raise F from e\nfinally:\n    pass",
    "with a as b, c:\n    pass",
    "r = [x for x in y if x]",
    "r = {k: v for k, v in z}",
    "r = lambda x, *y: x",
    "r = x if y else z",
    "r = (yield x)",
    "r = not a and (b or c)",
    "r = a[1:2, ::3]",
    "r = -x ** 2",
    "r = (-x) ** 2",
    "match p:\n    case [1, *rest]:\n        pass\n    case {'k': v}:\n        pass\n    case P(x=0) | None:\n        pass",
    "global a, b",
    "del a[0], b.c",
    "assert x, 'm'",
    "for i in range(3):\n    continue\nelse:\n    pass",
    "while True:\n    break",
    "from ..m import a as b",
    "r = 'a' 'b'",
    "r = {1, 2, *s}",
    "r = (1,)",
    "r = ()",
    "r = f(*a, **k)",
]
check('unparse 0', ast.unparse(ast.parse(UNPARSE_SOURCES[0])),
      'x = 1 + 2 * (3 - 4)')
check('unparse 1', ast.unparse(ast.parse(UNPARSE_SOURCES[1])),
      'a, b = (b, a)')
check('unparse 2', ast.unparse(ast.parse(UNPARSE_SOURCES[2])),
      'def f(a, /, b=1, *args, c, **kw) -> int:\n    return a')
check('unparse 3', ast.unparse(ast.parse(UNPARSE_SOURCES[3])),
      '@d\nclass C(B, metaclass=M):\n    x: int = 1\n\n    async def m(self):\n        await self.x')
check('unparse 4', ast.unparse(ast.parse(UNPARSE_SOURCES[4])),
      'if a:\n    b\nelif c:\n    d\nelse:\n    e')
check('unparse 5', ast.unparse(ast.parse(UNPARSE_SOURCES[5])),
      'try:\n    x\nexcept E as e:\n    raise F from e\nfinally:\n    pass')
check('unparse 6', ast.unparse(ast.parse(UNPARSE_SOURCES[6])),
      'with a as b, c:\n    pass')
check('unparse 7', ast.unparse(ast.parse(UNPARSE_SOURCES[7])),
      'r = [x for x in y if x]')
check('unparse 8', ast.unparse(ast.parse(UNPARSE_SOURCES[8])),
      'r = {k: v for k, v in z}')
check('unparse 9', ast.unparse(ast.parse(UNPARSE_SOURCES[9])),
      'r = lambda x, *y: x')
check('unparse 10', ast.unparse(ast.parse(UNPARSE_SOURCES[10])),
      'r = x if y else z')
check('unparse 11', ast.unparse(ast.parse(UNPARSE_SOURCES[11])),
      'r = (yield x)')
check('unparse 12', ast.unparse(ast.parse(UNPARSE_SOURCES[12])),
      'r = not a and (b or c)')
check('unparse 13', ast.unparse(ast.parse(UNPARSE_SOURCES[13])),
      'r = a[1:2, ::3]')
check('unparse 14', ast.unparse(ast.parse(UNPARSE_SOURCES[14])),
      'r = -x ** 2')
check('unparse 15', ast.unparse(ast.parse(UNPARSE_SOURCES[15])),
      'r = (-x) ** 2')
check('unparse 16', ast.unparse(ast.parse(UNPARSE_SOURCES[16])),
      "match p:\n    case [1, *rest]:\n        pass\n    case {'k': v}:\n        pass\n    case P(x=0) | None:\n        pass")
check('unparse 17', ast.unparse(ast.parse(UNPARSE_SOURCES[17])),
      'global a, b')
check('unparse 18', ast.unparse(ast.parse(UNPARSE_SOURCES[18])),
      'del a[0], b.c')
check('unparse 19', ast.unparse(ast.parse(UNPARSE_SOURCES[19])),
      "assert x, 'm'")
check('unparse 20', ast.unparse(ast.parse(UNPARSE_SOURCES[20])),
      'for i in range(3):\n    continue\nelse:\n    pass')
check('unparse 21', ast.unparse(ast.parse(UNPARSE_SOURCES[21])),
      'while True:\n    break')
check('unparse 22', ast.unparse(ast.parse(UNPARSE_SOURCES[22])),
      'from ..m import a as b')
check('unparse 23', ast.unparse(ast.parse(UNPARSE_SOURCES[23])),
      "r = 'ab'")
check('unparse 24', ast.unparse(ast.parse(UNPARSE_SOURCES[24])),
      'r = {1, 2, *s}')
check('unparse 25', ast.unparse(ast.parse(UNPARSE_SOURCES[25])),
      'r = (1,)')
check('unparse 26', ast.unparse(ast.parse(UNPARSE_SOURCES[26])),
      'r = ()')
check('unparse 27', ast.unparse(ast.parse(UNPARSE_SOURCES[27])),
      'r = f(*a, **k)')
check('unparse round trips', [ast.dump(ast.parse(ast.unparse(ast.parse(s)))) == ast.dump(ast.parse(s)) for s in UNPARSE_SOURCES],
      [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])
if PY312:
    check('unparse of an f-string', ast.unparse(ast.parse("f'a{b!r:>{w}}c'")),
          "f'a{b!r:>{w}}c'")
check('literal_eval', [ast.literal_eval(s) for s in ['1', '-2.5', "'s'", "b'b'", '[1, (2, 3), {4: 5}]', '{1, 2}', 'None', 'True', '1+2j', '-(1)', 'set()']],
      [1, -2.5, 's', b'b', [1, (2, 3), {4: 5}], {1, 2}, None, True, (1+2j), -1, set()])
check('literal_eval of a tree', ast.literal_eval(ast.parse('[1, 2]', mode='eval')),
      [1, 2])
check('literal_eval refuses a call', err(lambda: ast.literal_eval('f(1)')),
      'ValueError: malformed node or string on line 1: <ast.Call object>')
check('literal_eval refuses a name', err(lambda: ast.literal_eval('a + 1')),
      'ValueError: malformed node or string on line 1: <ast.Name object>')

class Counter(ast.NodeVisitor):
    def __init__(self):
        self.names = []
        self.calls = 0
    def visit_Name(self, node):
        self.names.append(node.id)
    def visit_Call(self, node):
        self.calls += 1
        self.generic_visit(node)
cv = Counter()
cv.visit(ast.parse("a = f(b, g(c))\nd = a"))

class Bump(ast.NodeTransformer):
    def visit_Constant(self, node):
        if isinstance(node.value, int):
            return ast.copy_location(ast.Constant(node.value + 1), node)
        return node
    def visit_Pass(self, node):
        return None
bumped = ast.fix_missing_locations(Bump().visit(ast.parse("r = 1 + 2 * 3\npass\nq = 'k'")))
bns = {}
exec(compile(bumped, "<bumped>", "exec"), bns)
check('NodeVisitor', [cv.names, cv.calls],
      [['a', 'f', 'b', 'g', 'c', 'd', 'a'], 2])
check('NodeTransformer (a node removed, constants changed)', [ast.unparse(bumped), bns['r'], bns['q']],
      ["r = 2 + 3 * 4\nq = 'k'", 14, 'k'])
check('walk', [type(n).__name__ for n in ast.walk(ast.parse('x = f(1)'))],
      ['Module', 'Assign', 'Name', 'Call', 'Store', 'Name', 'Constant', 'Load'])
check('iter_fields', [(k, type(v).__name__) for k, v in ast.iter_fields(ast.parse('x = 1').body[0])],
      [('targets', 'list'), ('value', 'Constant'), ('type_comment', 'NoneType')])
check('iter_child_nodes', [type(n).__name__ for n in ast.iter_child_nodes(ast.parse('a + b', mode='eval').body)],
      ['Name', 'Add', 'Name'])
check('get_docstring', [ast.get_docstring(ast.parse('def f():\n    \'\'\'  Doc.\n\n    More.\n    \'\'\'\n').body[0]), ast.get_docstring(ast.parse('x = 1'))],
      ['Doc.\n\nMore.', None])
check('get_docstring(clean=False)', ast.get_docstring(ast.parse('class K:\n    """  a\n    b"""').body[0], clean=False),
      '  a\n    b')

SEG = "x = (1 +\n     2)\ny = foo(a,\n        b)\n"
segtree = ast.parse(SEG)
check('get_source_segment', [ast.get_source_segment(SEG, segtree.body[0].value), ast.get_source_segment(SEG, segtree.body[1].value), ast.get_source_segment(SEG, segtree.body[1].value, padded=True)],
      ['1 +\n     2', 'foo(a,\n        b)', '    foo(a,\n        b)'])
check('increment_lineno', [(n.lineno, n.end_lineno) for n in ast.walk(ast.increment_lineno(ast.parse('x = 1\ny = 2'), 10)) if hasattr(n, 'lineno')],
      [(11, 11), (12, 12), (11, 11), (11, 11), (12, 12), (12, 12)])
check('copy_location', (lambda n: [n.lineno, n.col_offset, n.end_lineno, n.end_col_offset])(ast.copy_location(ast.Name('q', ast.Load()), ast.parse('x + abc', mode='eval').body.right)),
      [1, 4, 1, 7])
check('fix_missing_locations', (lambda e: [e.body.lineno, e.body.col_offset, e.body.left.lineno, e.body.left.end_col_offset])(ast.fix_missing_locations(ast.Expression(ast.BinOp(ast.Constant(1), ast.Add(), ast.Constant(2))))),
      [1, 0, 1, 0])
check("compile(tree, 'exec') runs it", (lambda ns: (exec(compile(ast.parse('t = sum(n * n for n in range(5))'), '<ast>', 'exec'), ns), ns['t'])[1])({}),
      30)
check("compile(Expression, 'eval')", eval(compile(ast.fix_missing_locations(ast.Expression(ast.BinOp(ast.Constant(6), ast.Mult(), ast.Constant(7)))), '<ast>', 'eval')),
      42)

def tree_line():
    # a compiled tree keeps the tree's line numbers
    t = ast.increment_lineno(ast.parse("x = 1\ny = 1 / 0"), 20)
    try:
        exec(compile(t, "<tree>", "exec"), {})
    except ZeroDivisionError as e:
        tb = e.__traceback__
        while tb.tb_next:
            tb = tb.tb_next
        return [tb.tb_lineno, tb.tb_frame.f_code.co_filename]
    return "no error"
check("compile(tree) keeps the tree's line numbers", tree_line(),
      [22, '<tree>'])
check('compile(tree) checks the node type', [err(lambda: compile(ast.parse('x'), '<t>', 'eval')), err(lambda: compile(5, '<t>', 'exec'))],
      ['TypeError: expected Expression node, got Module', 'TypeError: compile() arg 1 must be a string, bytes or AST object'])
check('compile(source, flags=PyCF_ONLY_AST)', ast.dump(compile('x = 1', '<s>', 'exec', ast.PyCF_ONLY_AST)),
      "Module(body=[Assign(targets=[Name(id='x', ctx=Store())], value=Constant(value=1))], type_ignores=[])")
check('compile(tree) of a function', (lambda ns: (exec(compile(ast.parse('def sq(v):\n    return v * v\nres = [sq(i) for i in range(4)]'), '<ast>', 'exec'), ns), ns['res'])[1])({}),
      [0, 1, 4, 9])
check('ast.parse SyntaxError', [syn(lambda: ast.parse('x = (1,\ny = 2')), syn(lambda: ast.parse('f(a, [b,\n')), syn(lambda: ast.parse('x = )')), syn(lambda: ast.parse('x = = 1\n')), syn(lambda: ast.parse('a = 1 +\n'))],
      [['SyntaxError', 1, 5], ['SyntaxError', 1, 6], ['SyntaxError', 1, 5], ['SyntaxError', 1, 5], ['SyntaxError', 1, 8]])
check('ast.parse SyntaxError messages', [err(lambda: ast.parse('x = (1,\ny = 2')), err(lambda: ast.parse('x = )')), err(lambda: ast.parse('x = (]')), err(lambda: ast.parse('x = = 1\n'))],
      ["SyntaxError: '(' was never closed (<unknown>, line 1)", "SyntaxError: unmatched ')' (<unknown>, line 1)", "SyntaxError: closing parenthesis ']' does not match opening parenthesis '(' (<unknown>, line 1)", 'SyntaxError: invalid syntax (<unknown>, line 1)'])
check('node classes', [ast.BinOp._fields, ast.FunctionDef._fields[:4], ast.arguments._fields, ast.Constant._fields],
      [('left', 'op', 'right'), ('name', 'args', 'body', 'decorator_list'), ('posonlyargs', 'args', 'vararg', 'kwonlyargs', 'kw_defaults', 'kwarg', 'defaults'), ('value', 'kind')])
check('node defaults', [ast.dump(ast.Name('x')), ast.dump(ast.Call(ast.Name('f', ast.Load()), [], []))],
      ["Name(id='x')", "Call(func=Name(id='f', ctx=Load()), args=[], keywords=[])"])
check('node equality is identity, attributes as given', [ast.Name('x') == ast.Name('x'), ast.Constant(1).value, isinstance(ast.parse('1', mode='eval').body, ast.expr)],
      [False, 1, True])

# ── tokenize / token ──────────────────────────────────────────────────────────
TK1 = "def f(a, b=2):\n    # comment\n    return a ** b  # trailing\n\nx = f(1,\n      2)\n"
check('generate_tokens', toks(TK1),
      [('NAME', 'def', (1, 0), (1, 3)), ('NAME', 'f', (1, 4), (1, 5)), ('OP', '(', (1, 5), (1, 6)), ('NAME', 'a', (1, 6), (1, 7)), ('OP', ',', (1, 7), (1, 8)), ('NAME', 'b', (1, 9), (1, 10)), ('OP', '=', (1, 10), (1, 11)), ('NUMBER', '2', (1, 11), (1, 12)), ('OP', ')', (1, 12), (1, 13)), ('OP', ':', (1, 13), (1, 14)), ('NEWLINE', '\n', (1, 14), (1, 15)), ('COMMENT', '# comment', (2, 4), (2, 13)), ('NL', '\n', (2, 13), (2, 14)), ('INDENT', '    ', (3, 0), (3, 4)), ('NAME', 'return', (3, 4), (3, 10)), ('NAME', 'a', (3, 11), (3, 12)), ('OP', '**', (3, 13), (3, 15)), ('NAME', 'b', (3, 16), (3, 17)), ('COMMENT', '# trailing', (3, 19), (3, 29)), ('NEWLINE', '\n', (3, 29), (3, 30)), ('NL', '\n', (4, 0), (4, 1)), ('DEDENT', '', (5, 0), (5, 0)), ('NAME', 'x', (5, 0), (5, 1)), ('OP', '=', (5, 2), (5, 3)), ('NAME', 'f', (5, 4), (5, 5)), ('OP', '(', (5, 5), (5, 6)), ('NUMBER', '1', (5, 6), (5, 7)), ('OP', ',', (5, 7), (5, 8)), ('NL', '\n', (5, 8), (5, 9)), ('NUMBER', '2', (6, 6), (6, 7)), ('OP', ')', (6, 7), (6, 8)), ('NEWLINE', '\n', (6, 8), (6, 9)), ('ENDMARKER', '', (7, 0), (7, 0))])
check('strings and numbers', toks("s = r'\\d' + b\"x\" + 0x1f + 1.5e3j\n"),
      [('NAME', 's', (1, 0), (1, 1)), ('OP', '=', (1, 2), (1, 3)), ('STRING', "r'\\d'", (1, 4), (1, 9)), ('OP', '+', (1, 10), (1, 11)), ('STRING', 'b"x"', (1, 12), (1, 16)), ('OP', '+', (1, 17), (1, 18)), ('NUMBER', '0x1f', (1, 19), (1, 23)), ('OP', '+', (1, 24), (1, 25)), ('NUMBER', '1.5e3j', (1, 26), (1, 32)), ('NEWLINE', '\n', (1, 32), (1, 33)), ('ENDMARKER', '', (2, 0), (2, 0))])
check('a multi-line string token: start and end', toks('x = """a\nb"""\n'),
      [('NAME', 'x', (1, 0), (1, 1)), ('OP', '=', (1, 2), (1, 3)), ('STRING', '"""a\nb"""', (1, 4), (2, 4)), ('NEWLINE', '\n', (2, 4), (2, 5)), ('ENDMARKER', '', (3, 0), (3, 0))])
check('exact_type', [token.tok_name[t.exact_type] for t in tokenize.generate_tokens(io.StringIO('a += b ** -c != d\n').readline)],
      ['NAME', 'PLUSEQUAL', 'NAME', 'DOUBLESTAR', 'MINUS', 'NAME', 'NOTEQUAL', 'NAME', 'NEWLINE', 'ENDMARKER'])
check('untokenize (full tokens) gives the source back', tokenize.untokenize(tokenize.generate_tokens(io.StringIO(TK1).readline)) == TK1,
      True)
check('untokenize (type, string pairs)', tokenize.untokenize([(t.type, t.string) for t in tokenize.generate_tokens(io.StringIO('x=1+2\n').readline)]),
      'x =1 +2 \n')
check('tokenize (bytes) starts with ENCODING', [(token.tok_name[t.type], t.string) for t in tokenize.tokenize(io.BytesIO(b'x = 1\n').readline)][:3],
      [('ENCODING', 'utf-8'), ('NAME', 'x'), ('OP', '=')])
check('detect_encoding: cookie', tokenize.detect_encoding(io.BytesIO(b'# -*- coding: latin-1 -*-\nx = 1\n').readline),
      ('iso-8859-1', [b'# -*- coding: latin-1 -*-\n']))
check('detect_encoding: BOM', tokenize.detect_encoding(io.BytesIO(b'\xef\xbb\xbfx = 1\n').readline),
      ('utf-8-sig', [b'x = 1\n']))
check('detect_encoding: default', tokenize.detect_encoding(io.BytesIO(b'x = 1\n').readline),
      ('utf-8', [b'x = 1\n']))
if PY312:
    check('f-string tokens (3.12)', [(token.tok_name[t.type], t.string) for t in tokenize.generate_tokens(io.StringIO("f'a{b!r:>{w}}c{{d}}'\n").readline)],
          [('FSTRING_START', "f'"), ('FSTRING_MIDDLE', 'a'), ('OP', '{'), ('NAME', 'b'), ('OP', '!'), ('NAME', 'r'), ('OP', ':'), ('FSTRING_MIDDLE', '>'), ('OP', '{'), ('NAME', 'w'), ('OP', '}'), ('FSTRING_MIDDLE', ''), ('OP', '}'), ('FSTRING_MIDDLE', 'c{'), ('FSTRING_MIDDLE', 'd}'), ('FSTRING_END', "'"), ('NEWLINE', '\n'), ('ENDMARKER', '')])
if PY312:
    check('unterminated triple-quoted string (3.12)', err(lambda: list(tokenize.generate_tokens(io.StringIO('"""abc\n').readline))),
          "TokenError: ('EOF in multi-line string', (1, 1))")
if PY312:
    check('dedent mismatch (3.12)', err(lambda: list(tokenize.generate_tokens(io.StringIO('if a:\n        x\n    y\n').readline))),
          'IndentationError: unindent does not match any outer indentation level (<string>, line 3)')
check('token module', [token.tok_name[token.NAME], token.ISTERMINAL(token.OP), token.ISNONTERMINAL(token.NT_OFFSET + 1), token.ISEOF(token.ENDMARKER), token.EXACT_TOKEN_TYPES['**='] == token.DOUBLESTAREQUAL, token.EXACT_TOKEN_TYPES['->'] == token.RARROW],
      ['NAME', True, True, True, True, True])
check('TokenInfo', (lambda t: [t.type == token.NAME, t.string, t.start, t.end, t.line, repr(t).startswith('TokenInfo(type=1 (NAME)')])(next(tokenize.generate_tokens(io.StringIO('abc + 1\n').readline))),
      [True, 'abc', (1, 0), (1, 3), 'abc + 1\n', True])

# ── symtable ──────────────────────────────────────────────────────────────────
SYM = """
import os
X = 1
def outer(a, b=2):
    y = a + X
    def inner(c):
        nonlocal y
        y += c
        return y + b
    return inner
class K(object):
    attr = 3
    def meth(self, q):
        return q
"""
st = symtable.symtable(SYM, "<sym>", "exec")
st_outer = [c for c in st.get_children() if c.get_name() == "outer"][0]
st_inner = st_outer.get_children()[0]
st_k = [c for c in st.get_children() if c.get_name() == "K"][0]
check('module table', [st.get_type(), st.get_name(), st.get_lineno(), st.is_optimized(), sorted(st.get_identifiers())],
      ['module', 'top', 0, False, ['K', 'X', 'object', 'os', 'outer']])
check('module symbols', [(n, st.lookup(n).is_global(), st.lookup(n).is_assigned(), st.lookup(n).is_imported(), st.lookup(n).is_namespace()) for n in ['os', 'X', 'outer', 'K']],
      [('os', True, False, True, False), ('X', True, True, False, False), ('outer', True, True, False, True), ('K', True, True, False, True)])
check('function table', [st_outer.get_type(), st_outer.get_lineno(), st_outer.get_parameters(), sorted(st_outer.get_locals()), st_outer.get_globals(), st_outer.get_frees(), st_outer.is_nested(), st_outer.has_children()],
      ['function', 4, ('a', 'b'), ['a', 'b', 'inner', 'y'], ('X',), (), False, True])
check('closure table', [st_inner.get_name(), st_inner.get_parameters(), sorted(st_inner.get_frees()), st_inner.lookup('y').is_free(), st_inner.lookup('c').is_parameter(), st_inner.is_nested()],
      ['inner', ('c',), ['b', 'y'], True, True, True])
check('class table', [st_k.get_type(), sorted(st_k.get_identifiers()), st_k.lookup('meth').is_namespace(), st_k.lookup('attr').is_local()],
      ['class', ['attr', 'meth'], True, True])
check('symbol details', [st_outer.lookup('X').is_declared_global(), st_outer.lookup('X').is_global(), st_outer.lookup('y').is_local(), st_outer.lookup('y').is_referenced(), st_outer.lookup('inner').get_namespaces()[0].get_name()],
      [False, True, True, False, 'inner'])
check('symtable of an expression', [symtable.symtable('a + b', '<e>', 'eval').get_identifiers().__class__.__name__, sorted(symtable.symtable('a + b', '<e>', 'eval').get_identifiers())],
      ['dict_keys', ['a', 'b']])
check('symtable SyntaxError', [err(lambda: symtable.symtable('x = = 1\n', '<x>', 'exec')), syn(lambda: symtable.symtable('x = = 1\n', '<x>', 'exec'))],
      ['SyntaxError: invalid syntax (<x>, line 1)', ['SyntaxError', 1, 5]])

# ── dis / opcode: what holds for CPython's bytecode and Nython's alike ─────────
def hfun(a, b=1):
    x = 42
    return x
hbuf = io.StringIO()
dis.dis(hfun, file=hbuf)
hsrc = io.StringIO()
dis.dis("a = b + 1", file=hsrc)
HL = hfun.__code__.co_firstlineno
check('opname / opmap', [dis.opname[dis.opmap['LOAD_CONST']], dis.opmap['RETURN_VALUE'] in range(256), 'POP_TOP' in opcode.opmap],
      ['LOAD_CONST', True, True])
check('pretty_flags', [dis.pretty_flags(3), dis.pretty_flags(3 | 32), dis.pretty_flags(0x100000)],
      ['OPTIMIZED, NEWLOCALS', 'OPTIMIZED, NEWLOCALS, GENERATOR', '0x100000'])
check('code_info head', dis.code_info(hfun).splitlines()[:1] + dis.code_info(hfun).splitlines()[2:6],
      ['Name:              hfun', 'Argument count:    2', 'Positional-only arguments: 0', 'Kw-only arguments: 0', 'Number of locals:  3'])
check("Bytecode's code object", (lambda c: [c.co_name, c.co_argcount, c.co_varnames[:2], c.co_flags & 3])(dis.Bytecode(hfun).codeobj),
      ['hfun', 2, ('a', 'b'), 3])
check('get_instructions: a constant', any(i.opname == 'LOAD_CONST' and i.argval == 42 for i in dis.get_instructions(hfun)),
      True)
check('Instruction fields', dis.Instruction._fields[:9],
      ('opname', 'opcode', 'arg', 'argval', 'argrepr', 'offset', 'starts_line', 'is_jump_target', 'positions'))
check('findlinestarts covers the body', set([HL + 1, HL + 2]) <= set(ln for off, ln in dis.findlinestarts(hfun.__code__)),
      True)
check('dis() output', ['LOAD_CONST' in hbuf.getvalue(), '(42)' in hbuf.getvalue(), 'STORE_NAME' in hsrc.getvalue(), '(a)' in hsrc.getvalue(), '(b)' in hsrc.getvalue()],
      [True, True, True, True, True])
check('dis of something else', err(lambda: dis.dis(5)),
      "TypeError: don't know how to disassemble int objects")
check('stack_effect', opcode.stack_effect(opcode.opmap['POP_TOP']),
      -1)
if PY312:
    check('stack_effect of no opcode (3.12)', err(lambda: opcode.stack_effect(-1)),
          'ValueError: invalid opcode or oparg')

# ── marshal ───────────────────────────────────────────────────────────────────
MV = [None, True, False, 5, -1, 300, 2**31, -2**31 - 1, 2**40, 2**70, -2**70, 1.5, -0.0, 1e300,
      "a", "h\u00e9llo", "x" * 300, b"xy", bytearray(b"z"), (1, 2), (), [1, "a", 2.5], {"k": [1, 2]},
      frozenset(), {1, 2}, frozenset([3]), 1j, 2.5 - 1j, ..., StopIteration, [[1], [1]], ("s", "s")]
shared = [1, 2]
pair = [shared, shared]
T3 = (1, 'ab', [2.5])
check("dumps is CPython's, byte for byte", [marshal.dumps(v) for v in MV],
      [b'N', b'T', b'F', b'\xe9\x05\x00\x00\x00', b'\xe9\xff\xff\xff\xff', b'\xe9,\x01\x00\x00', b'\xec\x03\x00\x00\x00\x00\x00\x00\x00\x02\x00', b'\xec\xfd\xff\xff\xff\x01\x00\x00\x00\x02\x00', b'\xec\x03\x00\x00\x00\x00\x00\x00\x00\x00\x04', b'\xec\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04', b'\xec\xfb\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04', b'\xe7\x00\x00\x00\x00\x00\x00\xf8?', b'\xe7\x00\x00\x00\x00\x00\x00\x00\x80', b'\xe7\x9cu\x00\x88<\xe47~', b'\xda\x01a', b'\xf5\x06\x00\x00\x00h\xc3\xa9llo', b'\xc1,\x01\x00\', b'\xf3\x02\x00\x00\x00xy', b'\xf3\x01\x00\x00\x00z', b'\xa9\x02\xe9\x01\x00\x00\x00\xe9\x02\x00\x00\x00', b'\xa9\x00', b'\xdb\x03\x00\x00\x00\xe9\x01\x00\x00\x00\xda\x01a\xe7\x00\x00\x00\x00\x00\x00\x04@', b'\xfb\xda\x01k[\x02\x00\x00\x00\xe9\x01\x00\x00\x00\xe9\x02\x00\x00\x000', b'\xbe\x00\x00\x00\x00', b'\xbc\x02\x00\x00\x00\xe9\x01\x00\x00\x00\xe9\x02\x00\x00\x00', b'\xbe\x01\x00\x00\x00\xe9\x03\x00\x00\x00', b'\xf9\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf0?', b'\xf9\x00\x00\x00\x00\x00\x00\x04@\x00\x00\x00\x00\x00\x00\xf0\xbf', b'.', b'S', b'\xdb\x02\x00\x00\x00[\x01\x00\x00\x00\xe9\x01\x00\x00\x00[\x01\x00\x00\x00r\x01\x00\x00\x00', b'\xa9\x02\xda\x01sr\x01\x00\x00\x00'])
check('loads(dumps(v)) == v', [marshal.loads(marshal.dumps(v)) == v for v in MV],
      [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])
check('versions 0-3', [marshal.dumps(T3, v) for v in range(4)],
      [b'(\x03\x00\x00\x00i\x01\x00\x00\x00u\x02\x00\x00\x00ab[\x01\x00\x00\x00f\x032.5', b'(\x03\x00\x00\x00i\x01\x00\x00\x00u\x02\x00\x00\x00ab[\x01\x00\x00\x00f\x032.5', b'(\x03\x00\x00\x00i\x01\x00\x00\x00u\x02\x00\x00\x00ab[\x01\x00\x00\x00g\x00\x00\x00\x00\x00\x00\x04@', b'\xa8\x03\x00\x00\x00\xe9\x01\x00\x00\x00\xf4\x02\x00\x00\x00ab[\x01\x00\x00\x00\xe7\x00\x00\x00\x00\x00\x00\x04@'])
