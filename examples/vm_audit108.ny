      [['a', 'a'], (1, 2), 4294967296, 1.5])
check('dump / load on files', (lambda f: (marshal.dump({'a': (1, 2)}, f), f.seek(0), marshal.load(f))[2])(io.BytesIO()),
      {'a': (1, 2)})
check('marshal errors', [err(lambda: marshal.loads(b'')), err(lambda: marshal.loads(b'\x01')), err(lambda: marshal.dumps(lambda: 0)), err(lambda: marshal.dumps(object()))],
      ['EOFError: EOF read where object expected', 'ValueError: bad marshal data (unknown type code)', 'ValueError: unmarshallable object', 'ValueError: unmarshallable object'])
check('marshal.version', marshal.version,
      4)

# ── pickletools ───────────────────────────────────────────────────────────────
def pdis(data, **kw):
    out = io.StringIO()
    pickletools.dis(data, out, **kw)
    return out.getvalue()
check('dis, protocol 2', pdis(pickle.dumps([1, 'a', (2, 3)], 2)),
      "    0: \\x80 PROTO      2\n    2: ]    EMPTY_LIST\n    3: q    BINPUT     0\n    5: (    MARK\n    6: K        BININT1    1\n    8: X        BINUNICODE 'a'\n   14: q        BINPUT     1\n   16: K        BININT1    2\n   18: K        BININT1    3\n   20: \\x86     TUPLE2\n   21: q        BINPUT     2\n   23: e        APPENDS    (MARK at 5)\n   24: .    STOP\nhighest protocol among opcodes = 2\n")
check('dis, protocol 0, annotated', pdis(pickle.dumps({'k': [1, 2]}, 0), annotate=1),
      "    0: (    MARK Push markobject onto the stack.\n    1: d        DICT       (MARK at 0) Build a dict out of the topmost stack slice, after markobject.\n    2: p    PUT        0               Store the stack top into the memo.  The stack is not popped.\n    5: V    UNICODE    'k'             Push a Python Unicode string object.\n    8: p    PUT        1               Store the stack top into the memo.  The stack is not popped.\n   11: (    MARK                       Push markobject onto the stack.\n   12: l        LIST       (MARK at 11) Build a list out of the topmost stack slice, after markobject.\n   13: p    PUT        2                Store the stack top into the memo.  The stack is not popped.\n   16: I    INT        1                Push an integer or bool.\n   19: a    APPEND                      Append an object to a list.\n   20: I    INT        2                Push an integer or bool.\n   23: a    APPEND                      Append an object to a list.\n   24: s    SETITEM                     Add a key+value pair to an existing dict.\n   25: .    STOP                        Stop the unpickling machine.\nhighest protocol among opcodes = 0\n")
check('dis, protocol 4 (frames, memoize)', pdis(pickle.dumps({'a': 'b', 'c': ['a', 'b']}, 4)),
      "    0: \\x80 PROTO      4\n    2: \\x95 FRAME      25\n   11: }    EMPTY_DICT\n   12: \\x94 MEMOIZE    (as 0)\n   13: (    MARK\n   14: \\x8c     SHORT_BINUNICODE 'a'\n   17: \\x94     MEMOIZE    (as 1)\n   18: \\x8c     SHORT_BINUNICODE 'b'\n   21: \\x94     MEMOIZE    (as 2)\n   22: \\x8c     SHORT_BINUNICODE 'c'\n   25: \\x94     MEMOIZE    (as 3)\n   26: ]        EMPTY_LIST\n   27: \\x94     MEMOIZE    (as 4)\n   28: (        MARK\n   29: h            BINGET     1\n   31: h            BINGET     2\n   33: e            APPENDS    (MARK at 28)\n   34: u        SETITEMS   (MARK at 13)\n   35: .    STOP\nhighest protocol among opcodes = 4\n")
check('dis, protocol 5 with a memo and indentlevel', pdis(pickle.dumps([b'xy', 1.5, None, True, 2**70], 5), memo={}, indentlevel=2),
      "    0: \\x80 PROTO      5\n    2: \\x95 FRAME      32\n   11: ]    EMPTY_LIST\n   12: \\x94 MEMOIZE    (as 0)\n   13: (    MARK\n   14: C      SHORT_BINBYTES b'xy'\n   18: \\x94   MEMOIZE    (as 1)\n   19: G      BINFLOAT   1.5\n   28: N      NONE\n   29: \\x88   NEWTRUE\n   30: \\x8a   LONG1      1180591620717411303424\n   41: e      APPENDS    (MARK at 13)\n   42: .    STOP\nhighest protocol among opcodes = 4\n")
check('genops', [(op.name, arg, pos) for op, arg, pos in pickletools.genops(pickle.dumps((1, 'b'), 3))],
      [('PROTO', 3, 0), ('BININT1', 1, 2), ('BINUNICODE', 'b', 4), ('BINPUT', 0, 10), ('TUPLE2', None, 12), ('BINPUT', 1, 13), ('STOP', None, 15)])
check('optimize', [pickletools.optimize(pickle.dumps([[1], [2], 'x'], p)) for p in (0, 2, 4)],
      [b'(l(lI1\naa(lI2\naaVx\na.', b'\x80\x02](]K\x01a]K\x02aX\x01\x00\x00\x00xe.', b'\x80\x04\x95\x0f\x00\x00\x00\x00\x00\x00\x00](]K\x01a]K\x02a\x8c\x01xe.'])
check('optimize keeps what is used twice', pickletools.optimize(pickle.dumps(['a', 'a'], 0)),
      b'(lVa\np0\nag0\na.')
check('optimize then loads', pickle.loads(pickletools.optimize(pickle.dumps({'r': [1, 2] * 3}, 4))),
      {'r': [1, 2, 1, 2, 1, 2]})
check('dis errors', [err(lambda: pdis(b'(l')), err(lambda: pdis(b'\xff'))],
      ['ValueError: pickle exhausted before seeing STOP', "ValueError: at position 0, opcode b'\\xff' unknown"])
check('opcode table', [len(pickletools.opcodes), pickletools.code2op['('].name, pickletools.code2op['.'].doc.splitlines()[0]],
      [68, 'MARK', 'Stop the unpickling machine.'])

# ── pydoc ─────────────────────────────────────────────────────────────────────
class Doc1:
    """A class.

    More text."""
    x = 1
    def m(self, y):
        "Method m."
        return y
    @classmethod
    def cm(cls):
        pass
    @staticmethod
    def sm(a):
        pass
    @property
    def p(self):
        "A property."
        return 1

def doc_f(a, b=1):
    """Doc line.

    Second paragraph."""
    return a

doc_class = pydoc.render_doc(Doc1, renderer=pydoc.plaintext)
doc_buf = io.StringIO()
pydoc.doc(doc_f, output=doc_buf)
if PY312:
    check('render_doc of a function', pydoc.render_doc(doc_f, renderer=pydoc.plaintext),
          'Python Library Documentation: function doc_f in module __main__\n\ndoc_f(a, b=1)\n    Doc line.\n\n    Second paragraph.\n')
check('render_doc of a class: its parts', [s in doc_class for s in ['Python Library Documentation: class Doc1 in module __main__', 'class Doc1(builtins.object)', ' |  A class.', ' |  More text.', ' |  Methods defined here:', ' |  m(self, y)', ' |      Method m.', ' |  Class methods defined here:', ' |  cm()', ' |  Static methods defined here:', ' |  sm(a)', ' |  Readonly properties defined here:', ' |  p', ' |      A property.', ' |  Data and other attributes defined here:', ' |  x = 1']],
      [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])
if PY312:
    check('doc(output=)', doc_buf.getvalue(),
          'Python Library Documentation: function doc_f in module __main__\n\ndoc_f(a, b=1)\n    Doc line.\n\n    Second paragraph.\n')
check('getdoc', [pydoc.getdoc(Doc1), pydoc.getdoc(doc_f), pydoc.getdoc(Doc1.m)],
      ['A class.\n\nMore text.', 'Doc line.\n\nSecond paragraph.', 'Method m.'])
check('describe', [pydoc.describe(doc_f), pydoc.describe(Doc1), pydoc.describe(len), pydoc.describe(pydoc), pydoc.describe(Doc1().m), pydoc.describe(5)],
      ['function doc_f', 'class Doc1', 'built-in function len', 'module pydoc', 'method m', 'int'])
check('plain / bold', [pydoc.plain('a\bab\bb'), pydoc.text.bold('ab'), pydoc.plaintext.bold('ab')],
      ['ab', 'a\x08ab\x08b', 'ab'])
check('locate', [pydoc.locate('os.path.join') is os.path.join, pydoc.locate('no_such_module_xyz.thing'), pydoc.locate('pydoc.TextDoc') is pydoc.TextDoc],
      [True, None, True])
check('splitdoc / cram / stripid / replace', [pydoc.splitdoc(pydoc.getdoc(doc_f)), pydoc.cram('abcdefghij', 7), pydoc.stripid('<f at 0x7f00deadbeef>'), pydoc.replace('a-b-c', '-', '+')],
      [('Doc line.', 'Second paragraph.'), 'ab...ij', '<f>', 'a+b+c'])
check('render_doc of an instance documents its class', pydoc.render_doc(Doc1(), renderer=pydoc.plaintext).splitlines()[0],
      'Python Library Documentation: Doc1 in module __main__ object')
check('render_doc of a name that is not there', err(lambda: pydoc.render_doc('no_such_module_xyz')),
      "ImportError: No Python documentation found for 'no_such_module_xyz'.\nUse help() to get the interactive help utility.\nUse help(str) for help on the str class.")
check('TextDoc.indent / section', [pydoc.text.indent('a\nb'), pydoc.plaintext.section('T', 'x\ny')],
      ['    a\n    b', 'T\n    x\n    y\n\n'])

# ── pyclbr / tabnanny / py_compile / compileall / modulefinder ─────────────────
tmpfile("va108_clbr.py", "import os\n\nclass K(object):\n    def meth(self, q):\n        return q\n\n    @staticmethod\n    def s():\n        pass\n\nclass L(K):\n    pass\n\ndef top(z):\n    def inner():\n        pass\n    return inner\n")
clbr = pyclbr.readmodule_ex("va108_clbr", [TMP])
tmpfile("va108_tabs.py", "if 1:\n\tx = 1\n        y = 2\n")
def nanny():
    with open(os.path.join(TMP, "va108_tabs.py")) as fh:
        try:
            tabnanny.process_tokens(tokenize.generate_tokens(fh.readline))
        except tabnanny.NannyNag as nag:
            return [nag.get_lineno(), nag.get_msg(), nag.get_line()]
    return "no nag"
good_py = tmpfile("va108_good.py", "def ok():\n    return 1\n")
bad_py = tmpfile("va108_bad.py", "def (:\n")
def pyc_error():
    try:
        py_compile.compile(bad_py, doraise=True)
    except py_compile.PyCompileError as e:
        return [type(e.exc_value).__name__, e.file == bad_py]
    return "no error"
os.mkdir(os.path.join(TMP, "okdir"))
with open(os.path.join(TMP, "okdir", "m1.py"), "w") as fh:
    fh.write("x = 1\n")
tmpfile("va108_mfmod.py", "import va108_good\n")
mf_script = tmpfile("va108_script.py", "import va108_mfmod\nimport va108_missing_xyz\n")
mf = modulefinder.ModuleFinder(path=[TMP] + sys.path)
mf.run_script(mf_script)
check('pyclbr names and kinds', [(n, type(clbr[n]).__name__) for n in sorted(clbr)],
      [('K', 'Class'), ('L', 'Class'), ('top', 'Function')])
check('pyclbr class', [clbr['K'].name, clbr['K'].module, clbr['K'].lineno, clbr['K'].end_lineno, sorted(clbr['K'].methods.items()), clbr['K'].super, clbr['L'].super[0] is clbr['K']],
      ['K', 'va108_clbr', 3, 9, [('meth', 4), ('s', 8)], ['object'], True])
check('pyclbr function and nesting', [clbr['top'].lineno, clbr['top'].end_lineno, sorted(clbr['top'].children), clbr['top'].children['inner'].parent is clbr['top']],
      [14, 17, ['inner'], True])
check('pyclbr.readmodule (classes only)', sorted(pyclbr.readmodule('va108_clbr', [TMP])),
      ['K', 'L'])
if PY312:
    check("tabnanny: inconsistent tabs (3.12's message)", nanny(),
          [3, 'inconsistent use of tabs and spaces in indentation', '        y = 2'])
check('tabnanny: the line', nanny()[0],
      3)
check('py_compile.compile of a good file', (lambda c: [c.endswith('.pyc'), os.path.basename(os.path.dirname(c))])(py_compile.compile(good_py, doraise=True)),
      [True, '__pycache__'])
check('py_compile.compile of a bad file', pyc_error(),
      ['SyntaxError', True])
check('compileall', [bool(compileall.compile_dir(os.path.join(TMP, 'okdir'), quiet=2)), bool(compileall.compile_file(good_py, quiet=2)), bool(compileall.compile_file(bad_py, quiet=2))],
      [True, True, False])
check('modulefinder', [sorted(k for k in mf.modules if k.startswith('va108') or k == '__main__'), 'va108_missing_xyz' in mf.badmodules, mf.modules['va108_mfmod'].__file__ == os.path.join(TMP, 'va108_mfmod.py')],
      [['__main__', 'va108_good', 'va108_mfmod'], True, True])

# ── this ──────────────────────────────────────────────────────────────────────
zen_out = io.StringIO()
with contextlib.redirect_stdout(zen_out):
    import this
check('import this', [zen_out.getvalue().splitlines()[0], len(zen_out.getvalue().splitlines()), ''.join(this.d.get(c, c) for c in this.s) == zen_out.getvalue().rstrip('\n')],
      ['The Zen of Python, by Tim Peters', 21, True])

# ── a statement's line is where it starts, multi-line strings too ─────────────
traced = []
def tracer(frame, event, arg):
    if event == "line" and frame.f_code.co_name == "ml_lines":
        traced.append(frame.f_lineno - frame.f_code.co_firstlineno)
    return tracer
def ml_lines():
    s = """one
two"""
    t = len("""a
b""")
    return s, t
sys.settrace(tracer)
ml_lines()
sys.settrace(None)
def ml_raise():
    raise ValueError("""first
second""")
def ml_where():
    try:
        ml_raise()
    except ValueError as e:
        tb = e.__traceback__
        while tb.tb_next:
            tb = tb.tb_next
        return tb.tb_lineno - ml_raise.__code__.co_firstlineno
check('line events of statements holding multi-line strings', traced,
      [1, 3, 5])
check("a traceback's line for a raise of a multi-line string", ml_where(),
      1)

# ── Nython only: dis and opcode over Nython's VM bytecode ─────────────────────
if nython:
    ENGINE = gc_stats()["engine"]
    def g108(a):
        return a + 1
    def loop108(n):
        t = 0
        for i in range(n):
            t = t + i
        return t
    class M108:
        def meth(self, y):
            def inner():
                return y
            return inner
    check("opcode: the VM's own instruction set", [len(opcode.opname), opcode.opname[0], opcode.opmap["LOAD_CONST"],
          opcode.opname[255], "LOAD_NAME_FAST" in opcode._specializations["LOAD_NAME"], dis.deoptmap["BINARY_ADD_NUM"]],
          [256, "LOAD_CONST", 0, "<255>", True, "BINARY_ADD"])
    check("opcode.stack_effect of Nython's instructions",
          [opcode.stack_effect(opcode.opmap["BUILD_LIST"], 3), opcode.stack_effect(opcode.opmap["LOAD_NAME"]),
           err(lambda: opcode.stack_effect(opcode.opmap["BUILD_LIST"])), err(lambda: opcode.stack_effect(opcode.opmap["LOAD_NAME_FAST"]))],
          [-2, 1, "ValueError: stack_effect: opcode requires oparg but oparg was not specified", "ValueError: invalid opcode or oparg"])
    G = g108.__code__.co_firstlineno
    check("get_instructions", [(i.opname, i.arg, i.argrepr, i.offset, i.starts_line) for i in dis.get_instructions(g108)],
          [("LOAD_NAME", 0, "a", 0, G + 1), ("LOAD_CONST", 0, "1", 1, None), ("BINARY_ADD", None, "", 2, None),
           ("RETURN_VALUE", None, "", 3, None), ("LOAD_CONST", 1, "None", 4, G), ("RETURN_VALUE", None, "", 5, None)])
    check("Instruction details", (lambda i: [i.opcode == opcode.opmap["LOAD_NAME"], i.argval, i.is_jump_target, i.positions.lineno, i.positions.col_offset])(
          list(dis.get_instructions(g108))[0]), [True, "a", False, G + 1, None])
    L = loop108.__code__.co_firstlineno
    loop_ins = list(dis.get_instructions(loop108))
    check("jumps and their targets", [(i.opname, i.argrepr) for i in loop_ins if i.opname.startswith("JUMP") or i.opname.startswith("FOR")]
          + [i.offset for i in loop_ins if i.is_jump_target],
          [("FOR_PREP", "range, 1 argument"), ("FOR_ITER", "to 12"), ("JUMP_ABSOLUTE", "to 5")] + [5, 12])
    check("findlinestarts (the loop's jump back is the for line's)", list(dis.findlinestarts(loop108)),
          [(0, L + 1), (2, L + 2), (7, L + 3), (11, L + 2), (12, L + 4), (14, L)])
    check("co_varnames: parameters, then the other locals", [dis.Bytecode(loop108).codeobj.co_varnames, dis.Bytecode(hfun).codeobj.co_nlocals],
          [("n", "t", "i"), 3])
    check("dis() text", dis.Bytecode(g108).dis(),
          "%3d           0 LOAD_NAME                0 (a)\n              1 LOAD_CONST               0 (1)\n" % (G + 1)
          + "              2 BINARY_ADD\n              3 RETURN_VALUE\n\n"
          + "%3d           4 LOAD_CONST               1 (None)\n              5 RETURN_VALUE\n" % G)
    check("code_info", [ln for ln in dis.code_info(g108).splitlines() if not ln.startswith("Filename")],
          ["Name:              g108", "Argument count:    1", "Positional-only arguments: 0", "Kw-only arguments: 0",
           "Number of locals:  1", "Stack size:        2", "Flags:             OPTIMIZED, NEWLOCALS", "Constants:",
           "   0: 1", "   1: None", "Names:", "   0: a", "Variable names:", "   0: a"])
    mbuf = io.StringIO()
    dis.dis(M108, file=mbuf)
    check("dis of a class names the method and its nested code",
          [mbuf.getvalue().startswith("Disassembly of meth:\n"), "MAKE_FUNCTION" in mbuf.getvalue(), "(code object inner)" in mbuf.getvalue(),
           "Disassembly of <code object inner at 0x" in mbuf.getvalue()], [True, True, True, True])
    mcode = dis.Bytecode(M108.meth).codeobj
    check("a method's code object", [mcode.co_name, mcode.co_qualname, mcode.co_varnames, mcode.co_argcount, [type(c).__name__ for c in mcode.co_consts][-1]],
          ["meth", "M108.meth", ("self", "y", "inner"), 2, "_NyVMCode"])
    sbuf = io.StringIO()
    dis.dis("a = b + 1", file=sbuf)
    check("dis of source text", sbuf.getvalue(),
          "  1           0 LOAD_NAME                0 (b)\n              1 LOAD_CONST               0 (1)\n"
          + "              2 BINARY_ADD\n              3 STORE_NAME               1 (a)\n              4 HALT\n")
    check("dis of a code object from compile()", [i.opname for i in dis.get_instructions(compile("x = 2", "<c>", "exec"))],
          ["LOAD_CONST", "STORE_NAME", "HALT"])
    check("dis of f.__code__ (compiled again from the file)", [i.opname for i in dis.get_instructions(g108.__code__)],
          [i.opname for i in dis.get_instructions(g108)])
    check("co_code: two bytes per instruction", (lambda c: [len(c), c[0] == opcode.opmap["LOAD_NAME"], [i.opname for i in dis.get_instructions(dis.Bytecode(g108).codeobj)][:2]])(
          dis.Bytecode(g108).codeobj.co_code), [12, True, ["LOAD_NAME", "LOAD_CONST"]])
    for k in range(60):
        loop108(5)
    adaptive = [i.opname for i in dis.get_instructions(loop108, adaptive=True)]
    generic = [i.opname for i in dis.get_instructions(loop108)]
    if ENGINE == "vm" and os.environ.get("NY_QUICKEN", "1") != "0":
        # the VM's own running code: hot instructions have specialized
        check("adaptive=True shows the specialized instructions (VM)",
              [adaptive != generic, "FOR_ITER_RANGE" in adaptive, "BINARY_ADD_NUM" in adaptive, "LOAD_NAME_FAST" in adaptive,
               [dis.deoptmap.get(n, n) for n in adaptive] == generic],
              [True, True, True, True, True])
    else:
        # the interpreter's code is compiled for the purpose (nothing has
        # run it); NY_QUICKEN=0 keeps the VM from specializing
        check("adaptive=True is the compiled form (interpreter, NY_QUICKEN=0)", adaptive == generic, True)
    check("the exception table names the clauses",
          (lambda out: ["ExceptionTable:" in out, "[except ValueError as e]" in out, "[finally]" in out])(
          dis.Bytecode(compile("try:\n    a\nexcept ValueError as e:\n    b\nfinally:\n    c\n", "<t>", "exec")).dis()),
          [True, True, True])
    # antigravity: headless, it opens nothing
    ag_out = io.StringIO()
    with contextlib.redirect_stdout(ag_out):
        import antigravity
        antigravity.geohash(37.421542, -122.085589, b"2005-05-26-10458.68")
    check("antigravity (headless) and its geohash", ag_out.getvalue(), "37.857713 -122.544543\n")

shutil.rmtree(TMP, ignore_errors=True)

for r in results:
    if r[1]:
        pass_n = pass_n + 1
    else:
        fail_n = fail_n + 1
        print("FAIL " + r[0] + ": got " + repr(r[2]) + " want " + repr(r[3]))
print("Results: " + str(pass_n) + " passed, " + str(fail_n) + " failed")
if fail_n == 0:
    print("=== VM_AUDIT108 PASSED ===")
