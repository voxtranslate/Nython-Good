hm.set_cell(0, 0, 5.0)
hm.set_cell(3, 2, 10.0)
hm.set_cell(6, 3, 8.0)
assert_eq("max val", hm.max_val, 10.0)
hm.set_col_labels(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"])
hm.set_row_labels(["W1", "W2", "W3", "W4"])
