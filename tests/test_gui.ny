# ─── AnimatedCounter ──────────────────────────────────────────────────────────
section("AnimatedCounter")
var ac = AnimatedCounter(10, 10, 200, 100, "Total Revenue")
assert_eq("label", ac.label, "Total Revenue")
assert_eq("target init", ac.target, 0.0)
assert_eq("history init", ac.history_count, 0)
ac.set_prefix("$")
assert_eq("prefix", ac.prefix, "$")
ac.set_suffix(" USD")
assert_eq("suffix", ac.suffix, " USD")
ac.set_decimals(2)
assert_eq("decimals", ac.decimals, 2)
ac.set_value(1000000.0)
assert_eq("target", ac.target, 1000000.0)
assert_eq("delta", ac.delta, 1000000.0)
assert_eq("history 1", ac.history_count, 1)
ac.set_value(1250000.0)
assert_eq("delta 2", ac.delta, 250000.0)
assert_eq("history 2", ac.history_count, 2)
var fmt = ac._format(1234567.0)
assert_true("comma format", string_contains(fmt, ","))
assert_true("has prefix", string_startswith(fmt, "$"))
ac.update()
assert_true("display advances", ac.display > 0.0)
var overflow_counter = AnimatedCounter(0, 0, 200, 100, "test")
overflow_counter.history_max = 5
var oi = 0
while oi < 8:
    overflow_counter.set_value(float(oi * 10))
    oi = oi + 1
assert_eq("history capped", overflow_counter.history_count, 5)
ac.set_pos(20, 20)
assert_eq("pos x", ac.rect.x, 20)
ac.set_size(280, 120)
assert_eq("size h", ac.rect.h, 120)
ac.hide()
assert_eq("hidden", ac.visible, false)
ac.show()

