assert_eq("kind", aci.kind, "function")
assert_eq("icon", aci.icon, "ƒ")
assert_eq("score init", aci.score, 0)

# ─── AutoComplete ─────────────────────────────────────────────────────────────
section("AutoComplete")
var ac2 = AutoComplete(280)
assert_eq("w", ac2.w, 280)
assert_eq("visible init", ac2.visible, false)
assert_eq("item_count init", ac2.item_count, 0)
ac2.register("print", "print(v)", "function", "ƒ")
ac2.register("println", "println(v)", "function", "ƒ")
ac2.register("class", "", "keyword", "K")
ac2.register("var", "", "keyword", "K")
ac2.register("def", "", "keyword", "K")
ac2.register("Panel", "class Panel", "class", "C")
assert_eq("item_count", ac2.item_count, 6)
ac2.show_at(100, 200, "pr")
assert_eq("visible", ac2.visible, true)
assert_eq("query", ac2.query, "pr")
assert_true("filtered pr", ac2.filtered_count >= 2)
ac2.update_query("print")
assert_eq("exact match", ac2.filtered_count, 2)
ac2.update_query("")
assert_eq("empty query all", ac2.filtered_count, 6)
var accepted = ""
def on_ac_accept(item):
    accepted = item.label
ac2.on_accept(on_ac_accept)
ac2.selected = 0
ac2.accept()
assert_eq("accepted", accepted, "print")
assert_eq("hidden after accept", ac2.visible, false)
ac2.show_at(100, 200, "")
ac2.update()
assert_true("anim advances", ac2.anim_y < float(ac2.item_h * 2))
var dismissed = false
def on_ac_dismiss():
    dismissed = true
ac2.on_dismiss(on_ac_dismiss)
ac2.hide()
assert_eq("dismissed", dismissed, true)
var kc = ac2._kind_color("function")
assert_eq("function color r", kc.r, 99)
var kc2 = ac2._kind_color("class")
assert_eq("class color r", kc2.r, 220)

