# ─── Confetti ─────────────────────────────────────────────────────────────────
section("Confetti")
var conf = Confetti(1280, 720)
assert_eq("active init", conf.active, false)
assert_eq("particle_count init", conf.particle_count, 0)
assert_eq("color_count", conf.color_count, 7)
conf.burst(640, 360, 30)
assert_eq("burst active", conf.active, true)
assert_eq("burst count", conf.particle_count, 30)
conf.update()
assert_true("particles moved", conf.particles[0].y != 360.0)
var conf2 = Confetti(1280, 720)
conf2.rain(20)
assert_eq("rain active", conf2.active, true)
assert_eq("rain count", conf2.particle_count, 20)
