# ─── Toast / ToastManager ─────────────────────────────────────────────────────
section("Toast")
var t = Toast("Saved!", "success", 3000)
assert_eq("message", t.message, "Saved!")
assert_eq("type", t.type, "success")
assert_true("not expired", not t.is_expired())

section("ToastManager")
var tm = ToastManager(800)
tm.success("Saved!")
tm.error("Failed!")
tm.warning("Watch out!")
tm.info("FYI")
assert_eq("count", tm.count, 4)

# ─── Dropdown ─────────────────────────────────────────────────────────────────
section("Dropdown")
var dd = Dropdown(10, 10, 200, 36)
dd.add_item("Option A", "a")
dd.add_item("Option B", "b")
dd.add_item("Option C", "c")
assert_eq("item count", dd.item_count, 3)
dd.select(1)
assert_eq("selected", dd.selected, 1)
assert_eq("get_label", dd.get_label(), "Option B")
assert_eq("get_value", dd.get_value(), "b")
dd.select_by_value("c")
assert_eq("select_by_value", dd.selected, 2)
dd.set_placeholder("Choose...")
assert_eq("placeholder", dd.placeholder, "Choose...")
dd.clear_items()
assert_eq("cleared", dd.item_count, 0)
dd.hide()
assert_eq("hidden", dd.visible, false)
dd.show()
dd.disable()
assert_eq("disabled", dd.enabled, false)
dd.enable()

# ─── Switch ───────────────────────────────────────────────────────────────────
section("Switch")
var sw = Switch(10, 10, "Dark mode")
assert_eq("label", sw.label, "Dark mode")
assert_eq("checked init", sw.checked, false)
sw.toggle()
assert_eq("toggled", sw.checked, true)
sw.toggle()
assert_eq("toggled back", sw.checked, false)
sw.set_checked(true)
assert_eq("set_checked", sw.checked, true)
var sw_changed = false
def on_sw_change(e):
    sw_changed = true
sw.on("change", on_sw_change)
var sce = Event("change")
sw.emit(sce)
assert_true("sw changed", sw_changed)

# ─── RadioButton / RadioGroup ─────────────────────────────────────────────────
section("RadioButton")
var rb1 = RadioButton(10, 10, "Small", "size", "sm")
var rb2 = RadioButton(10, 40, "Medium", "size", "md")
var rb3 = RadioButton(10, 70, "Large", "size", "lg")
assert_eq("rb1 label", rb1.label, "Small")
assert_eq("rb1 value", rb1.value, "sm")
assert_eq("rb1 not selected", rb1.selected, false)
rb1.set_selected(true)
assert_eq("rb1 selected", rb1.selected, true)

section("RadioGroup")
var rg = RadioGroup("size")
rg.add(rb1)
rg.add(rb2)
rg.add(rb3)
assert_eq("count", rg.count, 3)
rg.select("md")
assert_eq("value", rg.get_value(), "md")
assert_eq("rb2 selected", rb2.selected, true)
assert_eq("rb1 deselected", rb1.selected, false)
var rg_changed = false
def on_rg_change(v):
    rg_changed = true
rg.on_change(on_rg_change)
rg.select("lg")
assert_eq("rg value lg", rg.get_value(), "lg")
assert_eq("rb3 selected", rb3.selected, true)

# ─── NumberInput ──────────────────────────────────────────────────────────────
section("NumberInput")
var ni = NumberInput(10, 10, 120, 36, 0.0, 100.0, 1.0)
assert_eq("value init", ni.value, 0.0)
ni.set_value(50.0)
assert_eq("set_value", ni.value, 50.0)
ni.increment()
assert_eq("incremented", ni.value, 51.0)
ni.decrement()
assert_eq("decremented", ni.value, 50.0)
ni.set_value(105.0)
assert_eq("clamped max", ni.value, 100.0)
ni.set_value(-5.0)
assert_eq("clamped min", ni.value, 0.0)
ni.disable()
assert_eq("disabled", ni.enabled, false)
ni.enable()

# ─── TextArea ─────────────────────────────────────────────────────────────────
section("TextArea")
var ta = TextArea(10, 10, 300, 120, "Write here...")
assert_eq("placeholder", ta.placeholder, "Write here...")
assert_eq("value init", ta.value, "")
ta.set_value("Hello\nWorld\nFoo")
assert_eq("line count", ta.line_count(), 3)
ta.set_value("Hello\nWorld\nFoo\nBar")
assert_eq("appended", ta.line_count(), 4)
ta.clear()
assert_eq("cleared", ta.value, "")
assert_eq("cleared lines", ta.line_count(), 1)
ta.disable()
assert_eq("readonly via disable", ta.enabled, false)
ta.enable()

