# ─── Form ─────────────────────────────────────────────────────────────────────
section("Form")
var frm = Form(10, 10, 400)
var name_input = TextInput(0, 0, 380, 36, "Full name")
var email_input = TextInput(0, 0, 380, 36, "Email")
var age_input = NumberInput(0, 0, 120, 36, 0.0, 150.0, 1.0)
frm.add_field("name", "Name", name_input)
frm.add_field("email", "Email", email_input)
frm.add_field("age", "Age", age_input)
assert_eq("field count", frm.field_count, 3)
frm.set_required("name")
frm.set_required("email")
name_input.value = "Alice"
email_input.value = "alice@example.com"
age_input.value = 30.0
assert_true("valid", frm.validate())
name_input.value = ""
assert_true("invalid when empty", not frm.validate())
name_input.value = "Alice"
var vals = frm.get_values()
assert_eq("get name", vals["name"], "Alice")
frm.reset()
assert_eq("reset name", frm.get_value("name"), "")

# ─── DataTable ────────────────────────────────────────────────────────────────
section("DataTable")
var dt = DataTable(0, 0, 600, 300)
dt.add_column("id", "ID", 60)
dt.add_column("name", "Name", 200)
dt.add_column("role", "Role", 120)
assert_eq("col count", dt.col_count, 3)
var r1 = {}
r1["id"] = 1
r1["name"] = "Alice"
r1["role"] = "Admin"
var r2 = {}
r2["id"] = 2
r2["name"] = "Bob"
r2["role"] = "User"
var r3 = {}
r3["id"] = 3
r3["name"] = "Carol"
r3["role"] = "Editor"
dt.add_row(r1)
dt.add_row(r2)
dt.add_row(r3)
assert_eq("row count", dt.row_count, 3)
var sel_data = none
def on_dt_select(row):
    sel_data = row
dt.on_select(on_dt_select)
dt.clear_rows()
assert_eq("cleared", dt.row_count, 0)
var rows = [r1, r2, r3]
dt.set_data(rows)
assert_eq("set_data", dt.row_count, 3)

# ─── Accordion ────────────────────────────────────────────────────────────────
section("Accordion")
var acc = Accordion(0, 0, 500)
var pA = Panel(0, 0, 500, 100)
var pB = Panel(0, 0, 500, 150)
var pC = Panel(0, 0, 500, 80)
acc.add("Section A", pA)
acc.add("Section B", pB)
acc.add("Section C", pC)
assert_eq("count", acc.count, 3)
assert_eq("all collapsed", acc.items[0].expanded, false)
acc.expand(1)
assert_eq("section B expanded", acc.items[1].expanded, true)
assert_eq("section A not expanded", acc.items[0].expanded, false)
acc.expand(2)
assert_eq("C expanded", acc.items[2].expanded, true)
assert_eq("B collapsed after single", acc.items[1].expanded, false)
acc.allow_multiple = true
acc.expand(0)
acc.expand(1)
assert_eq("multi A", acc.items[0].expanded, true)
assert_eq("multi B", acc.items[1].expanded, true)
acc.collapse(0)
assert_eq("collapsed A", acc.items[0].expanded, false)
acc.collapse_all()
assert_eq("all collapsed", acc.items[2].expanded, false)
acc.set_pos(10, 20)
assert_eq("set_pos x", acc.x, 10)
acc.hide()
assert_eq("hidden", acc.visible, false)
acc.show()
assert_eq("shown", acc.visible, true)

# ─── RangeSlider ──────────────────────────────────────────────────────────────
section("RangeSlider")
var rs = RangeSlider(10, 10, 300, 0.0, 100.0, 20.0, 80.0)
assert_eq("min", rs.min_val, 0.0)
assert_eq("max", rs.max_val, 100.0)
assert_eq("low", rs.low, 20.0)
assert_eq("high", rs.high, 80.0)
assert_eq("span", rs.span(), 60.0)
rs.set_low(30.0)
assert_eq("set_low", rs.low, 30.0)
rs.set_high(70.0)
assert_eq("set_high", rs.high, 70.0)
rs.set_range(10.0, 90.0)
assert_eq("range low", rs.low, 10.0)
assert_eq("range high", rs.high, 90.0)
rs.set_low(-10.0)
assert_eq("low clamped to min", rs.low, 0.0)
rs.set_high(200.0)
assert_eq("high clamped to max", rs.high, 100.0)
rs.set_high(50.0)
rs.set_low(60.0)
assert_eq("low clamped to high", rs.low, 50.0)
var rs_changed = false
def on_rs_change(e):
    rs_changed = true
rs.on("change", on_rs_change)
rs.set_pos(20, 30)
assert_eq("pos x", rs.rect.x, 20)
rs.set_size(400, 24)
assert_eq("size w", rs.rect.w, 400)
rs.hide()
assert_eq("hidden", rs.visible, false)
rs.show()
rs.disable()
assert_eq("disabled", rs.enabled, false)
rs.enable()
assert_eq("enabled", rs.enabled, true)

# ─── TreeNode / TreeView ──────────────────────────────────────────────────────
section("TreeNode")
var root = TreeNode("Root", "root")
var child1 = TreeNode("Child 1", "c1")
var child2 = TreeNode("Child 2", "c2")
var grandchild = TreeNode("Grandchild", "gc1")
root.add_child(child1)
root.add_child(child2)
child1.add_child(grandchild)
assert_eq("root children", root.child_count, 2)
assert_eq("child1 children", child1.child_count, 1)
assert_eq("grandchild depth", grandchild.depth, 2)
assert_eq("child depth", child1.depth, 1)
assert_true("root has children", root.has_children())
assert_true("child1 has children", child1.has_children())
assert_true("child2 no children", not child2.has_children())
root.expand()
assert_eq("expanded", root.expanded, true)
root.collapse()
assert_eq("collapsed", root.expanded, false)
root.toggle()
assert_eq("toggled", root.expanded, true)
var found = root.find("gc1")
assert_true("found gc1", found != none)
assert_eq("found label", found.label, "Grandchild")
var not_found = root.find("zzz")
assert_eq("not found", not_found, none)

section("TreeView")
var tv = TreeView(0, 0, 300, 400)
tv.add_root(root)
assert_eq("root count", tv.root_count, 1)
var select_called = false
def on_tv_select(node):
    select_called = true
tv.on_select(on_tv_select)
tv.select("c2")
assert_true("selected", tv.selected != none)
assert_eq("selected label", tv.selected.label, "Child 2")
var found2 = tv.find("gc1")
assert_true("tv find", found2 != none)
tv.set_pos(10, 10)
assert_eq("pos x", tv.rect.x, 10)
tv.set_size(400, 500)
assert_eq("size h", tv.rect.h, 500)
tv.hide()
assert_eq("hidden", tv.visible, false)
tv.show()

# ─── TagInput ─────────────────────────────────────────────────────────────────
section("TagInput")
var tagi = TagInput(10, 10, 300, 40, "Add tags...")
assert_eq("placeholder", tagi.placeholder, "Add tags...")
assert_eq("tag count init", tagi.tag_count, 0)
assert_true("add python", tagi.add_tag("python"))
assert_true("add nython", tagi.add_tag("nython"))
assert_true("add ai", tagi.add_tag("ai"))
assert_eq("tag count", tagi.tag_count, 3)
assert_true("has python", tagi.has_tag("python"))
assert_true("no ruby", not tagi.has_tag("ruby"))
assert_true("no dup", not tagi.add_tag("python"))
assert_eq("no dup count", tagi.tag_count, 3)
tagi.remove_tag("nython")
assert_eq("removed", tagi.tag_count, 2)
assert_true("nython gone", not tagi.has_tag("nython"))
tagi.add_tag("ml")
tagi.remove_last()
assert_eq("remove last", tagi.tag_count, 2)
tagi.clear()
assert_eq("cleared", tagi.tag_count, 0)
tagi.disable()
assert_eq("disabled", tagi.enabled, false)
tagi.enable()
var tag_added = false
def on_tag_add(e):
    tag_added = true
tagi.on("add", on_tag_add)
tagi.add_tag("test")
assert_true("add event", tag_added)

