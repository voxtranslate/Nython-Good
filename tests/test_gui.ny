# ─── AudioWaveform ────────────────────────────────────────────────────────────
section("AudioWaveform")
var aw = AudioWaveform(10, 10, 400, 80)
assert_eq("sample count init", aw.sample_count, 0)
assert_eq("playhead init", aw.playhead, 0.0)
assert_eq("playing init", aw.playing, false)
var samples = []
var awi = 0
while awi < 100:
    samples = samples + [float((awi % 10 + 1)) / 10.0]
    awi = awi + 1
aw.set_samples(samples)
assert_eq("sample count", aw.sample_count, 100)
aw.set_playhead(0.5)
assert_eq("playhead", aw.playhead, 0.5)
aw.set_playhead(-0.1)
assert_eq("clamped low", aw.playhead, 0.0)
aw.set_playhead(1.5)
assert_eq("clamped high", aw.playhead, 1.0)
aw.set_time_display("1:23", "4:56")
assert_eq("current", aw.current_str, "1:23")
assert_eq("duration", aw.duration_str, "4:56")
aw.set_title("Track 01")
assert_eq("title", aw.title, "Track 01")
aw.play()
assert_eq("playing", aw.playing, true)
aw.pause()
assert_eq("paused", aw.playing, false)
aw.update()
assert_true("anim advances", aw.anim_t > 0.0)
var seek_val = -1.0
def on_seek(t):
    seek_val = t
aw.on_seek(on_seek)
aw.set_pos(20, 20)
assert_eq("pos x", aw.rect.x, 20)
aw.set_size(600, 100)
assert_eq("size w", aw.rect.w, 600)
aw.hide()
assert_eq("hidden", aw.visible, false)
aw.show()
assert_eq("aw type", type(aw), "AudioWaveform")

# ─── Spotlight ────────────────────────────────────────────────────────────────
section("Spotlight")
var sp = Spotlight(1280, 800)
assert_eq("visible init", sp.visible, false)
assert_eq("item count init", sp.item_count, 0)
sp.register("new-file", "New File", "File", "📄", "Ctrl+N")
sp.register("save", "Save", "File", "💾", "Ctrl+S")
sp.register("open", "Open", "File", "📂", "Ctrl+O")
sp.register("undo", "Undo", "Edit", "↩", "Ctrl+Z")
sp.register("redo", "Redo", "Edit", "↪", "Ctrl+Y")
sp.register("settings", "Settings", "App", "⚙", "Ctrl+,")
assert_eq("item count", sp.item_count, 6)
sp.open()
assert_eq("opened", sp.visible, true)
assert_eq("query cleared", sp.query, "")
assert_eq("all results", sp.result_count, 6)
sp.query = "fil"
sp._refresh()
assert_true("filtered results", sp.result_count > 0)
assert_true("filtered less than total", sp.result_count < 6)
sp.query = ""
sp._refresh()
assert_eq("all results again", sp.result_count, 6)
sp.close()
assert_eq("closed", sp.visible, false)
sp.toggle()
assert_eq("toggled open", sp.visible, true)
sp.toggle()
assert_eq("toggled closed", sp.visible, false)
var selected_id = ""
def on_sp_select(item):
    selected_id = item.id
sp.on_select(on_sp_select)
sp.open()
sp.selected = 0
sp._execute()
assert_eq("executed", sp.visible, false)
assert_eq("recents", sp.recent_count, 1)
var item1 = sp.items[0]
assert_true("item matches empty", item1.matches(""))
assert_true("item matches label", item1.matches("new"))
assert_true("item matches category", item1.matches("file"))
assert_true("item no match", not item1.matches("xyz"))

