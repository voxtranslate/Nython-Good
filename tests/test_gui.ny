# ─── Pagination ───────────────────────────────────────────────────────────────
section("Pagination")
var pg = Pagination(10, 10, 20)
assert_eq("total", pg.total_pages, 20)
assert_eq("current init", pg.current_page, 1)
pg.next()
assert_eq("next", pg.current_page, 2)
pg.next()
assert_eq("next2", pg.current_page, 3)
pg.prev()
assert_eq("prev", pg.current_page, 2)
pg.last()
assert_eq("last", pg.current_page, 20)
pg.first()
assert_eq("first", pg.current_page, 1)
pg.go_to(10)
assert_eq("go_to", pg.current_page, 10)
pg.go_to(25)
assert_eq("go_to clamped", pg.current_page, 20)
pg.go_to(0)
assert_eq("go_to min", pg.current_page, 1)
assert_true("has_next", pg.has_next())
pg.last()
assert_true("no next", not pg.has_next())
pg.first()
assert_true("no prev", not pg.has_prev())
var pg_changed = 0
def on_pg_change(p):
    pg_changed = p
pg.on_change(on_pg_change)
pg.go_to(5)
assert_eq("callback", pg_changed, 5)
pg.set_total(50)
assert_eq("set_total", pg.total_pages, 50)
pg.set_pos(20, 20)
assert_eq("pos x", pg.x, 20)

# ─── Stepper ──────────────────────────────────────────────────────────────────
section("Stepper")
var stp = Stepper(0, 0, 600, 80, "horizontal")
stp.add_step("Account", "Create your account")
stp.add_step("Profile", "Set up profile")
stp.add_step("Payment", "Add payment")
stp.add_step("Confirm", "Review and submit")
assert_eq("step count", stp.step_count, 4)
assert_eq("current init", stp.current, 0)
stp.next_step()
assert_eq("next", stp.current, 1)
assert_eq("prev completed", stp.steps[0].completed, true)
stp.next_step()
assert_eq("next2", stp.current, 2)
stp.prev_step()
assert_eq("prev", stp.current, 1)
stp.go_to(3)
assert_eq("go_to", stp.current, 3)
stp.complete_step(3)
assert_eq("completed", stp.steps[3].completed, true)
stp.set_error(2)
assert_eq("error", stp.steps[2].error, true)
stp.reset()
assert_eq("reset current", stp.current, 0)
assert_eq("reset completed", stp.steps[0].completed, false)
assert_eq("reset error", stp.steps[2].error, false)
assert_true("not complete", not stp.is_complete())
var stp_changed = false
def on_stp(i):
    stp_changed = true
stp.on_change(on_stp)
stp.go_to(2)
assert_true("callback", stp_changed)
stp.set_pos(10, 20)
assert_eq("pos x", stp.rect.x, 10)
stp.hide()
assert_eq("hidden", stp.visible, false)
stp.show()

