section("FileTree")
var ft = FileTree(10, 10, 200, 500)
assert_eq("root_count init", ft.root_count, 0)
assert_eq("selected_path init", ft.selected_path, "")
var proj = FileNode("project", "/project", true)
var src = FileNode("src", "/project/src", true)
var lib = FileNode("lib", "/project/lib", true)
var main_ny = FileNode("main.ny", "/project/src/main.ny", false)
var gui_ny = FileNode("gui.ny", "/project/lib/gui.ny", false)
main_ny.set_git_status("M")
src.add_child(main_ny)
lib.add_child(gui_ny)
proj.add_child(src)
proj.add_child(lib)
ft.add_root(proj)
assert_eq("root_count", ft.root_count, 1)
proj.expanded = true
src.expanded = true
var visible = ft._all_visible()
assert_eq("visible count expanded", len(visible), 4)
proj.expanded = false
var visible2 = ft._all_visible()
assert_eq("visible collapsed", len(visible2), 1)
ft.select("/project/src/main.ny")
assert_eq("selected", ft.selected_path, "/project/src/main.ny")
