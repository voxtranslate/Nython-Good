import "lib/gui.ny"

var passed = 0
var failed = 0

def assert_eq(label, got, expected):
    if str(got) == str(expected):
        passed = passed + 1
    else:
        failed = failed + 1
        print "  FAIL [" + label + "] got=" + str(got) + " expected=" + str(expected)

def assert_true(label, val):
    if val:
        passed = passed + 1
    else:
        failed = failed + 1
        print "  FAIL [" + label + "] expected true, got " + str(val)

def section(name):
    print "  " + name + " ..."

print "=== GUI TEST SUITE ==="

# ─── Color ────────────────────────────────────────────────────────────────────
section("Color")
var c = Color(255, 128, 0, 255)
assert_eq("r", c.r, 255)
assert_eq("g", c.g, 128)
assert_eq("b", c.b, 0)
assert_eq("a", c.a, 255)
var hex = c.to_hex()
assert_true("hex starts #", string_startswith(hex, "#"))
var c2 = c.darken(0.5)
assert_true("darken r", c2.r < c.r)
var dark_c = Color(100, 50, 0, 255)
var c3 = dark_c.lighten(0.5)
assert_true("lighten r", c3.r > dark_c.r)
var c4 = c.with_alpha(100)
assert_eq("with_alpha", c4.a, 100)
var c5 = Color(0, 0, 255, 255)
var lerped = c.lerp(c5, 0.5)
assert_true("lerp b", lerped.b > 0)

# ─── Palette ─────────────────────────────────────────────────────────────────
section("Palette")
var pal = Palette()
assert_true("accent exists", pal.ACCENT != none)
assert_true("success exists", pal.SUCCESS != none)
assert_true("danger exists", pal.DANGER != none)

# ─── Rect ─────────────────────────────────────────────────────────────────────
section("Rect")
var r = Rect(10, 20, 100, 50)
assert_eq("x", r.x, 10)
assert_eq("y", r.y, 20)
assert_eq("w", r.w, 100)
assert_eq("h", r.h, 50)
assert_eq("right", r.right(), 110)
assert_eq("bottom", r.bottom(), 70)
assert_eq("center_x", r.center_x(), 60)
assert_eq("center_y", r.center_y(), 45)
assert_true("contains inner", r.contains(50, 40))
assert_true("not contains outer", not r.contains(5, 5))
var r2 = Rect(50, 40, 80, 60)
assert_true("intersects", r.intersects(r2))
var r3 = Rect(200, 200, 50, 50)
assert_true("no intersect", not r.intersects(r3))
var re = r.expand(5)
assert_eq("expand x", re.x, 5)
assert_eq("expand w", re.w, 110)
var rs = r.shrink(5)
assert_eq("shrink x", rs.x, 15)
assert_eq("shrink w", rs.w, 90)
var rm = r.moved(5, 10)
assert_eq("moved x", rm.x, 15)
assert_eq("moved y", rm.y, 30)

# ─── Font ─────────────────────────────────────────────────────────────────────
section("Font")
var f = Font("sans-serif", 14, false, false)
assert_eq("family", f.family, "sans-serif")
assert_eq("size", f.size, 14)
assert_eq("bold", f.bold, false)
assert_eq("italic", f.italic, false)
var fb = Font("serif", 18, true, true)
assert_eq("bold2", fb.bold, true)
assert_eq("italic2", fb.italic, true)

# ─── Theme ────────────────────────────────────────────────────────────────────
section("Theme")
var th = Theme()
assert_true("bg exists", th.bg != none)
assert_true("accent exists", th.accent != none)
var dark = Theme()
var light = dark.light()
var dark_r = dark.bg.r
var light_r = light.bg.r
assert_true("themes differ", dark_r != light_r)

# ─── Event ────────────────────────────────────────────────────────────────────
section("Event")
var ev = Event("mousedown")
assert_eq("type", ev.type, "mousedown")
assert_eq("x init", ev.x, 0)
assert_eq("consumed init", ev.consumed, false)
ev.consume()
assert_eq("consumed", ev.consumed, true)
assert_true("is_mouse", ev.is_mouse())
assert_true("not keyboard", not ev.is_keyboard())
var click_ev = Event("click")
assert_true("is_click", click_ev.is_click())
var kev = Event("keydown")
assert_true("is_keyboard", kev.is_keyboard())
kev.key = "enter"
assert_true("is_key", kev.is_key("enter"))

# ─── Widget ───────────────────────────────────────────────────────────────────
section("Widget")
var w = Widget(0, 0, 200, 100)
assert_eq("rect x", w.rect.x, 0)
assert_eq("visible init", w.visible, true)
assert_eq("enabled init", w.enabled, true)
w.set_pos(10, 20)
assert_eq("set_pos x", w.rect.x, 10)
w.set_size(300, 150)
assert_eq("set_size w", w.rect.w, 300)
w.hide()
assert_eq("hidden", w.visible, false)
w.show()
assert_eq("shown", w.visible, true)
w.disable()
assert_eq("disabled", w.enabled, false)
w.enable()
assert_eq("enabled", w.enabled, true)

# ─── Button ───────────────────────────────────────────────────────────────────
section("Button")
var btn = Button(10, 10, 120, 36, "Click Me")
assert_eq("label", btn.label, "Click Me")
assert_eq("variant", btn.variant, "primary")
btn.set_variant("secondary")
assert_eq("variant set", btn.variant, "secondary")
assert_true("btn has label", btn.label == "Click Me")
var clicked = false
def on_click(e):
    clicked = true
btn.on("click", on_click)
var ce = Event("click")
btn.emit(ce)
assert_true("clicked", clicked)
btn.set_pos(50, 50)
assert_eq("btn pos x", btn.rect.x, 50)
btn.hide()
assert_eq("btn hidden", btn.visible, false)
btn.show()
assert_eq("btn shown", btn.visible, true)
btn.disable()
assert_eq("btn disabled", btn.enabled, false)
btn.enable()
assert_eq("btn enabled", btn.enabled, true)

