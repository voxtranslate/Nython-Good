# ─── TerminalPanel ────────────────────────────────────────────────────────────
section("TerminalPanel")
var tp = TerminalPanel(10, 10, 800, 250)
assert_eq("line_count init", tp.line_count, 0)
assert_eq("input_text init", tp.input_text, "")
assert_eq("prompt", tp.prompt, "nython> ")
tp.write_out("Running main.ny...")
tp.write_ok("Build successful in 0.3s")
tp.write_err("Error: undefined variable 'x' at line 5")
tp.write_warn("Deprecated: use print() instead of print")
tp.write_info("Nython v8.0 ready")
assert_eq("line_count", tp.line_count, 5)
assert_eq("first line", tp.lines[0].text, "Running main.ny...")
assert_eq("first kind", tp.lines[0].kind, "output")
assert_eq("second kind", tp.lines[1].kind, "success")
assert_eq("third kind", tp.lines[2].kind, "error")
tp.write_out("Line 1\nLine 2\nLine 3")
assert_eq("multiline count", tp.line_count, 8)
tp.clear()
assert_eq("cleared", tp.line_count, 0)
tp.write_out("Ready")
var run_cmd = ""
def on_tp_run(cmd):
    run_cmd = cmd
tp.on_run(on_tp_run)
tp.update()
assert_eq("type", type(tp), "TerminalPanel")
var lc_err = tp._line_color("error")
assert_eq("error red", lc_err.r, 255)
var lc_ok = tp._line_color("success")
assert_eq("success green", lc_ok.r, 80)
var lc_out = tp._line_color("output")
assert_eq("output color", lc_out.r, 200)
tp.set_pos(0, 450)
assert_eq("pos y", tp.rect.y, 450)
tp.set_size(1024, 220)
assert_eq("size w", tp.rect.w, 1024)
tp.hide()
assert_eq("hidden", tp.visible, false)
tp.show()


# ─── RunConfigBar ─────────────────────────────────────────────────────────────
section("RunConfigBar")
var rcb = RunConfigBar(0, 0, 900, 36)
assert_eq("mode_count", len(rcb.modes), 7)
assert_eq("active init", rcb.active_mode, 0)
assert_eq("mode 0", rcb.modes[0], "Run")
assert_eq("mode 1", rcb.modes[1], "Debug")
assert_eq("mode 2", rcb.modes[2], "Tokenize")
assert_eq("mode 3", rcb.modes[3], "AST")
assert_eq("mode 4", rcb.modes[4], "Disasm")
assert_eq("mode 5", rcb.modes[5], "REPL")
assert_eq("mode 6", rcb.modes[6], "Profile")
assert_eq("icons count", len(rcb.mode_icons), 7)
var mode_triggered = -1
var mode_name = ""
def on_rcb_mode(idx, name):
    mode_triggered = idx
    mode_name = name
rcb.on_mode(on_rcb_mode)
var run_triggered = -1
def on_rcb_run(idx, name):
    run_triggered = idx
rcb.on_run(on_rcb_run)
var mc0 = rcb._mode_color(0)
assert_eq("run color g", mc0.r, 52)
var mc1 = rcb._mode_color(1)
assert_eq("debug color r", mc1.r, 255)
var mc6 = rcb._mode_color(6)
assert_eq("profile color", mc6.r, 255)
rcb.set_pos(10, 10)
assert_eq("pos x", rcb.rect.x, 10)
rcb.set_size(1200, 40)
assert_eq("size w", rcb.rect.w, 1200)
rcb.hide()
assert_eq("hidden", rcb.visible, false)
rcb.show()
assert_eq("visible", rcb.visible, true)

# ─── TokenEntry ───────────────────────────────────────────────────────────────
section("TokenEntry")
var te = TokenEntry("def", "Def", "Name", "Keyword", 1, 4)
assert_eq("value", te.value, "def")
assert_eq("tok_type", te.tok_type, "Def")
assert_eq("tok_kind", te.tok_kind, "Name")
assert_eq("tok_class", te.tok_class, "Keyword")
assert_eq("line", te.line, 1)
assert_eq("col", te.col, 4)

# ─── TokenViewer ──────────────────────────────────────────────────────────────
section("TokenViewer")
var tv = TokenViewer(0, 0, 900, 500)
assert_eq("token_count init", tv.token_count, 0)
assert_eq("visible init", tv.visible, false)
assert_eq("item_h", tv.item_h, 28)
var kw_c = tv._class_color("Keyword")
assert_eq("keyword purple r", kw_c.r, 196)
var id_c = tv._class_color("Identifier")
assert_eq("identifier blue b", id_c.b, 255)
var lit_c = tv._class_color("Literal")
assert_eq("literal green g", lit_c.g, 215)
var del_c = tv._class_color("Delimiter")
assert_eq("delimiter muted", del_c.r, 120)
var op_c = tv._class_color("Operator")
assert_eq("operator orange", op_c.r, 248)
var raw_tokens = [
    {"v": "def",       "t": "Def",        "k": "Name",       "c": "Keyword",    "ln": 1, "col": 4},
    {"v": "factorial", "t": "Identifier", "k": "Identifier", "c": "Identifier", "ln": 1, "col": 4},
    {"v": "(",         "t": "ParenOpen",  "k": "LeftParen",  "c": "Default",    "ln": 1, "col": 1},
    {"v": "n",         "t": "Identifier", "k": "Identifier", "c": "Identifier", "ln": 1, "col": 1},
    {"v": ")",         "t": "ParenClose", "k": "RightParen", "c": "Default",    "ln": 1, "col": 1},
    {"v": "42",        "t": "Integer",    "k": "Number",     "c": "Literal",    "ln": 3, "col": 4},
    {"v": "x",         "t": "Identifier", "k": "Identifier", "c": "Identifier", "ln": 3, "col": 4},
    {"v": "=",         "t": "Assign",     "k": "Assign",     "c": "Assignment", "ln": 3, "col": 2}
]
tv.set_raw(raw_tokens)
assert_eq("token_count", tv.token_count, 8)
assert_eq("first token val", tv.tokens[0].value, "def")
assert_eq("first token class", tv.tokens[0].tok_class, "Keyword")
assert_eq("number token", tv.tokens[5].value, "42")
assert_eq("assign class", tv.tokens[7].tok_class, "Assignment")
var clicked_tok = none
def on_tv_click(tok):
    clicked_tok = tok
tv.on_click(on_tv_click)
tv.set_pos(10, 10)
assert_eq("pos x", tv.rect.x, 10)
tv.set_size(1100, 600)
assert_eq("size h", tv.rect.h, 600)
tv.show()
assert_eq("visible", tv.visible, true)
tv.hide()

# ─── ASTNode2 ─────────────────────────────────────────────────────────────────
section("ASTNode2")
var an = ASTNode2("Function", '<Function name="foo" params="2">', 1)
assert_eq("tag", an.tag, "Function")
assert_eq("depth", an.depth, 1)
assert_eq("expanded", an.expanded, true)
assert_eq("has_children", an.has_children, false)

# ─── ASTViewer ────────────────────────────────────────────────────────────────
section("ASTViewer")
var av = ASTViewer(0, 0, 700, 500)
assert_eq("node_count init", av.node_count, 0)
assert_eq("visible init", av.visible, false)
var script_c = av._tag_color("Script")
assert_eq("Script color r", script_c.r, 99)
var func_c = av._tag_color("Function")
assert_eq("Function color b", func_c.b, 255)
var class_c = av._tag_color("Class")
assert_eq("Class color r", class_c.r, 252)
var var_c = av._tag_color("VarDecl")
assert_eq("VarDecl green g", var_c.g, 215)
var if_c = av._tag_color("If")
assert_eq("If orange r", if_c.r, 255)
var ast_xml = "<Script>" + "\n   <Source/>" + "\n   <Statements>" + "\n      <Function name=\"foo\">" + "\n      </Function>" + "\n      <VarDecl name=\"x\"/>" + "\n   </Statements>" + "\n</Script>"
av.parse_xml(ast_xml)
assert_true("nodes parsed", av.node_count > 0)
assert_eq("first tag", av.nodes[0].tag, "Script")
assert_true("Script has children", av.nodes[0].has_children)
av.set_pos(5, 5)
assert_eq("pos y", av.rect.y, 5)
av.set_size(800, 600)
assert_eq("size w", av.rect.w, 800)
av.show()
assert_eq("visible", av.visible, true)
av.hide()

# ─── BreakpointEntry ──────────────────────────────────────────────────────────
section("BreakpointEntry")
var bp = BreakpointEntry("main.ny", 42, true)
assert_eq("file", bp.file, "main.ny")
assert_eq("line", bp.line, 42)
assert_eq("enabled", bp.enabled, true)
assert_eq("hit_count init", bp.hit_count, 0)
assert_eq("condition init", bp.condition, "")

# ─── WatchEntry ───────────────────────────────────────────────────────────────
section("WatchEntry")
var we = WatchEntry("self.count", "42")
assert_eq("expr", we.expr, "self.count")
assert_eq("value", we.value, "42")
assert_eq("changed init", we.changed, false)

# ─── DebugPanel ───────────────────────────────────────────────────────────────
section("DebugPanel")
var dp = DebugPanel(0, 0, 600, 400)
assert_eq("visible init", dp.visible, false)
assert_eq("bp_count init", dp.bp_count, 0)
assert_eq("watch_count init", dp.watch_count, 0)
assert_eq("stack_depth init", dp.stack_depth, 0)
assert_eq("active_tab init", dp.active_tab, 0)
assert_eq("tabs count", len(dp.tabs), 3)
assert_eq("tab 0", dp.tabs[0], "Breakpoints")
assert_eq("tab 1", dp.tabs[1], "Watch")
assert_eq("tab 2", dp.tabs[2], "Call Stack")
dp.add_breakpoint("main.ny", 12)
dp.add_breakpoint("app.ny", 34)
assert_eq("bp_count", dp.bp_count, 2)
assert_eq("bp file", dp.breakpoints[0].file, "main.ny")
assert_eq("bp line", dp.breakpoints[0].line, 12)
assert_eq("bp enabled", dp.breakpoints[0].enabled, true)
dp.add_watch("self.counter", "0")
dp.add_watch("result", "none")
assert_eq("watch_count", dp.watch_count, 2)
assert_eq("watch expr", dp.watches[0].expr, "self.counter")
dp.update_watch("self.counter", "7")
assert_eq("watch updated", dp.watches[0].value, "7")
assert_eq("watch changed", dp.watches[0].changed, true)
dp.update_watch("self.counter", "7")
assert_eq("watch unchanged same", dp.watches[0].changed, false)
dp.push_frame("<module>", "main.ny", 1)
dp.push_frame("factorial", "main.ny", 5)
dp.push_frame("factorial", "main.ny", 5)
assert_eq("stack depth", dp.stack_depth, 3)
assert_eq("frame 0 name", dp.call_stack[0]["name"], "<module>")
assert_eq("frame 1 name", dp.call_stack[1]["name"], "factorial")
dp.remove_breakpoint("app.ny", 34)
assert_eq("bp after remove", dp.bp_count, 1)
assert_eq("remaining bp", dp.breakpoints[0].file, "main.ny")
dp.clear_stack()
assert_eq("stack cleared", dp.stack_depth, 0)
var step_kind = ""
def on_dp_step(kind):
    step_kind = kind
dp.on_step(on_dp_step)
var cont_called = false
def on_dp_cont():
    cont_called = true
dp.on_continue(on_dp_cont)
var stop_called = false
def on_dp_stop():
    stop_called = true
dp.on_stop(on_dp_stop)
dp.set_pos(10, 10)
assert_eq("pos x", dp.rect.x, 10)
dp.set_size(800, 500)
assert_eq("size h", dp.rect.h, 500)
dp.show()
assert_eq("visible", dp.visible, true)
dp.hide()

# ─── ProfileEntry ─────────────────────────────────────────────────────────────
section("ProfileEntry")
var pe = ProfileEntry("factorial", "function", 120, 45.2, 38.7)
assert_eq("name", pe.name, "factorial")
assert_eq("kind", pe.kind, "function")
assert_eq("calls", pe.calls, 120)
assert_eq("pct init", pe.pct, 0.0)

# ─── ProfilerPanel ────────────────────────────────────────────────────────────
section("ProfilerPanel")
var pp = ProfilerPanel(0, 0, 900, 400)
assert_eq("entry_count init", pp.entry_count, 0)
assert_eq("total_ms init", pp.total_ms, 0.0)
assert_eq("visible init", pp.visible, false)
pp.set_total(200.0)
pp.add_entry("factorial", "function", 120, 80.0, 60.0)
pp.add_entry("Counter.__init__", "method", 5, 10.0, 10.0)
pp.add_entry("Counter.inc", "method", 50, 30.0, 25.0)
pp.add_entry("<module>", "module", 1, 200.0, 80.0)
assert_eq("entry_count", pp.entry_count, 4)
assert_eq("first name", pp.entries[0].name, "factorial")
assert_eq("first calls", pp.entries[0].calls, 120)
assert_eq("pct set", pp.entries[0].pct, 0.4)
assert_eq("module pct", pp.entries[3].pct, 1.0)
pp.set_pos(5, 5)
assert_eq("pos x", pp.rect.x, 5)
pp.set_size(1100, 500)
assert_eq("size w", pp.rect.w, 1100)
pp.show()
assert_eq("visible", pp.visible, true)
pp.hide()
pp.clear()
assert_eq("cleared", pp.entry_count, 0)

# ─── REPLPanel ────────────────────────────────────────────────────────────────
section("REPLPanel")
var rp = REPLPanel(0, 0, 900, 400)
assert_eq("hist_count init", rp.hist_count, 0)
assert_eq("input init", rp.input_text, "")
assert_eq("visible init", rp.visible, false)
rp.write(">>> var x = 42", "prompt")
rp.write("42", "result")
rp.write(">>> print x", "prompt")
rp.write("42", "ok")
rp.write(">>> 1/0", "prompt")
rp.write("Error: division by zero", "error")
assert_eq("hist_count", rp.hist_count, 6)
assert_eq("first kind", rp.history[0]["kind"], "prompt")
assert_eq("result kind", rp.history[1]["kind"], "result")
assert_eq("error kind", rp.history[5]["kind"], "error")
var prompt_c = rp._line_color("prompt")
assert_eq("prompt color r", prompt_c.r, 99)
var err_c = rp._line_color("error")
assert_eq("error color r", err_c.r, 255)
var ok_c = rp._line_color("ok")
assert_eq("ok color g", ok_c.g, 220)
var info_c = rp._line_color("info")
assert_eq("info color b", info_c.b, 255)
var result_c = rp._line_color("result")
assert_eq("result color r", result_c.r, 248)
var exec_expr = ""
def on_rp_exec(e):
    exec_expr = e
rp.on_execute(on_rp_exec)
rp.clear()
assert_eq("cleared", rp.hist_count, 0)
rp.write(">>> ready", "prompt")
rp.set_pos(10, 10)
assert_eq("pos x", rp.rect.x, 10)
rp.set_size(1100, 500)
assert_eq("size h", rp.rect.h, 500)
rp.show()
assert_eq("visible", rp.visible, true)
rp.hide()

print ""
print "Results: " + str(passed) + " passed, " + str(failed) + " failed"
if failed == 0:
    print "=== ALL GUI TESTS PASSED ==="
else:
    print "=== SOME GUI TESTS FAILED ==="
