section("MenuBar")
def on_new(): pass
def on_open(): pass
def on_save(): pass
def on_undo(): pass
def on_redo(): pass
var mb = MenuBar(1280)
var file_menu = Menu("File")
file_menu.add("New", on_new)
file_menu.add("Open", on_open)
file_menu.add_separator()
file_menu.add("Save", on_save)
var edit_menu = Menu("Edit")
edit_menu.add("Undo", on_undo)
edit_menu.add("Redo", on_redo)
var view_menu = Menu("View")
view_menu.add("Zoom In", none)
view_menu.add("Zoom Out", none)
mb.add_menu(file_menu)
mb.add_menu(edit_menu)
mb.add_menu(view_menu)
assert_eq("menu count", mb.menu_count, 3)
assert_eq("h", mb.h, 30)
assert_eq("active init", mb.active_menu, -1)
mb.close_all()
assert_eq("all closed", mb.active_menu, -1)
assert_eq("mb type", type(mb), "MenuBar")

