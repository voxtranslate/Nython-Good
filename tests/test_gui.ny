# ─── Gauge ────────────────────────────────────────────────────────────────────
section("Gauge")
var gauge = Gauge(10, 10, 200, 0, 100, 0)
assert_eq("size", gauge.size, 200)
assert_eq("min", gauge.min_val, 0)
assert_eq("max", gauge.max_val, 100)
assert_eq("value init", gauge.value, 0)
gauge.set_value(75)
assert_eq("value set", gauge.value, 75)
gauge.set_value(150)
assert_eq("clamped max", gauge.value, 100)
gauge.set_value(-10)
assert_eq("clamped min", gauge.value, 0)
gauge.set_label("Speed")
assert_eq("label", gauge.label, "Speed")
gauge.set_unit("km/h")
assert_eq("unit", gauge.unit, "km/h")
gauge.add_zone(0.0, 0.33, Color(52, 199, 89, 255))
gauge.add_zone(0.33, 0.66, Color(255, 149, 0, 255))
gauge.add_zone(0.66, 1.0, Color(255, 59, 48, 255))
assert_eq("zone count", gauge.zone_count, 3)
var ang = gauge._val_to_angle(50)
assert_true("angle mid", ang > gauge.start_angle and ang < gauge.start_angle + gauge.sweep_angle)
gauge.update()
gauge.set_pos(20, 20)
assert_eq("pos x", gauge.x, 20)
gauge.hide()
assert_eq("hidden", gauge.visible, false)
gauge.show()

# ─── CalendarWidget ───────────────────────────────────────────────────────────
section("CalendarWidget")
var cal = CalendarWidget(10, 10, 350, 360)
cal.set_date(2025, 6)
assert_eq("year", cal.year, 2025)
assert_eq("month", cal.month, 6)
cal.set_today(2025, 6, 15)
assert_eq("today", cal.today_day, 15)
cal.add_event(10, "Team Meeting")
cal.add_event(25, "Release")
assert_true("has event 10", cal.has_event(10))
assert_true("has event 25", cal.has_event(25))
assert_true("no event 5", not cal.has_event(5))
var days = cal._days_in_month(2025, 2)
assert_eq("Feb 2025", days, 28)
var days_leap = cal._days_in_month(2024, 2)
assert_eq("Feb 2024 leap", days_leap, 29)
assert_eq("Jan days", cal._days_in_month(2025, 1), 31)
assert_eq("Apr days", cal._days_in_month(2025, 4), 30)
var nav_called = false
def on_cal_nav(y, m):
    nav_called = true
cal.on_navigate(on_cal_nav)
cal.prev_month()
assert_eq("prev month", cal.month, 5)
assert_true("nav callback", nav_called)
cal.next_month()
assert_eq("next month", cal.month, 6)
cal.next_month()
cal.next_month()
cal.next_month()
cal.next_month()
cal.next_month()
cal.next_month()
cal.next_month()
assert_eq("wrap to next year", cal.year, 2026)
var sel_called = false
def on_cal_select(y, m, d):
    sel_called = true
cal.on_select(on_cal_select)
cal.set_pos(20, 20)
assert_eq("pos x", cal.rect.x, 20)
cal.hide()
assert_eq("hidden", cal.visible, false)
cal.show()

