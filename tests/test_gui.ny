# ─── Tabs ─────────────────────────────────────────────────────────────────────
section("Tabs")
var tabs = Tabs(0, 0, 600, 40)
tabs.add("Overview", Panel(0, 40, 600, 360))
tabs.add("Settings", Panel(0, 40, 600, 360))
tabs.add("Analytics", Panel(0, 40, 600, 360))
