var code_lines = []
var mli = 0
while mli < 50:
    code_lines = code_lines + ["    var x = " + str(mli)]
    mli = mli + 1
mm.set_lines(code_lines)
assert_eq("line_count", mm.line_count, 50)
mm.set_scroll(0.5, 0.2)
