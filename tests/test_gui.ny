# ─── Marquee ──────────────────────────────────────────────────────────────────
section("Marquee")
var mq = Marquee(10, 10, 800, 40)
assert_eq("item_count init", mq.item_count, 0)
assert_eq("direction", mq.direction, "left")
assert_eq("offset init", mq.offset, 0.0)
assert_eq("paused init", mq.paused, false)
mq.add_item("BTC $65,000", "₿", Color(255, 149, 0, 255))
mq.add_item("ETH $3,500", "Ξ", Color(99, 102, 241, 255))
mq.add_item("SOL $180", "◎", Color(52, 199, 89, 255))
mq.add_item("DOGE $0.15", "Ð", Color(220, 180, 50, 255))
assert_eq("item_count", mq.item_count, 4)
assert_true("total_w > 0", mq.total_w > 0)
mq.set_speed(2.5)
assert_eq("speed", mq.speed, 2.5)
mq.update()
assert_true("offset advances", mq.offset > 0.0)
mq.pause()
assert_eq("paused", mq.paused, true)
var old_offset = mq.offset
mq.update()
assert_eq("no advance when paused", mq.offset, old_offset)
mq.resume()
assert_eq("resumed", mq.paused, false)
mq.update()
assert_true("advances after resume", mq.offset > old_offset)
mq.set_pos(20, 20)
assert_eq("pos x", mq.rect.x, 20)
mq.set_size(1200, 44)
assert_eq("size w", mq.rect.w, 1200)
mq.hide()
assert_eq("hidden", mq.visible, false)
mq.show()

