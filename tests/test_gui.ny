# ─── TabBar ───────────────────────────────────────────────────────────────────
section("TabBar")
var tb = TabBar(0, 0, 800, 36)
assert_eq("tab_count init", tb.tab_count, 0)
assert_eq("active_id init", tb.active_id, "")
tb.add_tab("t1", "main.ny", "/main.ny")
tb.add_tab("t2", "gui.ny", "/lib/gui.ny")
tb.add_tab("t3", "config.json", "/config.json")
assert_eq("tab_count", tb.tab_count, 3)
assert_eq("last active", tb.active_id, "t3")
tb.set_active("t1")
assert_eq("active set", tb.active_id, "t1")
assert_eq("t1 active", tb.tabs[0].active, true)
assert_eq("t2 inactive", tb.tabs[1].active, false)
tb.set_modified("t2", true)
assert_eq("modified", tb.tabs[1].modified, true)
var active_tab = tb.get_active()
assert_eq("get_active", active_tab.id, "t1")
var sel_tab = none
def on_tb_select(tab):
    sel_tab = tab
tb.on_select(on_tb_select)
var closed_id = ""
def on_tb_close(id):
    closed_id = id
tb.on_close(on_tb_close)
var new_called = false
def on_tb_new():
    new_called = true
tb.on_new(on_tb_new)
tb.close_tab("t2")
assert_eq("after close count", tb.tab_count, 2)
assert_eq("t2 gone", tb.tabs[0].id, "t1")
assert_eq("t3 remains", tb.tabs[1].id, "t3")
var tw = tb._tab_w()
assert_true("tab_w in range", tw >= tb.tab_min_w and tw <= tb.tab_max_w)
tb.set_pos(0, 40)
assert_eq("pos y", tb.rect.y, 40)
tb.set_size(1024, 36)
assert_eq("size w", tb.rect.w, 1024)
tb.hide()
assert_eq("hidden", tb.visible, false)
tb.show()

