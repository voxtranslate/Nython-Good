# ─── ContextMenu ──────────────────────────────────────────────────────────────
section("ContextMenu")
var cm = ContextMenu()
assert_eq("count init", cm.count, 0)
var cm_action_called = false
def on_cm_action():
    cm_action_called = true
cm.add_item("Cut", on_cm_action)
cm.add_item_with_shortcut("Copy", none, "Ctrl+C")
cm.add_separator()
