assert_eq("item active", sn.items[1].active, true)
assert_eq("item inactive", sn.items[0].active, false)
sn.set_badge("home", 3)
assert_eq("badge set", sn.items[0].badge, 3)
sn.set_profile("Alice Smith")
assert_eq("profile_name", sn.profile_name, "Alice Smith")
assert_eq("initial", sn.profile_initial, "A")
sn.collapse()
assert_eq("collapsed", sn.collapsed, true)
assert_eq("w collapsed", sn.w, 56)
sn.expand()
assert_eq("expanded", sn.collapsed, false)
assert_eq("w expanded", sn.w, 220)
sn.toggle()
assert_eq("toggled", sn.collapsed, true)
sn.toggle()
assert_eq("re-toggled", sn.collapsed, false)
var selected_item = none
def on_sn_select(item):
    selected_item = item
sn.on_select(on_sn_select)
sn.set_pos(10, 10)
assert_eq("pos x", sn.x, 10)
sn.hide()
assert_eq("hidden", sn.visible, false)
sn.show()

# ─── OTPInput ─────────────────────────────────────────────────────────────────
section("OTPInput")
var otp = OTPInput(10, 10, 6, 48, 56)
assert_eq("digits", otp.digits, 6)
assert_eq("values len", len(otp.values), 6)
assert_eq("focused_idx init", otp.focused_idx, 0)
assert_eq("error init", otp.error, false)
assert_eq("success init", otp.success, false)
assert_eq("complete init", otp.is_complete(), false)
otp._set_digit(0, "1")
otp._set_digit(1, "2")
otp._set_digit(2, "3")
otp._set_digit(3, "4")
otp._set_digit(4, "5")
otp._set_digit(5, "6")
assert_eq("complete", otp.is_complete(), true)
assert_eq("value", otp.get_value(), "123456")
otp.set_error()
assert_eq("error", otp.error, true)
assert_eq("shake active", otp.shake_active, true)
otp.set_success()
assert_eq("success", otp.success, true)
assert_eq("error cleared", otp.error, false)
otp.clear()
assert_eq("cleared", otp.get_value(), "")
assert_eq("not complete", otp.is_complete(), false)
var complete_val = ""
def on_otp_complete(val):
    complete_val = val
otp.on_complete(on_otp_complete)
otp._set_digit(0, "9")
otp._set_digit(1, "8")
otp._set_digit(2, "7")
otp._set_digit(3, "6")
otp._set_digit(4, "5")
otp._set_digit(5, "4")
assert_eq("complete callback", complete_val, "987654")
otp.update()
otp.set_pos(50, 50)
assert_eq("pos x", otp.x, 50)
otp.hide()
assert_eq("hidden", otp.visible, false)
otp.show()
otp.disable()
assert_eq("type", type(otp), "OTPInput")
otp.enable()

# ─── CodeBlock ────────────────────────────────────────────────────────────────
section("CodeBlock")
var cb = CodeBlock(10, 10, 600, 300)
assert_eq("line_count init", cb.line_count, 0)
assert_eq("language init", cb.language, "")
cb.set_language("nython")
assert_eq("language", cb.language, "nython")
var code_str = "def greet(name):\n    var msg = \"Hello \" + name\n    return msg\n\nprint greet(\"World\")"
cb.set_code(code_str)
assert_eq("line_count", cb.line_count, 5)
assert_eq("line 0", cb.lines[0], "def greet(name):")
assert_eq("line 1", cb.lines[1], "    var msg = \"Hello \" + name")
assert_eq("line 4", cb.lines[4], "print greet(\"World\")")
var is_kw_def = cb._is_keyword("def")
assert_eq("def is keyword", is_kw_def, true)
var is_kw_var = cb._is_keyword("var")
assert_eq("var is keyword", is_kw_var, true)
var is_kw_foo = cb._is_keyword("foo")
assert_eq("foo not keyword", is_kw_foo, false)
var tc = cb._token_color("def", "def greet():")
assert_eq("keyword color r", tc.r, cb.keyword_color.r)
cb.set_pos(20, 20)
assert_eq("pos x", cb.rect.x, 20)
cb.set_size(800, 400)
assert_eq("size w", cb.rect.w, 800)
cb.hide()
assert_eq("hidden", cb.visible, false)
cb.show()

