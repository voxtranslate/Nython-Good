# ─── Notification / NotificationCenter ───────────────────────────────────────
section("Notification")
var notif = Notification("Update Available", "v2.0 is ready", "info", 5000)
assert_eq("title", notif.title, "Update Available")
assert_eq("body", notif.body, "v2.0 is ready")
assert_eq("type", notif.type, "info")
assert_eq("duration", notif.duration_ms, 5000)
assert_eq("read init", notif.read, false)
assert_eq("dismissed init", notif.dismissed, false)
assert_true("id not empty", notif.id != "")
assert_true("not expired", not notif.is_expired())
notif.mark_read()
assert_eq("marked read", notif.read, true)
notif.dismiss()
assert_eq("dismissed", notif.dismissed, true)
var action_called = false
def notif_action():
    action_called = true
notif.set_action("View", notif_action)
assert_eq("action label", notif.action_label, "View")

section("NotificationCenter")
var nc = NotificationCenter(1280, 800)
assert_eq("count init", nc.count, 0)
assert_eq("unread init", nc.unread, 0)
var n1 = nc.success("Saved!", "Your file was saved successfully.")
var n2 = nc.error("Failed", "Could not connect to server.")
var n3 = nc.warning("Disk Space", "Less than 10% free.")
var n4 = nc.info("Update", "A new version is available.")
assert_eq("count 4", nc.count, 4)
assert_eq("unread 4", nc.unread, 4)
assert_true("n1 not none", n1 != none)
assert_eq("n1 type", n1.type, "success")
assert_eq("n2 type", n2.type, "error")
nc.dismiss(n1.id)
nc.update()
assert_true("count after dismiss", nc.count <= 3)
nc.dismiss_all()
nc.update()
assert_eq("count after dismiss all", nc.count, 0)
nc.hide()
assert_eq("hidden", nc.visible, false)
nc.show()

