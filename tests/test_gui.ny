var root = TreeMapNode("Portfolio", 0.0, Color(30, 32, 48, 255))
var tech = TreeMapNode("Tech", 0.0, Color(99, 102, 241, 255))
var finance = TreeMapNode("Finance", 0.0, Color(52, 199, 89, 255))
tech.add_child(TreeMapNode("AAPL", 150.0, Color(120, 130, 255, 255)))
tech.add_child(TreeMapNode("GOOG", 120.0, Color(100, 110, 240, 255)))
tech.add_child(TreeMapNode("MSFT", 100.0, Color(80, 90, 220, 255)))
finance.add_child(TreeMapNode("JPM", 80.0, Color(80, 210, 120, 255)))
finance.add_child(TreeMapNode("BRK", 90.0, Color(60, 190, 100, 255)))
root.add_child(tech)
root.add_child(finance)
tm.set_root(root)
assert_eq("root set", tm.root != none, true)
assert_eq("tech children", tech.child_count, 3)
assert_eq("finance children", finance.child_count, 2)
tm.update()
assert_true("anim advances", tm.anim_progress > 0.0)
