assert_eq("y_label", bch.y_label, "Growth (%)")
bch.add_bubble(80.0, 25.0, 40, "AAPL", Color(99, 102, 241, 255))
bch.add_bubble(40.0, 35.0, 25, "GOOG", Color(52, 199, 89, 255))
bch.add_bubble(65.0, 18.0, 35, "MSFT", Color(255, 149, 0, 255))
