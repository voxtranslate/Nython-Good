# ─── KanbanBoard ──────────────────────────────────────────────────────────────
section("KanbanBoard")
var kb = KanbanBoard(10, 10, 800, 600)
kb.set_title("Sprint 42")
assert_eq("title", kb.title, "Sprint 42")
var col_todo = KanbanColumn("todo", "To Do", Color(99, 102, 241, 255))
var col_wip = KanbanColumn("wip", "In Progress", Color(255, 149, 0, 255))
var col_done = KanbanColumn("done", "Done", Color(52, 199, 89, 255))
var ka = KanbanCard("ka", "Feature A", "Desc A")
var kb2 = KanbanCard("kb", "Feature B", "Desc B")
var kc_card = KanbanCard("kc", "Bug Fix", "Desc C")
col_todo.add_card(ka)
col_todo.add_card(kb2)
col_wip.add_card(kc_card)
kb.add_column(col_todo)
kb.add_column(col_wip)
kb.add_column(col_done)
assert_eq("col count", kb.col_count, 3)
assert_eq("total cards", kb.total_cards(), 3)
var got_col = kb.get_column("wip")
assert_true("get column", got_col != none)
assert_eq("column title", got_col.title, "In Progress")
var not_col = kb.get_column("xxx")
assert_eq("get missing col", not_col, none)
var moved = kb.move_card("ka", "todo", "done")
assert_eq("move result", moved, true)
assert_eq("todo after move", col_todo.card_count, 1)
assert_eq("done after move", col_done.card_count, 1)
var bad_move = kb.move_card("zzz", "todo", "done")
assert_eq("bad move", bad_move, false)
kb.set_pos(20, 20)
assert_eq("pos x", kb.rect.x, 20)
kb.set_size(1024, 700)
assert_eq("size w", kb.rect.w, 1024)
kb.hide()
assert_eq("hidden", kb.visible, false)
kb.show()

