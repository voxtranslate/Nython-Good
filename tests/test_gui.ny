conf.show()

# ─── TreeMapNode ──────────────────────────────────────────────────────────────
section("TreeMapNode")
var tmn = TreeMapNode("Root", 100.0, Color(99, 102, 241, 255))
assert_eq("label", tmn.label, "Root")
assert_eq("value", tmn.value, 100.0)
assert_eq("child_count init", tmn.child_count, 0)
assert_eq("depth", tmn.depth, 0)
var child1 = TreeMapNode("A", 60.0, Color(52, 199, 89, 255))
var child2 = TreeMapNode("B", 40.0, Color(255, 149, 0, 255))
tmn.add_child(child1)
tmn.add_child(child2)
assert_eq("child_count", tmn.child_count, 2)
assert_eq("child depth", child1.depth, 1)
assert_eq("child parent not none", child1.parent != none, true)
assert_eq("total_value leaf", child1.total_value(), 60.0)
assert_eq("total_value root", tmn.total_value(), 100.0)
var grandchild = TreeMapNode("A1", 30.0, Color(220, 100, 255, 255))
child1.add_child(grandchild)
assert_eq("grandchild depth", grandchild.depth, 2)
assert_eq("child total with kids", child1.total_value(), 30.0)

